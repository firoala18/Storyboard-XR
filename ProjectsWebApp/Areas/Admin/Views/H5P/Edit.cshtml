@model ProjectsWebApp.Models.H5PContent
@{
    ViewData["Title"] = "H5P-Inhalt bearbeiten";
}

<style>
    .h5p-form-card { background:#fff; border-radius:1rem; box-shadow:0 4px 12px rgba(0,0,0,.05); border:1px solid #e2e8f0; }
    .h5p-form-header { padding:1.5rem 2rem; border-bottom:1px solid #f1f5f9; }
    .h5p-form-body   { padding:2rem; }
    .h5p-form-footer { padding:1.25rem 2rem; border-top:1px solid #f1f5f9; display:flex; justify-content:flex-end; gap:.75rem; }
    .upload-zone { border:2px dashed #cbd5e1; border-radius:.75rem; padding:2rem; text-align:center; cursor:pointer; transition:border-color .2s, background .2s; background:#fafbfc; }
    .upload-zone:hover,.upload-zone.dragover { border-color:#89ba17; background:#f7fce9; }
    .upload-zone i { font-size:2rem; color:#94a3b8; }
    .upload-zone.has-file i { color:#22c55e; }
    .upload-zone .file-name { font-size:.85rem; font-weight:600; color:#0f172a; margin-top:.5rem; }

    /* Upload overlay (progress + success morph) */
    .h5p-upload-overlay {
        position: fixed; inset: 0;
        background: rgba(15,23,42,.55);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        z-index: 2000;
        display: none;
        align-items: center; justify-content: center;
    }
    .h5p-upload-overlay.is-open { display: flex; }
    .h5p-upload-card {
        background: #fff; border-radius: 16px;
        padding: 28px 32px; min-width: 320px; max-width: 420px;
        box-shadow: 0 20px 50px rgba(15,23,42,.25);
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .h5p-upload-title { font-size: 1.05rem; font-weight: 700; color: #0f172a; margin: 0 0 4px; }
    .h5p-upload-sub   { font-size: .85rem; color: #64748b; margin: 0 0 18px; }
    .h5p-upload-progress {
        height: 8px; width: 100%; background: #eef2f6; border-radius: 999px; overflow: hidden;
        position: relative;
    }
    .h5p-upload-bar {
        height: 100%; width: 0%;
        background: linear-gradient(90deg, #89ba17, #9fd62a);
        border-radius: 999px;
        transition: width .2s ease;
    }
    .h5p-upload-bar.indeterminate {
        width: 40% !important;
        animation: h5pUploadIndet 1.1s ease-in-out infinite alternate;
    }
    @@keyframes h5pUploadIndet {
        0%   { transform: translateX(-20%); }
        100% { transform: translateX(180%); }
    }
    .h5p-upload-pct { font-size: .85rem; color: #334155; margin-top: 10px; font-variant-numeric: tabular-nums; }

    /* Success morph state — swaps in when upload finishes cleanly */
    .h5p-upload-card[data-state="success"] .h5p-upload-progress,
    .h5p-upload-card[data-state="success"] .h5p-upload-pct,
    .h5p-upload-card[data-state="success"] .h5p-upload-title,
    .h5p-upload-card[data-state="success"] .h5p-upload-sub { display: none; }
    .h5p-upload-success { display: none; flex-direction: column; align-items: center; gap: 12px; padding: 4px 0; }
    .h5p-upload-card[data-state="success"] .h5p-upload-success { display: flex; animation: h5pUploadFadeIn .25s ease-out; }
    .h5p-upload-success-ring {
        width: 68px; height: 68px; border-radius: 50%;
        background: radial-gradient(circle at 30% 30%, #dcfce7, #bbf7d0);
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 0 0 6px rgba(34,197,94,.12);
        animation: h5pUploadPop .4s cubic-bezier(.25,1.4,.5,1);
    }
    .h5p-upload-success-ring svg { width: 34px; height: 34px; stroke: #16a34a; fill: none; stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; }
    .h5p-upload-success-ring svg path { stroke-dasharray: 40; stroke-dashoffset: 40; animation: h5pUploadDraw .45s .1s ease-out forwards; }
    .h5p-upload-success-title { font-size: 1.05rem; font-weight: 700; color: #166534; margin: 0; }
    .h5p-upload-success-sub   { font-size: .85rem; color: #64748b; margin: 0; }
    @@keyframes h5pUploadPop  { 0% { transform: scale(.5); opacity: 0; } 60% { transform: scale(1.1); } 100% { transform: scale(1); opacity: 1; } }
    @@keyframes h5pUploadDraw { to { stroke-dashoffset: 0; } }
    @@keyframes h5pUploadFadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

    /* Error state */
    .h5p-upload-card[data-state="error"] .h5p-upload-progress,
    .h5p-upload-card[data-state="error"] .h5p-upload-pct,
    .h5p-upload-card[data-state="error"] .h5p-upload-title { display: none; }
    .h5p-upload-error { display: none; flex-direction: column; align-items: center; gap: 10px; }
    .h5p-upload-card[data-state="error"] .h5p-upload-error { display: flex; animation: h5pUploadFadeIn .25s ease-out; }
    .h5p-upload-card[data-state="error"] .h5p-upload-sub { display: none; }
    .h5p-upload-error-ring {
        width: 60px; height: 60px; border-radius: 50%;
        background: radial-gradient(circle at 30% 30%, #fee2e2, #fecaca);
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 0 0 6px rgba(239,68,68,.12);
        color: #dc2626; font-size: 1.75rem;
        animation: h5pUploadPop .4s cubic-bezier(.25,1.4,.5,1);
    }
    .h5p-upload-error-title { font-size: 1rem; font-weight: 700; color: #991b1b; margin: 0; }
    .h5p-upload-error-sub { font-size: .82rem; color: #64748b; margin: 0; }
    .h5p-upload-error-btn {
        margin-top: 8px; padding: .4rem 1rem;
        background: #fff; color: #334155;
        border: 1px solid #e2e8f0; border-radius: 8px;
        font-size: .82rem; font-weight: 500; cursor: pointer;
        transition: background .15s ease;
    }
    .h5p-upload-error-btn:hover { background: #f1f5f9; }
</style>

<div class="container-fluid py-4">
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-light border">
            <i class="bi bi-arrow-left"></i> <span>Zurück</span>
        </a>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" id="h5pEditForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="h5p-form-card">
            <div class="h5p-form-header">
                <h4 class="fw-bold mb-0"><i class="bi bi-pencil me-2"></i>H5P-Inhalt bearbeiten</h4>
            </div>
            <div class="h5p-form-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Titel <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" placeholder="z.B. Künstliche Intelligenz im Studium" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Beschreibung</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Kurze Beschreibung des Inhalts…"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Schlüsselwörter</label>
                    <input asp-for="Keywords" class="form-control" placeholder="KI, Studium, Lernmodul (kommagetrennt)" />
                    <div class="form-text">Kommagetrennte Schlüsselwörter für die Suche und Filterung.</div>
                </div>

                <div class="mb-3">
                    <div class="mb-2">
                        <span class="badge bg-light text-dark border">
                            <i class="bi bi-file-earmark-zip me-1"></i>@(Model.OriginalFileName ?? "Unbekannt")
                        </span>
                    </div>
                    <label class="form-label fw-semibold">H5P-Datei</label>
                    <div class="upload-zone" id="h5pZone" onclick="document.getElementById('h5pFile').click()">
                        <i class="bi bi-file-earmark-zip"></i>
                        <div class="small text-muted mt-1">Neue .h5p-Datei hochladen (optional)</div>
                        <div class="file-name d-none" id="h5pFileName"></div>
                    </div>
                    <input type="file" name="h5pFile" id="h5pFile" accept=".h5p" class="d-none" />
                </div>

                <div class="mb-0">
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <div class="mb-2">
                            <img src="@Url.Content("~" + Model.ImagePath)" alt="Aktuelles Bild"
                                 style="max-height:120px; border-radius:.5rem; border:1px solid #e2e8f0;" />
                        </div>
                    }
                    <label class="form-label fw-semibold">Vorschaubild</label>
                    <div class="upload-zone" id="imgZone" onclick="document.getElementById('imageFile').click()">
                        <i class="bi bi-image"></i>
                        <div class="small text-muted mt-1">Neues Bild hochladen (optional)</div>
                        <div class="file-name d-none" id="imgFileName"></div>
                    </div>
                    <input type="file" name="imageFile" id="imageFile" accept="image/*" class="d-none" />
                </div>
            </div>
            <div class="h5p-form-footer">
                <a asp-action="Index" class="btn btn-light border">Abbrechen</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Speichern</button>
            </div>
        </div>
    </form>

    <div class="h5p-upload-overlay" id="h5pUploadOverlay" role="alertdialog" aria-live="assertive" aria-label="H5P-Upload läuft">
        <div class="h5p-upload-card" id="h5pUploadCard">
            <div class="h5p-upload-title" id="h5pUploadTitle">H5P-Datei wird aktualisiert</div>
            <div class="h5p-upload-sub" id="h5pUploadSub">Datei wird übertragen…</div>
            <div class="h5p-upload-progress">
                <div class="h5p-upload-bar" id="h5pUploadBar"></div>
            </div>
            <div class="h5p-upload-pct" id="h5pUploadPct">0 %</div>

            <div class="h5p-upload-success">
                <div class="h5p-upload-success-ring" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M4 12l5 5L20 7"/></svg>
                </div>
                <p class="h5p-upload-success-title">Erfolgreich aktualisiert</p>
                <p class="h5p-upload-success-sub">Weiterleitung zur Übersicht…</p>
            </div>

            <div class="h5p-upload-error">
                <div class="h5p-upload-error-ring" aria-hidden="true">
                    <i class="bi bi-exclamation-lg"></i>
                </div>
                <p class="h5p-upload-error-title" id="h5pUploadErrTitle">Upload fehlgeschlagen</p>
                <p class="h5p-upload-error-sub" id="h5pUploadErrSub">Bitte versuchen Sie es erneut.</p>
                <button type="button" class="h5p-upload-error-btn" id="h5pUploadErrClose">Schließen</button>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    function setupZone(zoneId, inputId, nameId) {
        const zone = document.getElementById(zoneId);
        const input = document.getElementById(inputId);
        const nameEl = document.getElementById(nameId);

        ['dragover','dragenter'].forEach(e => zone.addEventListener(e, ev => { ev.preventDefault(); zone.classList.add('dragover'); }));
        ['dragleave','drop'].forEach(e => zone.addEventListener(e, () => zone.classList.remove('dragover')));

        zone.addEventListener('drop', ev => {
            ev.preventDefault();
            if (ev.dataTransfer.files.length) {
                input.files = ev.dataTransfer.files;
                showName(input, nameEl, zone);
            }
        });
        input.addEventListener('change', () => showName(input, nameEl, zone));
    }
    function showName(input, nameEl, zone) {
        if (input.files.length) {
            nameEl.textContent = input.files[0].name;
            nameEl.classList.remove('d-none');
            zone.classList.add('has-file');
        }
    }
    setupZone('h5pZone', 'h5pFile', 'h5pFileName');
    setupZone('imgZone', 'imageFile', 'imgFileName');

    // Upload progress + success/error morph — only intercepts when a new .h5p file is selected
    const form = document.getElementById('h5pEditForm');
    const overlay = document.getElementById('h5pUploadOverlay');
    const card = document.getElementById('h5pUploadCard');
    const bar = document.getElementById('h5pUploadBar');
    const pct = document.getElementById('h5pUploadPct');
    const sub = document.getElementById('h5pUploadSub');
    const errSub = document.getElementById('h5pUploadErrSub');
    const errClose = document.getElementById('h5pUploadErrClose');

    function resetOverlay() {
        card.removeAttribute('data-state');
        bar.classList.remove('indeterminate');
        bar.style.width = '0%';
        pct.textContent = '0 %';
        sub.textContent = 'Datei wird übertragen…';
    }
    function closeOverlay() { overlay.classList.remove('is-open'); resetOverlay(); }
    errClose?.addEventListener('click', closeOverlay);

    form.addEventListener('submit', (ev) => {
        const h5pInput = document.getElementById('h5pFile');
        // Only intercept when a new .h5p file is being uploaded; otherwise let the form submit normally.
        if (!h5pInput.files.length) return;

        ev.preventDefault();
        resetOverlay();
        overlay.classList.add('is-open');

        const fd = new FormData(form);
        const xhr = new XMLHttpRequest();
        xhr.open('POST', form.action);
        xhr.upload.onprogress = (e) => {
            if (!e.lengthComputable) return;
            const p = Math.round((e.loaded / e.total) * 100);
            bar.style.width = p + '%';
            pct.textContent = p + ' %';
            if (p >= 100) {
                sub.textContent = 'Wird verarbeitet…';
                bar.classList.add('indeterminate');
                pct.textContent = '';
            }
        };
        xhr.onload = () => {
            if (xhr.status >= 200 && xhr.status < 400) {
                card.setAttribute('data-state', 'success');
                const target = xhr.responseURL || '@Url.Action("Index")';
                setTimeout(() => { window.location.href = target; }, 900);
            } else {
                errSub.textContent = 'Server antwortete mit Status ' + xhr.status + '.';
                card.setAttribute('data-state', 'error');
            }
        };
        xhr.onerror = () => {
            errSub.textContent = 'Netzwerkfehler beim Hochladen.';
            card.setAttribute('data-state', 'error');
        };
        xhr.send(fd);
    });
});
</script>

@model IEnumerable<ProjectsWebApp.Models.RegistrationCode>
@{
    ViewData["Title"] = "Einladungscodes-Managment";
}

<style>
    .btn-black {
        background: #000;
        color: #fff;
        border: 1px solid #000;
    }

        .btn-black:hover {
            background: #333;
            border-color: #333;
            color: #fff;
        }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Einladungscodes bearbeiten</h2>

    <a asp-action="Upsert" class="btn btn-black">
        <i class="bi bi-plus-lg"></i> Code hinzufügen
    </a>
</div>

@if (TempData["success"] != null)
{
    <div class="alert alert-success">@TempData["success"]</div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Id</th>
            <th>Code</th>
            <th>Aktiv</th>
            <th>Notiz</th>
            <th class="text-end">Aktionen</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.Code</td>
                <td>
                    <form asp-action="Toggle" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@c.Id" />
                        <button type="submit" class="btn btn-sm @(c.IsActive ? "btn-success" : "btn-secondary")">
                            @(c.IsActive ? "Ja" : "Nein")
                        </button>
                    </form>
                </td>
                <td>@c.Note</td>
                <td class="text-end">
                    <a asp-action="Upsert" asp-route-id="@c.Id" class="btn btn-sm btn-warning ms-2">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Code wirklich löschen?');">
                        <button type="submit" class="btn btn-sm btn-danger ms-2">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="d-flex justify-content-between align-items-center mb-3 mt-5">
    <h1 class="mb-0"></h1>

    <a asp-action="Upsert" class="btn btn-black">
        <i class="bi bi-plus-lg"></i> Code hinzufügen
    </a>
</div>
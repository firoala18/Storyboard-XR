@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Passwort ändern";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<style>
    #submit-btn {
        /* gradient unchanged */
        background: #000000;
        background: -webkit-linear-gradient(to right,#434343,#000000);
        background: linear-gradient(to right,#434343,#000000);
        color: #fff;
    }
</style>

<h3>@ViewData["Title"]</h3>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-6">
        <form id="passwort-aendern-formular" method="post" class="p-4 bg-light rounded shadow-sm">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="form-floating mb-4">
                <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Bitte altes Passwort eingeben" />
                <label asp-for="Input.OldPassword" class="form-label">Altes Passwort</label>
                <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
            </div>

            <div class="form-floating mb-4">
                <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Bitte neues Passwort eingeben" />
                <label asp-for="Input.NewPassword" class="form-label">Neues Passwort</label>
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>

            <div class="form-floating mb-4">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Bitte neues Passwort bestätigen" />
                <label asp-for="Input.ConfirmPassword" class="form-label">Neues Passwort bestätigen</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="w-100 btn btn-lg " id="submit-btn">
                Passwort aktualisieren
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

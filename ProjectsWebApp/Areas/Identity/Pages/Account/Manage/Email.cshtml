@page
@model EmailModel
@{
    ViewData["Title"] = "E-Mail verwalten";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<style>
    #change-email-button {
        /* gradient unchanged */
        background: #000000;
        background: -webkit-linear-gradient(to right,#434343,#000000);
        background: linear-gradient(to right,#434343,#000000);
        color: #fff;
    }
</style>

<h3>@ViewData["Title"]</h3>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-6">
        <form id="email-formular" method="post" class="p-4 bg-light rounded shadow-sm">
            <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>

            @if (Model.IsEmailConfirmed)
            {
                <div class="form-floating mb-4 input-group">
                    <input asp-for="Email" class="form-control" placeholder="E-Mail-Adresse" disabled />
                    <div class="input-group-append">
                        <span class="h-100 input-group-text text-success fw-bold">✓ Bestätigt</span>
                    </div>
                    <label asp-for="Email" class="form-label">Aktuelle E-Mail-Adresse (bestätigt)</label>
                </div>
            }
            else
            {
                <div class="form-floating mb-4">
                    <input asp-for="Email" class="form-control" placeholder="E-Mail-Adresse" disabled />
                    <label asp-for="Email" class="form-label">Aktuelle E-Mail-Adresse (nicht bestätigt)</label>
                    <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link mt-2">Bestätigungs-E-Mail senden</button>
                </div>
            }

            <div class="form-floating mb-4">
                <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="Neue E-Mail-Adresse eingeben" />
                <label asp-for="Input.NewEmail" class="form-label">Neue E-Mail-Adresse</label>
                <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
            </div>

            <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="w-100 btn btn-lg " style="background-color:#90bc14; color:white;">
                E-Mail-Adresse ändern
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

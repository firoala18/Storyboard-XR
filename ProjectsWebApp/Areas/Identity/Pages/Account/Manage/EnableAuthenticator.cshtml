@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Authenticator-App einrichten";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />

<h3>@ViewData["Title"]</h3>

<style>
    /* Begrenzung und Zentrierung des QR-Codes */
    .qr-code {
        max-width: 240px;
        width: 100%;
        height: auto;
        display: block;
        margin: .5rem auto 1rem;
    }

    /* Nummerierte Liste schöner formatieren */
    .setup-list {
        list-style: decimal inside;
        padding-left: 0;
    }

    /* Formularbreite einschränken */
    .verify-form {
        max-width: 320px;
        margin: 0 auto;
    }

    .btn-verfizieren{
        background:black;
        color:white;
    }
</style>

<div>
    <p>So verwenden Sie eine Authenticator-App:</p>
    <ol class="setup-list">
        <li>
            Installieren Sie eine Authenticator-App (z. B. Google Authenticator oder Microsoft Authenticator)
            auf Ihrem Mobilgerät.
        </li>
        <li class="mt-3">
            <p>Scannen Sie diesen QR-Code:</p>
            <img src="@Model.QrCodeImageUrl"
                 alt="QR-Code zur Einrichtung"
                 class="qr-code" />
            <p class="small text-muted text-center">
                Oder geben Sie alternativ diesen Schlüssel manuell ein:
                <kbd>@Model.SharedKey</kbd>
            </p>
        </li>
        <li class="mt-4">
            <p>Geben Sie anschließend den 6-stelligen Code aus Ihrer App zur Verifizierung ein:</p>
            <form method="post" class="verify-form">
                <div class="form-floating mb-3">
                    <input asp-for="Input.Code"
                           class="form-control"
                           autocomplete="off"
                           placeholder="Code eingeben…" />
                    <label asp-for="Input.Code">Verifizierungscode</label>
                    <span asp-validation-for="Input.Code" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-verfizieren w-100">Verifizieren</button>
                <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
            </form>
        </li>
    </ol>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

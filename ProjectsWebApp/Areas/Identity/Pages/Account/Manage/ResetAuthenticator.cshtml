@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Authenticator-Schlüssel zurücksetzen";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />

<h3>@ViewData["Title"]</h3>

<div class="alert alert-warning" role="alert">
    <strong>Achtung:</strong> Sie setzen Ihren aktuellen Authenticator-Schlüssel zurück.
    Ihre bestehende App muss anschließend neu konfiguriert werden.
</div>

<form method="post" class="w-100 w-md-50 mx-auto">
    <div class="form-floating mb-3">
        <input asp-for="Input.CurrentCode"
               class="form-control"
               autocomplete="off"
               placeholder="Aktuellen Verifizierungscode eingeben" />
        <label asp-for="Input.CurrentCode">Aktueller Verifizierungscode</label>
        <span asp-validation-for="Input.CurrentCode" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-dark w-100">
        Schlüssel zurücksetzen
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model ProjectsWebApp.Models.H5PContent
@{
    ViewData["Title"] = Model.Title;
}

<style>
    :root {
        --h-surface:#fff; --h-border:#e4e8ec; --h-border-light:#eef1f4;
        --h-text:#1a1d23; --h-text-secondary:#6b7280; --h-text-muted:#9ca3af;
        --h-accent:#89ba17; --h-accent-dark:#6f9a10;
        --h-radius:16px; --h-shadow:0 10px 24px rgba(16,24,40,.06);
    }
    .h5p-detail-header { background:var(--h-surface); border:1px solid var(--h-border-light); border-radius:var(--h-radius); box-shadow:var(--h-shadow); margin-bottom:1.25rem; overflow:hidden; position:relative; }
    .h5p-detail-header::before { content:''; position:absolute; top:0; left:0; right:0; height:6px; background:linear-gradient(90deg, var(--h-accent), var(--h-accent-dark)); }
    .h5p-detail-header-inner { padding:1.75rem 2rem 1.5rem; }
    .h5p-detail-title { font-size:1.6rem; font-weight:700; color:var(--h-text); margin-bottom:.5rem; line-height:1.3; }
    .h5p-detail-desc  { font-size:.92rem; color:var(--h-text-secondary); line-height:1.65; }
    .h5p-detail-meta  { display:flex; flex-wrap:wrap; gap:.65rem; margin-top:1rem; align-items:center; }
    .h5p-meta-pill { display:inline-flex; align-items:center; gap:.3rem; font-size:.75rem; font-weight:500; padding:4px 12px; border-radius:999px; background:#f1f5f9; color:var(--h-text-secondary); border:1px solid var(--h-border); }
    .h5p-kw-tag { font-size:.65rem; font-weight:600; padding:3px 10px; border-radius:999px; background:rgba(137,186,23,.1); color:#3b5f0a; border:1px solid rgba(137,186,23,.18); }
    .h5p-player { background:var(--h-surface); border:1px solid var(--h-border-light); border-radius:var(--h-radius); box-shadow:var(--h-shadow); overflow:hidden; }
    .h5p-player-bar { padding:.75rem 1.25rem; border-bottom:1px solid #f1f5f9; display:flex; align-items:center; justify-content:space-between; background:#fafbfc; }
    .h5p-player-bar h6 { font-weight:600; margin:0; font-size:.9rem; display:flex; align-items:center; gap:.45rem; color:var(--h-text); }
    .h5p-type-badge { font-size:.6rem; font-weight:700; text-transform:uppercase; letter-spacing:.04em; padding:2px 8px; border-radius:4px; background:rgba(137,186,23,.12); color:var(--h-accent-dark); }
    .h5p-fs-btn { display:inline-flex; align-items:center; gap:.35rem; padding:.35rem .85rem; border-radius:8px; font-size:.78rem; font-weight:500; background:var(--h-text); color:#fff; border:none; cursor:pointer; transition:background .15s; }
    .h5p-fs-btn:hover { background:#334155; }
    .h5p-player-body { position:relative; width:100%; min-height:500px; background:#f8fafc; padding:1rem; }
    .h5p-player-body .h5p-container { width:100%; min-height:480px; }

    /* Loading spinner overlay inside the player */
    .h5p-loading { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px; background:linear-gradient(180deg,#fafbfc,#f1f5f9); z-index:5; transition:opacity .25s ease; }
    .h5p-loading.is-hidden { opacity:0; pointer-events:none; }
    .h5p-loading-spinner { width:42px; height:42px; border-radius:50%; border:3px solid rgba(137,186,23,.2); border-top-color:var(--h-accent); animation:h5pSpin .8s linear infinite; }
    .h5p-loading-text { font-size:.9rem; color:#475569; font-weight:500; }
    @@keyframes h5pSpin { to { transform: rotate(360deg); } }

    /* Immersive (floating fullscreen) mode: hide nav/footer, expand player */
    body.h5p-immersive .top-toolbar,
    body.h5p-immersive header,
    body.h5p-immersive .footer,
    body.h5p-immersive .breadcrumb,
    body.h5p-immersive nav[aria-label="breadcrumb"] { display: none !important; }
    body.h5p-immersive { overflow: hidden; }
    body.h5p-immersive .h5p-detail-header { display: none; }
    body.h5p-immersive .h5p-player {
        position: fixed; inset: 0; z-index: 1900;
        border-radius: 0; border: none;
        display: flex; flex-direction: column;
    }
    body.h5p-immersive .h5p-player-body { flex: 1; min-height: 0; padding: 0; }
    body.h5p-immersive .h5p-player-body .h5p-container { min-height: 100%; height: 100%; }
    body.h5p-immersive .container-fluid { padding: 0; max-width: 100%; }
    body.h5p-immersive main[role="main"] { padding: 0; }

    @@media (max-width:640px) { .h5p-detail-header-inner { padding:1.25rem; } .h5p-detail-title { font-size:1.3rem; } }
</style>

<div class="container-fluid py-4">
    <div class="mb-3">
        <a class="btn btn-light border" asp-action="Gallery" asp-route-bare="@((ViewData["_H5PBare"] as bool? == true) ? "1" : null)">
            <i class="bi bi-arrow-left"></i> <span>Zurück zur Übersicht</span>
        </a>
    </div>

    <div class="h5p-detail-header">
        <div class="h5p-detail-header-inner">
            <h1 class="h5p-detail-title">@Model.Title</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <div class="h5p-detail-desc">@Model.Description</div>
            }
            <div class="h5p-detail-meta">
                <span class="h5p-meta-pill"><i class="bi bi-calendar3"></i> @Model.CreatedAtUtc.ToLocalTime().ToString("dd. MMMM yyyy")</span>
                @if (!string.IsNullOrWhiteSpace(Model.Keywords))
                {
                    @foreach (var kw in Model.Keywords.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                    {
                        <span class="h5p-kw-tag">#@kw</span>
                    }
                }
            </div>
        </div>
    </div>

    <div class="h5p-player">
        <div class="h5p-player-bar">
            <h6>
                <i class="bi bi-play-circle-fill" style="color:var(--h-accent);"></i>
                Interaktiver Inhalt
                <span class="h5p-type-badge">H5P</span>
            </h6>
            <button type="button" class="h5p-fs-btn" id="h5pFsBtn" onclick="toggleH5PFullscreen()">
                <i class="bi bi-arrows-fullscreen"></i> <span id="h5pFsLabel">Vollbild</span>
            </button>
        </div>
        <div class="h5p-player-body" id="h5pPlayerBody">
            <div class="h5p-loading" id="h5pLoading" role="status" aria-live="polite">
                <div class="h5p-loading-spinner" aria-hidden="true"></div>
                <div class="h5p-loading-text">Inhalt wird geladen…</div>
            </div>
            <div class="h5p-container" id="h5pContainer"></div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/h5p-standalone@3.7.1/dist/main.bundle.js"></script>
<script>
document.addEventListener('DOMContentLoaded', async () => {
    const el = document.getElementById('h5pContainer');
    const loading = document.getElementById('h5pLoading');
    const contentPath = '@Html.Raw(Url.Content("~" + Model.ContentPath))';

    function hideLoading() { loading?.classList.add('is-hidden'); }

    // The player is ready when the H5P library injects its iframe/content into the container.
    const observer = new MutationObserver(() => {
        if (el.children.length > 0) {
            hideLoading();
            observer.disconnect();
        }
    });
    observer.observe(el, { childList: true, subtree: true });
    // Safety fallback: hide the spinner after 15s in case the library never mutates.
    setTimeout(hideLoading, 15000);

    try {
        const instance = new H5PStandalone.H5P(el, {
            h5pJsonPath: contentPath,
            frameJs:  'https://cdn.jsdelivr.net/npm/h5p-standalone@3.7.1/dist/frame.bundle.js',
            frameCss: 'https://cdn.jsdelivr.net/npm/h5p-standalone@3.7.1/dist/styles/h5p.css'
        });
        // Some versions of h5p-standalone return a promise.
        if (instance && typeof instance.then === 'function') {
            instance.then(hideLoading).catch(() => {});
        }
    } catch (err) {
        console.error('H5P load error:', err);
        hideLoading();
        el.innerHTML = '<div class="text-center py-5 text-muted"><i class="bi bi-exclamation-triangle fs-2 d-block mb-2"></i>Inhalt konnte nicht geladen werden.</div>';
    }
});

function toggleH5PFullscreen() {
    const body = document.body;
    const label = document.getElementById('h5pFsLabel');
    const btn = document.getElementById('h5pFsBtn');
    const on = !body.classList.contains('h5p-immersive');
    body.classList.toggle('h5p-immersive', on);
    if (label) label.textContent = on ? 'Schließen' : 'Vollbild';
    if (btn) {
        const ico = btn.querySelector('i');
        if (ico) ico.className = on ? 'bi bi-fullscreen-exit' : 'bi bi-arrows-fullscreen';
    }
}

document.addEventListener('keydown', (ev) => {
    if (ev.key === 'Escape' && document.body.classList.contains('h5p-immersive')) {
        toggleH5PFullscreen();
    }
});
</script>

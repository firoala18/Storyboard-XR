@model IEnumerable<ProjectsWebApp.Models.H5PContent>
@{
    ViewData["Title"] = "H5P-Inhalte";
    var search = ViewBag.Search as string;
    var total = Model.Count();
}

<style>
    :root {
        --h-bg:#f4f6f8; --h-surface:#fff; --h-border:#e4e8ec; --h-border-light:#eef1f4;
        --h-text:#1a1d23; --h-text-secondary:#6b7280; --h-text-muted:#9ca3af;
        --h-accent:#89ba17; --h-accent-dark:#6f9a10; --h-accent-light:#eaf5d0; --h-accent-ghost:#f5fbe8;
        --h-radius:16px; --h-radius-sm:10px;
        --h-shadow:0 10px 24px rgba(16,24,40,.06); --h-shadow-lg:0 20px 40px rgba(16,24,40,.1);
        --h-ease:.22s cubic-bezier(.4,0,.2,1);
    }
    .h5p-hero { background:var(--h-surface); border:1px solid var(--h-border-light); border-radius:var(--h-radius); box-shadow:var(--h-shadow); padding:1.75rem 2rem; margin-bottom:1.25rem; position:relative; overflow:hidden; }
    .h5p-hero::before { content:''; position:absolute; top:0; left:0; right:0; height:6px; background:linear-gradient(90deg, var(--h-accent), var(--h-accent-dark)); }
    .h5p-hero-row { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:1rem; }
    .h5p-hero-left { display:flex; align-items:center; gap:1rem; }
    .h5p-hero-icon { width:56px; height:56px; border-radius:14px; background:rgba(137,186,23,.12); display:flex; align-items:center; justify-content:center; font-size:1.6rem; color:var(--h-accent); }
    .h5p-hero h1 { font-size:1.55rem; font-weight:700; margin:0; color:var(--h-text); letter-spacing:.2px; }
    .h5p-hero-sub { font-size:.88rem; color:var(--h-text-secondary); margin-top:.15rem; }
    .h5p-toolbar { border:1px solid var(--h-border-light); border-radius:14px; background:var(--h-surface); padding:.6rem; box-shadow:var(--h-shadow); margin-bottom:1.25rem; display:flex; align-items:center; gap:.5rem; flex-wrap:wrap; }
    .h5p-search-wrap { position:relative; flex:1; min-width:220px; }
    .h5p-search-wrap input { width:100%; height:42px; padding-left:2.4rem; padding-right:.75rem; border:2px solid var(--h-border); border-radius:var(--h-radius-sm); font-size:.88rem; color:var(--h-text); transition:border-color .2s, box-shadow .2s; background:#fff; }
    .h5p-search-wrap input:focus { border-color:var(--h-accent); outline:none; box-shadow:0 0 0 .2rem rgba(137,186,23,.15); }
    .h5p-search-wrap input::placeholder { color:var(--h-text-muted); }
    .h5p-search-wrap .si { position:absolute; left:.7rem; top:50%; transform:translateY(-50%); font-size:1rem; color:var(--h-text-muted); pointer-events:none; }
    .h5p-toolbar-count { font-size:.8rem; font-weight:600; color:var(--h-accent); background:var(--h-accent-ghost); padding:4px 12px; border-radius:999px; font-family:'JetBrains Mono', monospace; white-space:nowrap; }
    .h5p-toolbar-reset { font-size:.78rem; font-weight:500; padding:4px 12px; border-radius:999px; background:#fff; border:1px solid var(--h-border); color:var(--h-text-secondary); text-decoration:none; transition:all .15s; }
    .h5p-toolbar-reset:hover { background:#f1f5f9; color:var(--h-text); }
    .h5p-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)); gap:1rem; }
    @@media (min-width:1600px) { .h5p-grid { grid-template-columns:repeat(4, 1fr); } }
    @@media (max-width:640px)  { .h5p-grid { grid-template-columns:1fr; } }
    .h5p-card { border:1px solid var(--h-border-light); border-radius:var(--h-radius); overflow:hidden; background:var(--h-surface); box-shadow:var(--h-shadow); transition:transform var(--h-ease), box-shadow var(--h-ease), border-color var(--h-ease); display:flex; flex-direction:column; height:100%; text-decoration:none; color:inherit; cursor:pointer; }
    .h5p-card:hover { transform:translateY(-4px); box-shadow:var(--h-shadow-lg); border-color:var(--h-accent-light); }
    .h5p-card-cover { height:160px; overflow:hidden; position:relative; border-bottom:1px solid var(--h-border-light); background:linear-gradient(135deg, rgba(137,186,23,.06), rgba(137,186,23,.02)); }
    .h5p-card-cover img { width:100%; height:100%; object-fit:cover; transition:transform .35s ease; }
    .h5p-card:hover .h5p-card-cover img { transform:scale(1.06); }
    .h5p-card-cover-ph { width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-size:3rem; color:var(--h-accent); opacity:.2; }
    .h5p-card-type { position:absolute; top:.6rem; right:.6rem; font-size:.58rem; font-weight:700; text-transform:uppercase; letter-spacing:.04em; padding:3px 10px; border-radius:999px; background:rgba(137,186,23,.85); color:#fff; }
    .h5p-card-body { padding:1rem 1.1rem; flex:1; display:flex; flex-direction:column; gap:.35rem; }
    .h5p-card-title { font-weight:700; font-size:1.02rem; color:var(--h-text); line-height:1.3; }
    .h5p-card-desc { color:var(--h-text-secondary); font-size:.84rem; line-height:1.45; display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; flex:1; }
    .h5p-card-tags { display:flex; flex-wrap:wrap; gap:.3rem; margin-top:auto; padding-top:.4rem; }
    .h5p-kw { font-size:.62rem; font-weight:600; padding:2px 8px; border-radius:999px; background:rgba(137,186,23,.1); color:#3b5f0a; border:1px solid rgba(137,186,23,.18); }
    .h5p-card-foot { padding:.6rem 1rem; border-top:1px solid #f1f5f9; display:flex; align-items:center; justify-content:space-between; }
    .h5p-card-date { font-size:.72rem; color:var(--h-text-muted); }
    .h5p-card-open { font-size:.78rem; font-weight:600; color:var(--h-accent); display:flex; align-items:center; gap:.3rem; transition:color .15s; }
    .h5p-card:hover .h5p-card-open { color:var(--h-accent-dark); }
    .h5p-empty { padding:4rem 1rem; text-align:center; }
    .h5p-empty-icon { width:80px; height:80px; border-radius:50%; background:linear-gradient(135deg, rgba(137,186,23,.12), rgba(137,186,23,.04)); display:inline-flex; align-items:center; justify-content:center; font-size:2.2rem; color:var(--h-accent); margin-bottom:1rem; animation:h5pFloat 4s ease-in-out infinite; }
    @@keyframes h5pFloat { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-6px); } }
</style>

<div class="container-fluid py-4">
    <div class="h5p-hero">
        <div class="h5p-hero-row">
            <div class="h5p-hero-left">
                <div class="h5p-hero-icon"><i class="bi bi-collection-play"></i></div>
                <div>
                    <h1>Interaktive Lernmodule</h1>
                    <div class="h5p-hero-sub">Entdecken Sie interaktive H5P-Inhalte für Ihr Studium und Ihre Lehre.</div>
                </div>
            </div>
        </div>
    </div>

    <div class="h5p-toolbar">
        <div class="h5p-search-wrap">
            <i class="bi bi-search si"></i>
            <form method="get" style="display:contents">
                @if ((ViewData["_H5PBare"] as bool? == true))
                {
                    <input type="hidden" name="bare" value="1" />
                }
                <input type="text" name="search" value="@search"
                       placeholder="Titel, Beschreibung oder Schlüsselwort …" autocomplete="off" />
            </form>
        </div>
        <span class="h5p-toolbar-count">@total Inhalte</span>
        @if (!string.IsNullOrEmpty(search))
        {
            <a href="@Url.Action("Gallery", new { bare = (ViewData["_H5PBare"] as bool? == true) ? "1" : null })" class="h5p-toolbar-reset"><i class="bi bi-x-lg me-1"></i>Zurücksetzen</a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="h5p-empty">
            <div class="h5p-empty-icon"><i class="bi bi-collection-play"></i></div>
            <h5 class="fw-semibold mb-1" style="color:var(--h-text);">Noch keine Inhalte verfügbar</h5>
            <p class="small" style="color:var(--h-text-muted);">Schauen Sie später noch einmal vorbei.</p>
        </div>
    }
    else
    {
        <div class="h5p-grid">
            @foreach (var item in Model)
            {
                <a asp-action="Details" asp-route-id="@item.Id" asp-route-bare="@((ViewData["_H5PBare"] as bool? == true) ? "1" : null)" class="h5p-card">
                    <div class="h5p-card-cover">
                        @if (!string.IsNullOrEmpty(item.ImagePath))
                        {
                            <img src="@Url.Content("~" + item.ImagePath)" alt="@item.Title" />
                        }
                        else
                        {
                            <div class="h5p-card-cover-ph"><i class="bi bi-collection-play"></i></div>
                        }
                        <span class="h5p-card-type">H5P</span>
                    </div>
                    <div class="h5p-card-body">
                        <div class="h5p-card-title">@item.Title</div>
                        <div class="h5p-card-desc">@(item.Description ?? "")</div>
                        @if (!string.IsNullOrWhiteSpace(item.Keywords))
                        {
                            <div class="h5p-card-tags">
                                @foreach (var kw in item.Keywords.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(4))
                                {
                                    <span class="h5p-kw">#@kw</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="h5p-card-foot">
                        <span class="h5p-card-date"><i class="bi bi-calendar3 me-1"></i>@item.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy")</span>
                        <span class="h5p-card-open">Öffnen <i class="bi bi-arrow-right-short"></i></span>
                    </div>
                </a>
            }
        </div>
    }
</div>

@model IEnumerable<ProjectsWebApp.Models.Storyboard>
@{
    ViewData["Title"] = "Storyboards";
    ViewBag.FullWidth = true;
}
<h1>Storyboards</h1>
<p>
    <a class="btn" asp-action="Create">+ New Storyboard</a>
</p>
<table class="table">
    <thead>
        <tr><th>Title</th><th>Image</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var sb in Model)
        {
            <tr>
                <td>@sb.Title</td>
                <td>
                    <img src="@sb.ImagePath" alt="thumbnail" class="thumb" />
                </td>
                <td class="actions">
                    <a asp-action="Details" asp-route-id="@sb.Id">Open</a>
                    <a asp-action="Edit" asp-route-id="@sb.Id">Edit</a>
                    <form asp-action="Delete" asp-route-id="@sb.Id" method="post" onsubmit="return confirm('Delete this storyboard?');">
                        <button type="submit" class="link danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
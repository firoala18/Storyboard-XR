@model ProjectsWebApp.Models.LernFlow
@{
    ViewData["Title"] = Model.Title;
    ViewBag.FullWidth = true;
    var slug = ViewData["PublicSlug"] as string ?? Model.PublicId;
    var basePath = Context.Request.PathBase.HasValue ? Context.Request.PathBase.Value : "";
}

<link rel="stylesheet" href="~/css/lernpfad.css" />
<style>
    /* Match index storyboard chip + thumb styles */
    .sb-chips { display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
    .sb-chip { display:inline-flex; align-items:center; gap:6px; padding:5px 12px; border-radius:999px; font-weight:500; font-size:.85rem; background:#eef2ff; color:#1f3bb3; border:1px solid #e3e8ff; }
    .sb-chip .dot { width:8px; height:8px; border-radius:50%; background:#3b82f6; display:inline-block; box-shadow:0 0 0 2px rgba(59,130,246,.2); }
    .sb-chip.muted { background:#f8fafc; color:#64748b; border-color:#f1f5f9; }
    .detail-thumb { background: linear-gradient(to bottom right, #f5f7fb, #f0f4ff); border:1px solid #f0f2f7; aspect-ratio:16/9; position:relative; display:flex; align-items:center; justify-content:center; overflow:hidden; border-radius:12px; }
    .detail-thumb img { width:100%; height:100%; object-fit:cover; display:block; cursor: zoom-in; }
    .step-thumb { width:100%; max-width:360px; aspect-ratio:16/9; border-radius:6px; display:block; border:1px solid #f0f2f7; object-fit:cover; cursor: zoom-in; }
</style>
    <div class="container-fluid">
        <div class="row g-4">
            <div class="col-12">
                <div class="glass-card p-4 h-100">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h3 class="mb-0">@Model.Title</h3>
                            <span class="badge text-bg-light">@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <input class="form-control visually-hidden" id="shareUrl" value="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}/lp/{slug}")" readonly />
                            <button class="btn btn-outline-dark btn-sm" type="button" id="copyShare" title="Link kopieren">
                                <i class="bi bi-link-45deg me-1"></i>Teilen
{{ ... }}
                            <a class="btn btn-outline-dark btn-sm" href="@Url.Action("My", "PublicLernpfad", new { area = "User" })">Zur Übersicht</a>
                            @if ((ViewBag.CanEdit as bool?) == true)
                            {
                                <a class="btn btn-dark btn-sm" href="lp/@slug/edit"><i class="bi bi-pencil-square me-1"></i>Bearbeiten</a>
                                <form method="post" action="lp/@slug/delete" class="d-inline" onsubmit="return confirm('Diesen Lernpfad wirklich löschen?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash me-1"></i>Löschen</button>
                                </form>
                            }
                        </div>
                    </div>
                    <div class="sb-chips mb-2">
                        <span class="sb-chip"><span class="dot"></span>@((Model.Steps?.Count ?? 0) == 1 ? "1 Schritt" : $"{(Model.Steps?.Count ?? 0)} Schritte")</span>
                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        { <span class="sb-chip muted">Beschreibung</span> }
                    </div>
                    @{
                        var cover = !string.IsNullOrWhiteSpace(Model.ImagePath)
                            ? Model.ImagePath
                            : (Model.Steps?.OrderBy(x => x.Order).ThenBy(x => x.Id)
                                .FirstOrDefault(s => !string.IsNullOrWhiteSpace(s.ImagePath))?.ImagePath);
                        var coverUrl = !string.IsNullOrWhiteSpace(cover) ? (basePath + cover) : null;
                    }
                    @if (!string.IsNullOrWhiteSpace(cover))
                    {
                        <div class="detail-thumb mb-3">
                            <img src="@coverUrl" alt="Cover" loading="lazy" onerror="this.remove();" data-lightbox="image" data-full="@coverUrl" />
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <div class="text-muted">@Html.Raw(Model.Description)</div>
                    }

                    <hr />

                    <div id="progressWrap" class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <strong>Fortschritt</strong>
                            <span id="progressLabel">0%</span>
                        </div>
                        <div class="progress" style="height: 10px;">
                            <div id="progressBar" class="progress-bar" role="progressbar" style="width: 0%;"></div>
                        </div>
                    </div>

                    <ul class="list-group" id="lpSteps" data-slug="@slug">
                        @foreach (var s in (Model.Steps ?? new List<ProjectsWebApp.Models.LernStep>()).OrderBy(x => x.Order).ThenBy(x => x.Id))
                        {
                            var stepId = $"step_{s.Id}";
                            <li class="list-group-item">
                                <div class="form-check">
                                    <input class="form-check-input lp-step" type="checkbox" value="@s.Id" id="@stepId">
                                    <label class="form-check-label" for="@stepId">
                                        <strong>@s.Title</strong>
                                        @if (!string.IsNullOrWhiteSpace(s.Description))
                                        {
                                            <div class="small text-muted">@Html.Raw(s.Description)</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(s.ImagePath))
                                        {
                                            <div class="mt-2">
                                                <img src="@(basePath + s.ImagePath)" alt="Schrittbild" class="step-thumb" data-lightbox="image" data-full="@(basePath + s.ImagePath)" />
                                            </div>
                                        }
                                    </label>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Lightbox Modal for images (moved to bottom for reliability) -->
<div class="modal fade" id="imageLightbox" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bg-transparent border-0">
            <div class="modal-body p-0 d-flex justify-content-center">
                <img id="lightboxImage" class="img-fluid rounded shadow" alt="Bild" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Simple lightbox handler using Bootstrap modal
        document.addEventListener('click', function (e) {
            const img = e.target.closest('img[data-lightbox]');
            if (!img) return;
            e.preventDefault();
            const src = img.getAttribute('data-full') || img.getAttribute('src');
            const modalEl = document.getElementById('imageLightbox');
            const lightboxImg = document.getElementById('lightboxImage');
            if (lightboxImg) lightboxImg.src = src;
            if (typeof bootstrap !== 'undefined' && modalEl) {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            } else {
                window.open(src, '_blank');
            }
        });
    </script>
    <script src="~/js/lernpfad.js"></script>
}

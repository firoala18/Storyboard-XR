@model IEnumerable<ProjectsWebApp.Models.LernFlow>
@{
    ViewData["Title"] = "Lernpfade";
    ViewBag.FullWidth = true;
    var hasItems = Model != null && Model.Any();
    var isPublicIndex = (bool?)ViewData["PublicIndex"] ?? false;
    var basePath = Context.Request.PathBase.HasValue ? Context.Request.PathBase.Value : "";
    var totalFlows = Model?.Count() ?? 0;
    var totalSteps = Model?.Sum(f => f.Steps?.Count ?? 0) ?? 0;
    var query = ViewBag.Query as string;
}

<style>
    body { background-color: #f9fafc; }
    .Content-Body{ margin-bottom:7%; }
    .page-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:28px; padding:16px 0; }
    .page-head h1 { font-size:2.4rem; font-weight:700; color:#111827; margin:0; letter-spacing:-0.025em; }
    .cards-grid { display:grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap:28px; }
    .sb-card { background:#fff; border:1px solid #e5e7eb; border-radius:16px; overflow:hidden; box-shadow:0 4px 6px -1px rgba(0,0,0,.05), 0 2px 4px -1px rgba(0,0,0,.03); transition:all .25s ease; position:relative; }
    .sb-card:hover { transform: translateY(-4px); box-shadow:0 20px 25px -5px rgba(0,0,0,.08), 0 10px 10px -5px rgba(0,0,0,.02); border-color:#d1d5db; }
    .sb-thumb { background: linear-gradient(to bottom right, #f5f7fb, #f0f4ff); border-bottom:1px solid #f0f2f7; aspect-ratio:16/9; position:relative; display:flex; align-items:center; justify-content:center; overflow:hidden; }
    .sb-main { padding:18px 20px 20px; display:grid; grid-template-rows:auto auto 1fr auto; row-gap:12px; }
    .sb-title { font-weight:600; font-size:1.1rem; color:#111827; letter-spacing:-0.01em; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; margin:0; }
    .sb-chips { display:flex; gap:8px; align-items:center; }
    .sb-chip { display:inline-flex; align-items:center; gap:6px; padding:5px 12px; border-radius:999px; font-weight:500; font-size:.85rem; background:#eef2ff; color:#1f3bb3; border:1px solid #e3e8ff; }
    .sb-chip .dot { width:8px; height:8px; border-radius:50%; background:#3b82f6; display:inline-block; box-shadow:0 0 0 2px rgba(59,130,246,.2); }
    .sb-chip.muted { background:#f8fafc; color:#64748b; border-color:#f1f5f9; }
    .sb-footer { display:flex; gap:10px; align-items:center; flex-wrap:wrap; padding-top:8px; margin-top:8px; border-top:1px solid #f3f4f6; }
    .sb-footer .btn-soft, .sb-footer .btn-danger { white-space:nowrap; }
    .btn-primary { background:#4a86e8; border:1px solid #4a86e8; color:#fff; border-radius:10px; padding:10px 18px; font-weight:600; text-decoration:none; transition:all .2s ease; box-shadow:0 1px 2px rgba(0,0,0,.05); }
    .btn-primary:hover { background:#3b78e0; transform: translateY(-1px); box-shadow:0 4px 6px rgba(0,0,0,.05); }
    .btn-soft { background:#eef2ff; border:1px solid #e3e8ff; color:#1f3bb3; border-radius:8px; padding:8px 14px; font-weight:500; text-decoration:none; font-size:.9rem; transition:all .2s ease; }
    .btn-soft:hover { background:#e6ebff; transform: translateY(-1px); box-shadow:0 2px 4px rgba(31,59,179,.1); }
    .btn-danger { background:#fee2e2; border:1px solid #fecaca; color:#b42318; border-radius:8px; padding:8px 14px; font-weight:500; font-size:.9rem; transition:all .2s ease; }
    .btn-danger:hover { background:#ffd6d6; transform: translateY(-1px); box-shadow:0 2px 4px rgba(180,35,24,.1); }
    .empty-wrap { min-height:60vh; display:flex; align-items:center; justify-content:center; text-align:center; border:2px dashed #e5e7eb; border-radius:20px; background: linear-gradient(to bottom, #fafbfd, #f6f8ff); margin:20px 0; }
    .empty-inner { max-width:560px; padding:40px 30px; }
    .empty-title { font-weight:700; font-size:2rem; margin-bottom:12px; color:#111827; letter-spacing:-0.025em; }
    .empty-sub { color:#6b7280; margin-bottom:28px; font-size:1.05rem; line-height:1.6; }
    @@media (max-width:768px){ .page-head{flex-direction:column; align-items:flex-start; gap:16px;} .cards-grid{grid-template-columns:1fr; gap:20px;} }
    /* Light search input (force) */
    .page-head .form-control { background:#fff !important; color:#111827 !important; border:1px solid #e5e7eb !important; }
    .page-head .form-control::placeholder { color:#6b7280 !important; }
    .page-head .form-control:focus { border-color:#86b7fe !important; box-shadow:0 0 0 .2rem rgba(13,110,253,.15) !important; }
</style>

<div class="Content-Body">

@if (!hasItems)
{
    <div class="page-head">
        <h1>Lernpfade</h1>
        <span></span>
    </div>

    <!-- Stats chips -->
    <div class="sb-chips mb-3">
        <span class="sb-chip"><span class="dot"></span>Total Flows: @totalFlows</span>
        <span class="sb-chip muted">Total Steps: @totalSteps</span>
    </div>

    <div class="empty-wrap">
        <div class="empty-inner">
            <div class="empty-title">Noch keine Lernpfade vorhanden</div>
            <div class="empty-sub">Starte jetzt und lege deinen ersten Lernpfad an. Füge Schritte hinzu und strukturiere deinen Lernweg.</div>
            <button class="btn-primary" data-bs-toggle="modal" data-bs-target="#createFlowModal">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Ersten Lernpfad erstellen
            </button>
        </div>
    </div>
}
else
{
    <div class="page-head">
        <h1>Lernpfade</h1>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <form class="d-flex" method="get" action="lp/my">
                <input type="text" name="q" value="@query" class="form-control me-2" placeholder="Suchen..." />
                <button class="btn btn-soft" type="submit"><i class="bi bi-search"></i></button>
            </form>
            <button class="btn-primary" data-bs-toggle="modal" data-bs-target="#createFlowModal">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Neuer Lernpfad
            </button>
        </div>
    </div>

    <div class="cards-grid">
        @foreach (var f in Model!)
        {
            var stepCount = f.Steps?.Count ?? 0;
            var stepLabel = stepCount == 1 ? "1 Schritt" : $"{stepCount} Schritte";
           var cover = !string.IsNullOrWhiteSpace(f.ImagePath)
    ? (basePath + f.ImagePath)
    : (f.Steps?.OrderBy(x => x.Order).ThenBy(x => x.Id)
        .FirstOrDefault(s => !string.IsNullOrWhiteSpace(s.ImagePath))?.ImagePath != null
        ? basePath + f.Steps.OrderBy(x => x.Order).ThenBy(x => x.Id)
            .First(s => !string.IsNullOrWhiteSpace(s.ImagePath)).ImagePath
        : null);
            <div class="sb-card">
                <div class="sb-thumb">
                    @if (!string.IsNullOrWhiteSpace(cover))
                    {
                        <img src="@cover" alt="Cover" loading="lazy" onerror="this.remove();" />
                    }
                    else
                    {
                        <i class="bi bi-list-check" style="font-size: 42px; color: #93a3ff;"></i>
                    }
                </div>
                <div class="sb-main">
                    <div class="sb-title">@f.Title</div>
                    <div class="sb-chips">
                        <span class="sb-chip"><span class="dot"></span>@stepLabel</span>
                        @if (!string.IsNullOrWhiteSpace(f.Description))
                        { <span class="sb-chip muted">@((f.Description!.Length > 36) ? f.Description.Substring(0, 36) + "…" : f.Description)</span> }
                    </div>
                    <div class="sb-footer">
                        <a class="btn-soft" href="@(basePath + "/lp/" + f.PublicId)" title="Ansehen"><i class="bi bi-eye"></i></a>
                        <a class="btn-soft" href="@(basePath + "/lp/" + f.PublicId + "/edit")" title="Bearbeiten"><i class="bi bi-pencil-square"></i></a>
                        <form action="@(basePath + "/lp/" + f.PublicId + "/delete")" method="post" onsubmit="return confirm('Lernpfad wirklich löschen?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-danger" title="Löschen"><i class="bi bi-trash"></i></button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}

</div>

<!-- Create Flow Modal -->
<div class="modal fade" id="createFlowModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content glass-card">
            <div class="modal-header border-0">
                <h5 class="modal-title">Neuen Lernpfad erstellen</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="createFlowForm" method="post" action="lp/create" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label text-dark">Titel</label>
                        <input class="form-control form-control-lg" name="title" placeholder="z.B. Einführung in XR-Technologien" required />
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-dark">Beschreibung (optional)</label>
                        <textarea class="form-control richtext" rows="3" name="description" placeholder="Kurze Übersicht deines Lernpfades"></textarea>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-dark">Bild (optional)</label>
                        <input type="file" class="form-control" name="flowImage" accept="image/*" />
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0 text-dark">Schritte</h6>
                        <button type="button" class="btn btn-sm btn-dark" id="addStepBtn"><i class="bi bi-plus-lg me-1"></i>Schritt hinzufügen</button>
                    </div>

                    <ul class="list-group" id="stepList">
                        <!-- Steps dynamically added here -->
                    </ul>

                    <div class="text-end mt-4">
                        <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-check2-circle me-2"></i>Erstellen</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.js"></script>
    <script>
        (function(){
            // Keep the same API used by lernpfad.js
            window._smEditors = window._smEditors || [];
            window.initRichText = function(el){
                if(!el || !window.jQuery) return;
                var $el = window.jQuery(el);
                try {
                  $el.summernote({
                    height: 200,
                    placeholder: el.getAttribute('placeholder') || '',
                    toolbar: [
                      ['style', ['bold','italic','underline','clear']],
                      ['font', ['fontsize','color']],
                      ['para', ['ul','ol','paragraph']],
                      ['insert', ['picture','video','link']],
                      ['view', ['codeview']]
                    ]
                  });
                  window._smEditors.push({ el: el, $: $el });
                } catch(err){ console && console.warn && console.warn('Summernote init failed', err); }
            };
            window.syncRichText = function(){
                (window._smEditors || []).forEach(function(p){ try{ p.el.value = p.$.summernote('code'); } catch(e){} });
            };
            document.addEventListener('DOMContentLoaded', function(){
                document.querySelectorAll('textarea.richtext').forEach(function(t){ window.initRichText(t); });
            });
        })();
    </script>
    <script src="~/js/lernpfad.js"></script>
}

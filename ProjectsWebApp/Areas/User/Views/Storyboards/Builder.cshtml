@model ProjectsWebApp.Models.Storyboard
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Title) ? "Storyboard Builder" : Model.Title;
    var initialStep = ViewBag.InitialStep as int? ?? 1;
    ViewBag.FullWidth = true;
}

@if (Model.AllowSharedEditing)
{
    <link rel="stylesheet" href="~/css/presence.css" asp-append-version="true" />
}

@await Html.PartialAsync("~/Areas/User/Views/Storyboards/_BuilderTimeline.cshtml", Model)

<main class="builder-main" data-storyboard-id="@Model.Id"
      data-storyboard-rowversion="@(Model.RowVersion is null ? "" : Convert.ToBase64String(Model.RowVersion))"
      data-initial-step="@initialStep">

    <section class="builder-step-panel" data-step="1" hidden>
        @await Html.PartialAsync("~/Areas/User/Views/Storyboards/_BuilderStep1Infos.cshtml", Model)
    </section>

    <section class="builder-step-panel" data-step="2" hidden>
        @await Html.PartialAsync("~/Areas/User/Views/Storyboards/_BuilderStep2Scenes.cshtml", Model)
    </section>

    <section class="builder-step-panel" data-step="3" hidden>
        @await Html.PartialAsync("~/Areas/User/Views/Storyboards/_BuilderStep3Pdf.cshtml", Model)
    </section>

    <div class="builder-phone-notice" hidden>
        <p>Der Storyboard Builder ist für größere Bildschirme gebaut. Bitte nutze ein Tablet oder einen Laptop.</p>
    </div>
</main>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/tinymce@7/tinymce.min.js" referrerpolicy="origin"></script>
    <script src="~/js/ui-select.js" asp-append-version="true"></script>
    <script src="~/js/builder.js" asp-append-version="true"></script>
    <script src="~/js/builder-step2.js" asp-append-version="true"></script>
    @if (Model.AllowSharedEditing)
    {
        <script defer src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@7.0.5/dist/browser/signalr.min.js"></script>
        <script defer src="~/js/builder-signalr.js" asp-append-version="true"></script>
        <script defer src="~/js/builder-presence.js" asp-append-version="true"></script>
    }
}

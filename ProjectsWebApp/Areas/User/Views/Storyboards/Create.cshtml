@{
    ViewData["Title"] = "Neues Storyboard";
    ViewBag.FullWidth = true;
    var basePath = Context.Request.PathBase.HasValue ? Context.Request.PathBase.Value : "";
    var path = Context.Request.Path.HasValue ? Context.Request.Path.Value : "";
    var isPublic = path.StartsWith("/s");
}

<style>
    :root {
        --green-400: #9fd62a;
        --green-500: #89ba17;
        --green-600: #77a514;
        --green-700: #6a9312;
        --ink: #111827;
        --muted: #6b7280;
        --line: #e6e8ef;
        --bg-soft: #f8fafc;
    }

    /* Layout */
    .page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin: 8px 0 20px;
    }

        .page-head h4 {
            font-size: 1.25rem;
            line-height: 1.4;
            margin: 0;
            font-weight: 700;
            color: var(--ink);
            letter-spacing: -.015em;
        }

    .edit-grid {
        display: grid;
        grid-template-columns: 1fr; /* full width; preview removed */
        gap: 22px;
    }
    @@media (max-width:900px) {
        .edit-grid {
            grid-template-columns: 1fr;
        }
    }

    /* Cards */
    .card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 18px;
        box-shadow: 0 6px 18px rgba(16,24,40,.06);
        margin-bottom: 20px;
    }

    .card-title {
        font-weight: 700;
        margin: 0 0 12px;
        color: #111827;
        font-size: 1.1rem;
        letter-spacing: -.01em;
    }

    /* Accordion */
    details.acc {
        border-radius: 14px;
        overflow: hidden;
    }

        details.acc summary {
            list-style: none;
            cursor: pointer;
            padding: 12px 14px;
            border: 1px solid var(--line);
            border-radius: 14px;
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .75rem;
            transition: background .15s,border-color .15s;
        }

            details.acc summary:hover {
                background: rgba(137,186,23,.06);
                border-color: rgba(137,186,23,.35);
            }

        details.acc[open] summary {
            border-bottom-left-radius: 0;
            border-bottom-right-radius: 0;
        }

        details.acc .acc-body {
            border: 1px solid var(--line);
            border-top: 0;
            padding: 14px;
            border-bottom-left-radius: 14px;
            border-bottom-right-radius: 14px;
            overflow: hidden;
            opacity: 0;
            transition: height .28s ease, opacity .2s ease;
            will-change: height, opacity;
        }

    details.acc[open] .acc-body {
        opacity: 1;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: .5rem;
        font-weight: 700;
        color: #111827;
        font-size: 1.1rem;
    }

    .acc-caret {
        width: 1.6em;
        height: 1.6em;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        line-height: 1;
        margin-right: .5rem;
        font-size: 2rem;
        color: #4b5563;
    }

        .acc-caret::before {
            content: "▸";
        }

    details.acc[open] .acc-caret::before {
        content: "▾";
    }

    /* Buttons */
    .btn {
        border-radius: 10px;
        padding: 10px 16px;
        font-weight: 700;
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-primary {
        background: var(--green-500);
        border: 1px solid var(--green-600);
        color: #fff;
        transition: background .2s,transform .2s,box-shadow .2s;
    }

        .btn-primary:hover {
            background: var(--green-600);
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(137,186,23,.25);
        }

    .btn-secondary {
        background: #fff;
        border: 1px solid rgba(137,186,23,.35);
        color: var(--green-700);
        border-radius: 10px;
        padding: 10px 16px;
        font-weight: 800;
        text-decoration: none !important;
        transition: background .2s ease, color .2s ease, border-color .2s ease;
    }

        .btn-secondary:hover {
            background: rgba(137,186,23,.08);
            color: black;
        }

    .btn-outline {
        background: #fff;
        border: 1px dashed #cfd6e4;
        color: #334155;
        border-radius: 10px;
        padding: 8px 12px;
        font-weight: 700;
    }

    /* Fields */
    .field {
        margin-bottom: 14px;
    }

        .field label {
            font-weight: 600;
            margin-bottom: 6px;
            display: block;
            color: var(--ink);
            font-size: 16px;
        }

        .field small, .text-muted {
            color: var(--muted);
            font-size: 14px;
        }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }
    @@media (max-width:700px) {
        .form-row {
            grid-template-columns: 1fr;
        }
    }

    .form-control, input[type=text], input[type=number], input[type=file], textarea, select {
        background: #fff !important;
        color: #111 !important;
        border: 1px solid #cfd6e4 !important;
        border-radius: 10px !important;
        padding: 10px 12px !important;
        min-height: 44px;
    }

        .form-control:focus, input:focus, textarea:focus, select:focus {
            border-color: var(--green-500) !important;
            box-shadow: 0 0 0 .2rem rgba(137,186,23,.25) !important;
            outline: none !important;
        }

    textarea {
        min-height: 72px;
        resize: vertical;
    }

    /* CKEditor polish */
    .ck.ck-editor { width: 100%; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; box-shadow: 0 1px 2px rgba(0,0,0,.03); }
    .ck.ck-editor.ck-focused { border-color: var(--green-500); box-shadow: 0 0 0 .2rem rgba(137,186,23,.20); }
    .ck.ck-editor .ck-toolbar { border: 0; background: #f8fafc; border-bottom: 1px solid var(--line); border-radius: 10px 10px 0 0; }
    .ck.ck-editor .ck-toolbar .ck-button { border-radius: 8px; }
    .ck.ck-editor .ck-content { border: 0; background: #fff; padding: 12px; border-radius: 0 0 10px 10px; }
    /* Comfort heights */
    textarea#title + .ck-editor .ck-content { min-height: 100px; }
    textarea#zielgruppe + .ck-editor .ck-content { min-height: 120px; }
    textarea#lernziel + .ck-editor .ck-content { min-height: 120px; }
    textarea#beschreibung + .ck-editor .ck-content { min-height: 160px; }
    textarea#licenseExtras + .ck-editor .ck-content { min-height: 120px; }

    /* Preview */
    .preview-wrap {
        position: sticky;
        top: 12px;
        align-self: start;
        height: fit-content;
    }

    .preview-toggle {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 8px;
        font-size: .9rem;
        border-radius: 999px;
    }

    .preview-shell {
        overflow: hidden;
        transition: max-height .28s ease, opacity .2s ease, transform .18s ease;
        will-change: max-height, opacity, transform;
    }

    .sb-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 6px 18px rgba(16,24,40,.06);
        display: grid;
        grid-template-rows: auto 1fr;
    }

    .sb-thumb {
        background: #f5f7fb;
        border-bottom: 1px solid #eef1f6;
        aspect-ratio: 16/9;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .sb-thumb img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
        }

    .sb-main {
        padding: 14px 16px 16px;
        display: grid;
        grid-template-rows: 32px 28px 1fr 52px;
        row-gap: 8px;
    }

    .sb-title {
        font-weight: 700;
        color: var(--ink);
        letter-spacing: .2px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        align-self: center;
    }

    .sb-chips {
        display: flex;
        gap: 8px;
        align-items: center;
        flex-wrap: wrap;
    }

    .sb-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 10px;
        border-radius: 999px;
        font-weight: 700;
        background: rgba(137,186,23,.12);
        color: var(--green-700);
        border: 1px solid rgba(137,186,23,.25);
        font-size: .9rem;
    }

        .sb-chip .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--green-500);
            display: inline-block;
            box-shadow: 0 0 0 2px rgba(137,186,23,.25);
        }

        .sb-chip.muted {
            background: rgba(137,186,23,.08);
            color: var(--green-700);
            border-color: rgba(137,186,23,.2);
        }

    /* Palette + Authors */
    .palette-list {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 6px;
    }

    .color-item {
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--bg-soft);
        border: 1px solid var(--line);
        padding: 6px 8px;
        border-radius: 10px;
    }

        .color-item input[type=color] {
            width: 34px;
            height: 34px;
            border: none;
            background: none;
            padding: 0;
            appearance: none;
            cursor: pointer;
            border-radius: 8px;
        }

        .color-item button {
            background: #fff;
            border: 1px solid #f2c9ce;
            color: #d9534f;
            border-radius: 8px;
            padding: 4px 6px;
            font-weight: 700;
            cursor: pointer;
        }

    .author-list {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 6px;
    }

    .author-item {
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--bg-soft);
        border: 1px solid var(--line);
        padding: 6px 8px;
        border-radius: 10px;
    }

        .author-item .rm {
            background: #fff;
            border: 1px solid #f2c9ce;
            color: #d9534f;
            border-radius: 8px;
            padding: 4px 6px;
            font-weight: 700;
            cursor: pointer;
        }

    /* Parent card that contains all accordions */
    .card-stack {
        padding: 0;
    }

        .card-stack .stack-inner {
            padding: 16px;
        }

        /* Space accordions inside the parent */
        .card-stack details.acc {
            margin-bottom: 12px;
        }

            .card-stack details.acc:last-of-type {
                margin-bottom: 0;
            }

    /* Global actions for the whole form */
    .form-actions {
        display: flex;
        gap: 10px;
        margin-top: 14px;
        padding-top: 12px;
        border-top: 1px solid var(--line);
    }

</style>

<div class="page-head">
    <h4>Neues Storyboard</h4>
    @if (isPublic)
    {
        <a href="@(basePath + "/s/my")" class="btn btn-secondary">Zur Übersicht</a>
    }
    else
    {
        <a asp-action="Index" class="btn btn-secondary">Zur Übersicht</a>
    }
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="edit-grid" novalidate>
    @Html.AntiForgeryToken()

    <!-- LEFT: accordions like Edit -->
    <!-- LEFT: accordions like Edit -->
    <div>
        <!-- Parent card that contains all sections -->
        <div class="card card-stack">
            <div class="stack-inner">

                <!-- Allgemeine Informationen -->
                <details class="acc" open>
                    <summary>
                        <span class="section-title">
                            <span class="acc-caret" aria-hidden="true"></span>
                            <i class="fas fa-info-circle"></i> Allgemeine Informationen<span class="text-danger">*</span>
                        </span>
                    </summary>
                    <div class="acc-body">
                        <div class="field">
                            <label for="title">Titel <span class="text-danger">*</span></label>
                            <textarea id="title" name="title" class="form-control" rows="2" required></textarea>
                        </div>

                        <div class="field">
                            <label for="zielgruppe">Zielgruppe (optional)</label>
                            <textarea id="zielgruppe" name="zielgruppe" class="form-control" rows="2"></textarea>
                        </div>

                        <div class="field">
                            <label for="lernziel">Lernziel (optional)</label>
                            <textarea id="lernziel" name="lernziel" class="form-control" rows="2"></textarea>
                        </div>

                        <div class="field">
                            <label for="taxonomie">Taxonomie (optional)</label>
                            <select id="taxonomie" name="taxonomie" class="form-control">
                                <option value="">— Keine —</option>
                                <option value="0">Erinnern</option>
                                <option value="1">Verstehen</option>
                                <option value="2">Anwenden</option>
                                <option value="3">Analysieren</option>
                                <option value="4">Bewerten</option>
                                <option value="5">Erschaffen</option>
                            </select>
                            <small class="text-muted">Auswahl umfasst automatisch alle vorherigen Stufen.</small>
                        </div>

                        <div class="field">
                            <label for="beschreibung">Beschreibung (optional)</label>
                            <textarea id="beschreibung" name="beschreibung" class="form-control" rows="3"></textarea>
                        </div>

                        <!-- Farbpalette -->
                        <div class="field">
                            <label>Farbpalette (optional)</label>
                            <input type="hidden" id="farbpalette" name="farbpalette" />
                            <div id="paletteList" class="palette-list"></div>
                            <div style="display:flex;gap:10px;margin-top:6px">
                                <button type="button" id="addColor" class="btn btn-outline">+ Farbe hinzufügen</button>
                                <small class="text-muted" style="align-self:center">Bis zu 8 Farben. Die Auswahl wird gespeichert.</small>
                            </div>
                        </div>
                    </div>
                </details>

                <!-- Rechte & Attribution -->
                <details class="acc">
                    <summary>
                        <span class="section-title">
                            <span class="acc-caret" aria-hidden="true"></span>
                            <i class="bi bi-c-circle"></i> Rechte &amp; Attribution <span class="text-danger">*</span>
                        </span>
                    </summary>
                    <div class="acc-body">
                        <div class="field">
                            <label for="license">Lizenz <span class="text-danger">*</span></label>
                            <select id="license" name="license" class="form-control" required>
                                <option value="">— Bitte auswählen —</option>
                                <option value="0">Attribution (CC BY)</option>
                                <option value="1">Attribution-ShareAlike (CC BY-SA)</option>
                                <option value="2">Public Domain Dedication (CC0)</option>
                                <option value="3">Copyright</option>
                                <option value="4">MIT</option>
                            </select>
                        </div>

                        <div class="field">
                            <label>Autor:innen</label>
                            <input type="hidden" id="authors" name="authors" />
                            <div style="display:flex; gap:8px; align-items:center; margin-bottom:6px;">
                                <input id="authorInput" class="form-control" placeholder="Name hinzufügen und Enter drücken" />
                                <button type="button" id="addAuthor" class="btn btn-outline">+ Hinzufügen</button>
                            </div>
                            <div id="authorList" class="author-list"></div>
                            <small class="text-muted">Mehrere Autor:innen werden gespeichert; Duplikate werden automatisch entfernt.</small>
                        </div>

                        <div class="field">
                            <label for="licenseExtras">Lizenz-Extras (optional)</label>
                            <textarea id="licenseExtras" name="licenseExtras" class="form-control" rows="2"
                                      placeholder="Zusätzliche Informationen zur Lizenz, Hinweise zur Attribution, Links ..."></textarea>
                        </div>
                    </div>
                </details>

                <!-- Cover-Bild für das Storyboard -->
                <details class="acc">
                    <summary>
                        <span class="section-title">
                            <span class="acc-caret" aria-hidden="true"></span>
                            <i class="fas fa-image"></i> Cover-Bild <span class="text-danger">*</span>
                        </span>
                    </summary>
                    <div class="acc-body">
                        <div class="field">
                            <label for="image">Cover-Bild <span class="text-danger">*</span></label>
                            <input id="image" name="image" type="file" class="form-control" accept=".png,.jpg,.jpeg,.webp,.gif" required />
                            <small class="text-muted">Dieses Bild wird als Vorschaubild für das gesamte Storyboard verwendet (z.B. in der Übersicht).</small>
                        </div>
                    </div>
                </details>

                <!-- Actions for the WHOLE form -->
                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">Anlegen</button>
                    @if (isPublic)
                    {
                        <a href="@(basePath + "/s/my")" class="btn btn-secondary" >Abbrechen</a>
                    }
                    else
                    {
                        <a asp-action="Index" class="btn btn-secondary">Abbrechen</a>
                    }
                </div>

            </div>
        </div>
    </div>


    @* RIGHT: preview (deactivated)
    <aside class="preview-wrap">
        <button type="button" id="previewToggle" class="btn btn-outline preview-toggle" aria-expanded="true">
            Vorschau ausblenden
        </button>
        <div id="previewShell" class="preview-shell">
            <div class="sb-card">
                <div class="sb-thumb">
                    <img id="previewImg" alt="Vorschau"
                         src="data:image/svg+xml;utf8,
                    <svg xmlns='http://www.w3.org/2000/svg' width='800' height='450'>
                        <rect width='100%%' height='100%%' fill='%23f0f3f9' />
                        <text x='50%%' y='50%%' text-anchor='middle' dominant-baseline='middle'
                              font-family='Segoe UI, Roboto, system-ui' font-size='28' fill='%238a94a7'>Vorschau</text>
                    </svg>">
                </div>
                <div class="sb-main">
                    <div class="sb-title" id="previewTitle">Neues Storyboard</div>
                    <div class="sb-chips">
                        <span class="sb-chip"><span class="dot"></span>Vorschau</span>
                        <span class="sb-chip muted">Erste Szene</span>
                    </div>
                    <div></div>
                    <div class="sb-footer">
                        <div class="swatches" id="swatches"></div>
                    </div>
                </div>
            </div>
        </div>
    </aside>
    *@
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.js"></script>
    <script>
        (function(){
          const $ = sel => document.querySelector(sel);
          // Animated accordion for details.acc
          const accordions = document.querySelectorAll('details.acc');
          accordions.forEach(d => {
            const body = d.querySelector('.acc-body');
            if (!body) return;
            // initialize state
            body.style.overflow = 'hidden';
            body.style.transition = 'height .28s ease, opacity .2s ease';
            if (d.open) {
              body.style.height = 'auto';
              body.style.opacity = '1';
            } else {
              body.style.height = '0px';
              body.style.opacity = '0';
            }

            d.addEventListener('toggle', () => {
              if (d.open) {
                // expand: 0 -> content height, then snap to auto after transition
                body.style.height = body.scrollHeight + 'px';
                body.style.opacity = '1';
              } else {
                // collapse: current height -> 0
                body.style.height = body.scrollHeight + 'px';
                requestAnimationFrame(() => {
                  body.style.height = '0px';
                  body.style.opacity = '0';
                });
              }
            });

            body.addEventListener('transitionend', (e) => {
              if (e.propertyName !== 'height') return;
              if (d.open) {
                // allow content to reflow naturally after opening
                body.style.height = 'auto';
              }
            });
          });

          const titleIn = $('#title');
          const imgIn   = $('#image');

          const previewTitle = $('#previewTitle');
          const previewImg   = $('#previewImg');

          // Foldable preview card
          (function initPreviewToggle(){
            const shell = document.getElementById('previewShell');
            const btn = document.getElementById('previewToggle');
            if (!shell || !btn) return;

            function setState(expanded){
              const content = shell.firstElementChild;
              if (!content) return;
              if (expanded){
                const h = content.getBoundingClientRect().height || content.scrollHeight || 0;
                shell.style.maxHeight = h + 'px';
                shell.style.opacity = '1';
                shell.style.transform = 'translateY(0)';
                btn.setAttribute('aria-expanded','true');
                btn.textContent = 'Vorschau ausblenden';
              } else {
                shell.style.maxHeight = '0px';
                shell.style.opacity = '0';
                shell.style.transform = 'translateY(-4px)';
                btn.setAttribute('aria-expanded','false');
                btn.textContent = 'Vorschau anzeigen';
              }
            }

            // initial: expanded
            requestAnimationFrame(() => setState(true));

            btn.addEventListener('click', () => {
              const expanded = btn.getAttribute('aria-expanded') === 'true';
              setState(!expanded);
            });
          })();

          // live title (fallback if CKEditor not yet attached)
          titleIn?.addEventListener('input', () => {
            if (previewTitle) {
              previewTitle.textContent = (titleIn.value || '').trim() || 'Neues Storyboard';
            }
          });

          // live image preview + size/type validation (no-op when preview is disabled)
          imgIn?.addEventListener('change', () => {
            const f = imgIn.files && imgIn.files[0];
            if (!f) return;

            // 30 MB size check
            const MAX_SIZE = 30 * 1024 * 1024; // 30 MB
            if (f.size > MAX_SIZE) {
              const msg = 'Das Bild ist zu groß. Maximal 30 MB pro Bild erlaubt.';
              if (window.SB && SB.alert) SB.alert(msg, 'error', 'Bild zu groß');
              else if (window.Swal) Swal.fire({ icon: 'error', title: 'Bild zu groß', text: msg });
              else alert(msg);
              imgIn.value = '';
              return;
            }

            if (!/\.(png|jpe?g|webp|gif)$/i.test(f.name)){
              if (window.SB && SB.alert) SB.alert('Nur PNG/JPG/WebP/GIF erlaubt.', 'error', 'Ungültige Datei');
              else alert('Nur PNG/JPG/WebP/GIF erlaubt.');
              imgIn.value='';
              return;
            }

            if (!previewImg) return;
            const r = new FileReader();
            r.onload = e => { previewImg.src = e.target.result; };
            r.readAsDataURL(f);
          });

          // palette editor -> hidden + preview swatches
          const maxColors = 8;
          const farbHidden = document.getElementById('farbpalette');
          const list = document.getElementById('paletteList');
          const addBtn = document.getElementById('addColor');
          const swatches = document.getElementById('swatches');

          let palette = [];
          if (farbHidden && farbHidden.value){
            palette = farbHidden.value.split(',').map(s => s.trim()).filter(Boolean)
                       .map(s => s.startsWith('#') ? s : ('#' + s));
          }

          function syncHidden(){ if (farbHidden) farbHidden.value = palette.join(','); renderPreviewSwatches(); }
          function renderPreviewSwatches(){
            if (!swatches) return;
            swatches.innerHTML = '';
            for (const c of palette){
              const d = document.createElement('div');
              d.className = 'swatch';
              d.title = c;
              d.style.background = c;
              swatches.appendChild(d);
            }
          }
          function renderPaletteEditor(){
            if (!list) return;
            list.innerHTML = '';
            palette.forEach((hex, idx) => {
              const wrap = document.createElement('div'); wrap.className='color-item';
              const inp = document.createElement('input'); inp.type='color';
              inp.value = /^#/.test(hex) ? hex : ('#' + hex);
              inp.addEventListener('input', () => { palette[idx] = inp.value.toLowerCase(); syncHidden(); });
              const del = document.createElement('button'); del.type='button'; del.textContent='Entfernen';
              del.addEventListener('click', () => { palette.splice(idx,1); renderPaletteEditor(); syncHidden(); });
              wrap.appendChild(inp); wrap.appendChild(del); list.appendChild(wrap);
            });
            syncHidden();
          }
          addBtn?.addEventListener('click', () => {
            if (palette.length >= maxColors) return;
            palette.push('#89ba17'); renderPaletteEditor();
          });
          renderPaletteEditor();

          // ---- Authors list ----
          const authorsHidden = document.getElementById('authors');
          const authorList    = document.getElementById('authorList');
          const addAuthorBtn  = document.getElementById('addAuthor');
          const authorInput   = document.getElementById('authorInput');

          let authors = [];
          if (authorsHidden && authorsHidden.value){
            authors = authorsHidden.value.split(',').map(s => s.trim()).filter(Boolean);
          }

          function syncAuthors(){ if (authorsHidden) authorsHidden.value = authors.join(', '); }
          function renderAuthors(){
            if (!authorList) return;
            authorList.innerHTML = '';
            authors.forEach((name, idx) => {
              const item = document.createElement('div'); item.className='author-item';
              const span = document.createElement('span'); span.textContent = name;
              const rm = document.createElement('button'); rm.type='button'; rm.className='rm'; rm.textContent='Entfernen';
              rm.addEventListener('click', () => { authors.splice(idx,1); renderAuthors(); syncAuthors(); });
              item.appendChild(span); item.appendChild(rm); authorList.appendChild(item);
            });
          }
          function addAuthor(){
            const n = (authorInput?.value || '').trim();
            if (!n) return;
            if (!authors.some(a => a.toLowerCase() === n.toLowerCase())) authors.push(n);
            if (authorInput) authorInput.value = '';
            renderAuthors(); syncAuthors();
          }
          addAuthorBtn?.addEventListener('click', addAuthor);
          authorInput?.addEventListener('keydown', (e)=>{ if (e.key === 'Enter'){ e.preventDefault(); addAuthor(); } });
          renderAuthors(); syncAuthors();

          // ---- Summernote for multiple fields ----
          const formEl = document.querySelector('form.edit-grid');
          const sm = {}; // id -> jQuery element
          const snToolbar = [
            ['style', ['bold','italic','underline','clear']],
            ['font', ['fontsize','color']],
            ['para', ['ul','ol','paragraph']],
            ['insert', ['picture','video','link']],
            ['view', ['codeview']]
          ];

          function initNoteById(id, onChange){
            const el = document.getElementById(id);
            if (!el || !window.jQuery) return;
            const $el = window.jQuery(el);
            try{
              $el.summernote({
                height: 150,
                placeholder: el.getAttribute('placeholder') || '',
                toolbar: snToolbar,
                callbacks: {
                  onChange: function(contents){ if (typeof onChange === 'function') onChange(contents); }
                }
              });
              sm[id] = $el;
              // initialize from existing textarea value
              if (el.value) $el.summernote('code', el.value);
            }catch(err){ console.warn('Summernote init failed', err); }
          }

          // Title -> update preview from editor as well (no-op when preview is disabled)
          initNoteById('title', (html) => {
            if (!previewTitle) return;
            const plain = String(html||'').replace(/<[^>]*>/g,'').trim();
            previewTitle.textContent = plain || 'Neues Storyboard';
          });
          initNoteById('zielgruppe');
          initNoteById('lernziel');
          initNoteById('beschreibung');
          initNoteById('licenseExtras');

          // On submit, sync all editor data back to their textareas
          formEl?.addEventListener('submit', (e) => {
            // sync editors back to fields
            Object.entries(sm).forEach(([id, $el]) => {
              const el = document.getElementById(id);
              if (el) el.value = $el.summernote('code');
            });
            // minimal custom required: title must not be empty
            const titleHtml = sm['title'] ? sm['title'].summernote('code') : (titleIn?.value||'');
            const titleText = String(titleHtml||'').replace(/<[^>]*>/g,'').trim();
            if (!titleText) {
              e.preventDefault();
              if (window.SB && SB.alert) SB.alert('Bitte gib einen Titel ein.', 'warning', 'Titel fehlt');
              else alert('Bitte gib einen Titel ein.');
              try { sm['title']?.summernote('focus'); } catch {}
            }
          });
        })();
    </script>
}

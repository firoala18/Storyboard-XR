@model IEnumerable<ProjectsWebApp.Models.Storyboard>
@{
    ViewData["Title"] = "Storyboards";
    ViewBag.FullWidth = true;
    var hasItems = Model != null && Model.Any();
    var isImpersonating = ViewBag.ImpersonatedEmail != null;
    var isPublicIndex = (bool?)ViewData["PublicIndex"] ?? false;
    var basePath = Context.Request.PathBase.HasValue ? Context.Request.PathBase.Value : "";
}

<style>
    :root {
        /* Green family */
        --green-400: #9fd62a;
        --green-500: #89ba17;
        --green-600: #77a514;
        --green-700: #6a9312;
        /* Red family */
        --red-500: #ef4444;
        --red-600: #dc2626;
        --red-700: #b91c1c;
        --white: #ffffff;
    }

    /* Base */
    body {
        background-color: #f9fafc;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        line-height: 1.5;
        color: #374151;
    }

    .Content-Body {
        margin-bottom: 7%;
    }

    /* Page header */
    .page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 28px;
        padding: 16px 0;
    }

        .page-head h1 {
            font-size: 2.4rem;
            font-weight: 700;
            color: #111827;
            margin: 0;
            letter-spacing: -0.025em;
        }

    /* Grid */
    .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px,1fr));
        gap: 28px;
    }

    /* Card */
    .sb-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        overflow: hidden;
        position: relative;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,.05), 0 2px 4px -1px rgba(0,0,0,.03);
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }

        .sb-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgba(0,0,0,.08), 0 10px 10px -5px rgba(0,0,0,.02);
            border-color: #d1d5db;
        }

    /* Thumbnail */
    .sb-thumb {
        background: linear-gradient(to bottom right, #f5f7fb, #f0f4ff);
        border-bottom: 1px solid #f0f2f7;
        aspect-ratio: 16/9;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

        .sb-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .3s ease;
        }

    .sb-card:hover .sb-thumb img {
        transform: scale(1.03);
    }

    /* Edit FAB (top-right) */
    .edit-fab {
        position: absolute;
        top: 10px;
        right: 10px;
        z-index: 2;
        box-shadow: 0 6px 14px rgba(0,0,0,.15);
    }

    /* Content */
    .sb-main {
        padding: 18px 20px 20px;
        display: grid;
        grid-template-rows: auto auto 1fr auto;
        row-gap: 12px;
    }

    .sb-title {
        font-weight: 600;
        font-size: 1.1rem;
        color: #111827;
        letter-spacing: -0.01em;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        margin: 0;
    }

    /* Allow rich HTML titles without breaking layout */
    .sb-title.richtext p,
    .sb-title.richtext h1,
    .sb-title.richtext h2,
    .sb-title.richtext h3,
    .sb-title.richtext h4,
    .sb-title.richtext h5,
    .sb-title.richtext h6 {
        display: inline;
        margin: 0;
        font: inherit;
        color: inherit;
    }
    .sb-title.richtext br { display: none; }

    /* Chips — now green palette */
    .sb-chips {
        display: flex;
        gap: 8px;
        align-items: center;
        flex-wrap: wrap;
    }

    .sb-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 999px;
        font-weight: 600;
        font-size: .85rem;
        background: rgba(137,186,23,.12); /* soft green background */
        color: var(--green-700);
        border: 1px solid rgba(137,186,23,.25); /* green border */
    }

        .sb-chip .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--green-500);
            display: inline-block;
            box-shadow: 0 0 0 2px rgba(137,186,23,.25);
        }

        .sb-chip.muted {
            background: rgba(137,186,23,.08);
            color: var(--green-700);
            border-color: rgba(137,186,23,.2);
        }

    /* Footer */
    .sb-footer {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
        padding-top: 8px;
        margin-top: 8px;
        border-top: 1px solid #f3f4f6;
    }

        .sb-footer form {
            margin-left: auto;
            display: inline-block;
        }

    /* CTA with text */
    .btn-primary {
        background: var(--green-500);
        border: 1px solid var(--green-600);
        color: var(--white);
        border-radius: 10px;
        padding: 10px 18px;
        font-weight: 600;
        text-decoration: none;
        transition: all .2s ease;
        box-shadow: 0 1px 2px rgba(0,0,0,.05);
        display: inline-flex;
        gap: 8px;
        align-items: center;
    }

        .btn-primary:hover {
            background: var(--green-600);
            transform: translateY(-1px);
            box-shadow: 0 4px 6px rgba(0,0,0,.05);
        }

    /* Equal-size icon buttons */
    .icon-btn {
        width: 42px;
        height: 42px;
        padding: 0;
        border-radius: 10px;
        display: inline-grid; /* <— grid centers better than flex for fonts */
        place-items: center; /* <— true center */
        font-weight: 600;
        text-decoration: none;
        transition: transform .2s, box-shadow .2s, background-color .2s, border-color .2s;
        line-height: 1;
    }

        .icon-btn i {
            font-size: 18px;
            line-height: 0; /* <— kill extra baseline space */
            display: block;
        }

            /* Thumb-tack needs a tiny nudge */
            .icon-btn i.fa-thumb-tack {
                transform: translateY(1px); /* adjust as 0–2px to taste */
            }

    /* Variants */
    .btn-green {
        background: var(--green-500);
        border: 1px solid var(--green-600);
        color: var(--white);
    }

        .btn-green:hover {
            background: var(--green-600);
            transform: translateY(-1px);
            box-shadow: 0 2px 4px rgba(16,24,40,.12);
        }

    .btn-red {
        background: var(--red-600);
        border: 1px solid var(--red-700);
        color: var(--white);
    }

        .btn-red:hover {
            background: var(--red-700);
            transform: translateY(-1px);
            box-shadow: 0 2px 4px rgba(16,24,40,.12);
        }

    /* Hero */
    .btn-hero {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 14px 26px;
        border-radius: 12px;
        background: var(--green-500);
        color: var(--white);
        border: 1px solid var(--green-600);
        font-weight: 700;
        text-decoration: none;
        font-size: 1.05rem;
        box-shadow: 0 10px 20px rgba(137,186,23,.25);
        transition: all .3s ease;
        position: relative;
        overflow: hidden;
    }

        .btn-hero:before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,.25), transparent);
            transition: all .6s ease;
        }

        .btn-hero:hover {
            background: var(--green-600);
            transform: translateY(-2px);
            box-shadow: 0 15px 30px rgba(137,186,23,.35);
        }

            .btn-hero:hover:before {
                left: 100%;
            }

        .btn-hero svg {
            width: 20px;
            height: 20px;
            color: currentColor;
            stroke: currentColor;
            fill: none;
        }

    /* Alert */
    .alert {
        border-radius: 12px;
        padding: 14px 20px;
        margin-bottom: 24px;
        border: 1px solid #fef3c7;
        background: #fffbeb;
        color: #92400e;
        font-size: .95rem;
    }

        .alert a {
            color: #b45309;
            text-decoration: underline;
            font-weight: 500;
        }

            .alert a:hover {
                color: #9333ea;
            }

    /* Responsive */
    @@media (max-width: 768px) {
        .page-head {
            flex-direction: column;
            align-items: flex-start;
            gap: 16px;
        }

        .cards-grid {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .sb-footer {
            flex-wrap: wrap;
        }

            .sb-footer form {
                margin-left: 0;
                width: 100%;
                order: 3;
            }

        .icon-btn.btn-red {
            width: 100%;
        }
    }
</style>

<div class="Content-Body">

    @if (ViewBag.ImpersonatedEmail != null)
    {
        <div class="alert" role="alert">
            Sie betrachten die Storyboards von <strong>@ViewBag.ImpersonatedEmail</strong>.
            <a asp-area="User" asp-controller="Storyboards" asp-action="Index" class="ms-2">Zurück zu meinen</a>
        </div>
    }

    @if (!hasItems)
    {
        <div class="page-head">
            <h1>Storyboards</h1>
            <span></span>
        </div>

        <div class="empty-wrap" style="min-height:60vh; display:flex; align-items:center; justify-content:center; text-align:center; border:2px dashed #e5e7eb; border-radius:20px; background:linear-gradient(to bottom, #fafbfd, #f6f8ff); margin:20px 0;">
            <div class="empty-inner" style="max-width:560px; padding:40px 30px;">
                <div class="empty-title" style="font-weight:700; font-size:2rem; margin-bottom:12px; color:#111827; letter-spacing:-0.025em;">Noch keine Storyboards vorhanden</div>
                <div class="empty-sub" style="color:#6b7280; margin-bottom:28px; font-size:1.05rem; line-height:1.6;">
                    Starte jetzt und lege dein erstes Storyboard an. Du kannst Szenen hinzufügen,
                    Bilder hochladen und Marker setzen – alles an einem Ort.
                </div>

                @if (!isImpersonating)
                {
                    <a class="btn-hero" asp-action="Create">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        Erstes Storyboard erstellen
                    </a>
                }
                else
                {
                    <div style="color:#9ca3af; font-size:.95rem; margin-top:16px;">
                        (Für diesen Benutzer sind aktuell keine Storyboards vorhanden.)
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="page-head">
            <h1>Storyboards</h1>
            @if (!isImpersonating)
            {
                <a class="btn-primary" asp-action="Create">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Neues Storyboard
                </a>
            }
        </div>

        <div class="cards-grid">
            @foreach (var sb in Model)
            {
                var cover = !string.IsNullOrWhiteSpace(sb.CoverImagePath)
                    ? (basePath + sb.CoverImagePath)
                    : (!string.IsNullOrWhiteSpace(sb.ImagePath)
                        ? (basePath + sb.ImagePath)
                        : (sb.Scenes?.OrderBy(s => s.Number).ThenBy(s => s.Id).FirstOrDefault()?.ImagePath != null
                            ? basePath + sb.Scenes.OrderBy(s => s.Number).ThenBy(s => s.Id).First().ImagePath
                            : basePath + "/img/placeholder.svg"));

                var sceneCount = sb.Scenes?.Count ?? 0;
                var sceneLabel = sceneCount == 1 ? "1 Szene" : $"{sceneCount} Szenen";
                var taxoLabel = sb.Taxonomie.HasValue
                ? ((ProjectsWebApp.Models.TaxonomieStufe)sb.Taxonomie.Value).ToString()
                : null;
                var plainTitle = System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(sb.Title ?? string.Empty, "<.*?>", string.Empty)).Trim();

                <div class="sb-card">
                    <!-- Edit FAB (gear) -->
                   @*  @if (isPublicIndex)
                    {
                        <a class="icon-btn btn-green edit-fab" href="@(basePath + "/s/" + sb.PublicId + "/edit")" title="Bearbeiten">
                            <i class="fa-regular fa-pen-to-square"></i>
                        </a>
                    }
                    else
                    {
                        <a class="icon-btn btn-green edit-fab" asp-area="User" asp-controller="Storyboards" asp-action="Edit" asp-route-id="@sb.Id" title="Bearbeiten">
                            <i class="fa-regular fa-pen-to-square"></i>
                        </a>
                    } *@

                    <div class="sb-thumb">
                        <img src="@cover"
                             alt="Vorschaubild von @plainTitle"
                             loading="lazy"
                             onerror="this.src='@(basePath + "/img/placeholder.svg")'">
                    </div>

                    <div class="sb-main">
                        <div class="sb-title richtext">@Html.Raw(sb.Title)</div>

                        <div class="sb-chips">
                            <span class="sb-chip"><span class="dot"></span>@sceneLabel</span>
                            @if (!string.IsNullOrEmpty(taxoLabel))
                            {
                                <span class="sb-chip muted">Taxonomie: @taxoLabel</span>
                            }
                        </div>

                        <div class="sb-footer">
                            @if (isPublicIndex)
                            {
                                <a class="icon-btn btn-green" href="@(basePath + "/s/" + sb.PublicId + "/open")" title="Marker platzieren">
                                    @*    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path d="M12 20h9" />
                                        <path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5z" />
                                    </svg> *@

                                    <i class="fa fa-thumb-tack"></i>
                                </a>

                                <a class="icon-btn btn-green" href="@(basePath + "/s/" + sb.PublicId)" title="Ansehen">
                                    <i class="bi bi-eye"></i>
                                </a>
                             
                                <form action="@(basePath + "/s/" + sb.PublicId + "/delete")" method="post"
                                      onsubmit="return confirm('Storyboard wirklich löschen?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="icon-btn btn-red" title="Löschen">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a class="icon-btn btn-green" asp-area="User" asp-controller="Storyboards" asp-action="Details" asp-route-id="@sb.Id" title="Marker platzieren">
                                    <i class="fa fa-thumb-tack"></i>
                                </a>
                                <a class="icon-btn btn-green" asp-area="User" asp-controller="Storyboards" asp-action="Viewer" asp-route-id="@sb.Id" title="Ansehen">
                                    <i class="bi bi-eye"></i>
                                </a>
                              
                                <form asp-area="User" asp-controller="Storyboards" asp-action="Delete" asp-route-id="@sb.Id" method="post"
                                      onsubmit="return confirm('Storyboard wirklich löschen?');">
                                    <button type="submit" class="icon-btn btn-red" title="Löschen">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>

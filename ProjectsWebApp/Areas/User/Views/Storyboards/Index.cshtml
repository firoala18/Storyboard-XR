@model IEnumerable<ProjectsWebApp.Models.Storyboard>
@{
    ViewData["Title"] = "Storyboards";
    ViewBag.FullWidth = true;
    var hasItems = Model != null && Model.Any();
    var isImpersonating = ViewBag.ImpersonatedEmail != null;
    var isPublicIndex = (bool?)ViewData["PublicIndex"] ?? false;
    var basePath = Context.Request.PathBase.HasValue ? Context.Request.PathBase.Value : "";
}

<style>
    :root {
        /* Red family */
        --red-500: #ef4444;
        --red-600: #dc2626;
        --red-700: #b91c1c;
        --white: #ffffff;
    }

    /* Base */
    body {
        background-color: #f7f9fc;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        line-height: 1.5;
        color: #374151;
    }

    .Content-Body {
        margin-bottom: 7%;
    }

    /* Page header */
    .page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 28px;
        padding: 16px 0;
    }

        .page-head h1 {
            font-size: 2.4rem;
            font-weight: 700;
            color: #0f172a;
            margin: 0;
            letter-spacing: -0.025em;
        }

    /* Grid */
    .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px,1fr));
        gap: 28px;
    }

    /* Card */
    .sb-card {
        background: #fff;
        border: 1px solid #eceff5;
        border-radius: 18px;
        overflow: hidden;
        position: relative;
        box-shadow: 0 1px 3px rgba(15,23,42,.05), 0 10px 24px -8px rgba(15,23,42,.08);
        transition: transform .28s cubic-bezier(.2,.8,.2,1), box-shadow .28s ease, border-color .28s ease;
    }

        .sb-card::before {
            content: '';
            position: absolute; top: 0; left: 0; right: 0; height: 3px;
            background: linear-gradient(90deg, transparent, var(--uni-green, #89ba17), transparent);
            opacity: 0; transition: opacity .28s ease;
            z-index: 3; pointer-events: none;
        }

        .sb-card:hover {
            transform: translateY(-6px);
            box-shadow:
                0 2px 4px rgba(15,23,42,.05),
                0 24px 40px -12px rgba(15,23,42,.15),
                0 0 0 1px rgba(137,186,23,.22);
            border-color: transparent;
        }
        .sb-card:hover::before { opacity: 1; }

    /* Thumbnail */
    .sb-thumb {
        background: linear-gradient(to bottom right, #f5f7fb, #eef2f9);
        aspect-ratio: 16/9;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

        .sb-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .5s cubic-bezier(.2,.8,.2,1);
        }

    .sb-card:hover .sb-thumb img {
        transform: scale(1.05);
    }

    /* Gradient fade at the bottom of the thumb for contrast with floating badges */
    .sb-thumb::after {
        content: '';
        position: absolute; inset: auto 0 0 0; height: 50%;
        background: linear-gradient(to top, rgba(15,23,42,.38), transparent);
        pointer-events: none;
        opacity: 0;
        transition: opacity .28s ease;
    }
    .sb-thumb.has-badges::after { opacity: 1; }

    /* Floating glass badges on the thumbnail */
    .sb-thumb-badges {
        position: absolute;
        left: 10px; bottom: 10px; right: 10px;
        display: flex; gap: 6px; flex-wrap: wrap;
        z-index: 2;
    }

    .sb-badge {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 5px 10px; border-radius: 999px;
        background: rgba(255,255,255,.9);
        border: 1px solid rgba(255,255,255,.6);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        color: #0f172a; font-weight: 600; font-size: .78rem;
        letter-spacing: .01em;
        box-shadow: 0 2px 8px rgba(15,23,42,.18);
    }
    .sb-badge .dot {
        width: 7px; height: 7px; border-radius: 50%;
        background: var(--uni-green, #89ba17);
        box-shadow: 0 0 0 2px rgba(137,186,23,.25);
    }
    .sb-badge.sb-badge-taxo {
        background: rgba(137,186,23,.92);
        border-color: rgba(255,255,255,.3);
        color: #fff;
    }

    /* Edit FAB (top-right) */
    .edit-fab {
        position: absolute;
        top: 10px;
        right: 10px;
        z-index: 2;
        box-shadow: 0 6px 14px rgba(0,0,0,.15);
    }

    /* Content */
    .sb-main {
        padding: 18px 20px 18px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .sb-title {
        font-weight: 700;
        font-size: 1.15rem;
        line-height: 1.35;
        color: #0f172a;
        letter-spacing: -0.015em;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: calc(1.35em * 2);
    }

    /* Allow rich HTML titles without breaking layout */
    .sb-title.richtext p,
    .sb-title.richtext h1,
    .sb-title.richtext h2,
    .sb-title.richtext h3,
    .sb-title.richtext h4,
    .sb-title.richtext h5,
    .sb-title.richtext h6 {
        display: inline;
        margin: 0;
        font: inherit;
        color: inherit;
    }
    .sb-title.richtext br { display: none; }

    .sb-subtitle {
        font-size: .88rem;
        color: #6b7280;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin: 0;
    }

    .sb-meta {
        display: flex; align-items: center; gap: 6px;
        font-size: .75rem; color: #94a3b8;
        letter-spacing: .01em;
    }
    .sb-meta .sb-meta-dot {
        width: 3px; height: 3px; border-radius: 50%; background: #cbd5e1;
    }

    /* Footer */
    .sb-footer {
        display: flex;
        gap: 8px;
        align-items: center;
        padding-top: 14px;
        margin-top: 4px;
        border-top: 1px solid #f1f5f9;
    }

        .sb-footer form {
            margin: 0;
            display: inline-block;
        }
        .sb-footer form:last-child {
            margin-left: auto;
        }

    /* CTA with text */
    .btn-primary {
        background: var(--uni-green);
        border: 1px solid var(--uni-green-600);
        color: var(--white);
        border-radius: 10px;
        padding: 10px 18px;
        font-weight: 600;
        text-decoration: none;
        transition: all .2s ease;
        box-shadow: 0 1px 2px rgba(0,0,0,.05);
        display: inline-flex;
        gap: 8px;
        align-items: center;
    }

        .btn-primary:hover {
            background: var(--uni-green-600);
            transform: translateY(-1px);
            box-shadow: 0 4px 6px rgba(0,0,0,.05);
        }

    /* Equal-size icon buttons */
    .icon-btn {
        width: 40px;
        height: 40px;
        padding: 0;
        border-radius: 10px;
        display: inline-grid;
        place-items: center;
        font-weight: 600;
        text-decoration: none;
        transition: transform .2s, box-shadow .2s, background-color .2s, border-color .2s, color .2s;
        line-height: 1;
    }

        .icon-btn i {
            font-size: 16px;
            line-height: 0;
            display: block;
        }

            .icon-btn i.fa-thumb-tack {
                transform: translateY(1px);
            }

    /* Subtle icon button variants (premium, understated) */
    .icon-btn.btn-green {
        background: var(--uni-green-50, #f3fae0);
        border: 1px solid rgba(137,186,23,.25);
        color: var(--uni-green-700, #5a7f0f);
    }
        .icon-btn.btn-green:hover {
            background: var(--uni-green);
            border-color: var(--uni-green-600);
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 6px 14px -4px rgba(137,186,23,.45);
        }

    .icon-btn.btn-red {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
    }
        .icon-btn.btn-red:hover {
            background: var(--red-600);
            border-color: var(--red-700);
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 6px 14px -4px rgba(220,38,38,.4);
        }


    /* Hero */
    .btn-hero {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 14px 26px;
        border-radius: 12px;
        background: var(--uni-green);
        color: var(--white);
        border: 1px solid var(--uni-green-600);
        font-weight: 700;
        text-decoration: none;
        font-size: 1.05rem;
        box-shadow: 0 10px 20px rgba(137,186,23,.25);
        transition: all .3s ease;
        position: relative;
        overflow: hidden;
    }

        .btn-hero:before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,.25), transparent);
            transition: all .6s ease;
        }

        .btn-hero:hover {
            background: var(--uni-green-600);
            transform: translateY(-2px);
            box-shadow: 0 15px 30px rgba(137,186,23,.35);
        }

            .btn-hero:hover:before {
                left: 100%;
            }

        .btn-hero svg {
            width: 20px;
            height: 20px;
            color: currentColor;
            stroke: currentColor;
            fill: none;
        }

    /* Alert */
    .alert {
        border-radius: 12px;
        padding: 14px 20px;
        margin-bottom: 24px;
        border: 1px solid #fef3c7;
        background: #fffbeb;
        color: #92400e;
        font-size: .95rem;
    }

        .alert a {
            color: #b45309;
            text-decoration: underline;
            font-weight: 500;
        }

            .alert a:hover {
                color: #9333ea;
            }

    /* Responsive */
    @@media (max-width: 768px) {
        .page-head {
            flex-direction: column;
            align-items: flex-start;
            gap: 16px;
        }

        .cards-grid {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .sb-footer {
            flex-wrap: wrap;
        }

            .sb-footer form {
                margin-left: 0;
                width: 100%;
                order: 3;
            }

        .icon-btn.btn-red {
            width: 100%;
        }
    }
</style>

<div class="Content-Body">

    @if (ViewBag.ImpersonatedEmail != null)
    {
        <div class="alert" role="alert">
            Sie betrachten die Storyboards von <strong>@ViewBag.ImpersonatedEmail</strong>.
            <a asp-area="User" asp-controller="Storyboards" asp-action="Index" class="ms-2">Zurück zu meinen</a>
        </div>
    }

    @if (!hasItems)
    {
        <div class="page-head">
            <h1>Storyboards</h1>
            <span></span>
        </div>

        <div class="empty-wrap" style="min-height:60vh; display:flex; align-items:center; justify-content:center; text-align:center; border:2px dashed #e5e7eb; border-radius:20px; background:linear-gradient(to bottom, #fafbfd, #f6f8ff); margin:20px 0;">
            <div class="empty-inner" style="max-width:560px; padding:40px 30px;">
                <div class="empty-title" style="font-weight:700; font-size:2rem; margin-bottom:12px; color:#111827; letter-spacing:-0.025em;">Noch keine Storyboards vorhanden</div>
                <div class="empty-sub" style="color:#6b7280; margin-bottom:28px; font-size:1.05rem; line-height:1.6;">
                    Starte jetzt und lege dein erstes Storyboard an. Du kannst Szenen hinzufügen,
                    Bilder hochladen und Marker setzen – alles an einem Ort.
                </div>

                @if (!isImpersonating)
                {
                    <button type="button" class="btn-hero" data-action="new-draft">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        Erstes Storyboard erstellen
                    </button>
                }
                else
                {
                    <div style="color:#9ca3af; font-size:.95rem; margin-top:16px;">
                        (Für diesen Benutzer sind aktuell keine Storyboards vorhanden.)
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="page-head">
            <h1>Storyboards</h1>
            @if (!isImpersonating)
            {
                <button type="button" class="btn-primary" data-action="new-draft">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Neues Storyboard
                </button>
            }
        </div>

        <div class="cards-grid">
            @foreach (var sb in Model)
            {
                var cover = !string.IsNullOrWhiteSpace(sb.CoverImagePath)
                    ? (basePath + sb.CoverImagePath)
                    : (!string.IsNullOrWhiteSpace(sb.ImagePath)
                        ? (basePath + sb.ImagePath)
                        : (sb.Scenes?.OrderBy(s => s.Number).ThenBy(s => s.Id).FirstOrDefault()?.ImagePath != null
                            ? basePath + sb.Scenes.OrderBy(s => s.Number).ThenBy(s => s.Id).First().ImagePath
                            : basePath + "/img/placeholder.svg"));

                var sceneCount = sb.Scenes?.Count ?? 0;
                var sceneLabel = sceneCount == 1 ? "1 Szene" : $"{sceneCount} Szenen";
                var taxoLabel = sb.Taxonomie.HasValue
                ? ((ProjectsWebApp.Models.TaxonomieStufe)sb.Taxonomie.Value).ToString()
                : null;
                var plainTitle = System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(sb.Title ?? string.Empty, "<.*?>", string.Empty)).Trim();
                var plainDesc = System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(sb.Beschreibung ?? string.Empty, "<.*?>", string.Empty)).Trim();

                string relativeDate(DateTime dt)
                {
                    var diff = DateTime.UtcNow - dt;
                    if (diff.TotalMinutes < 1) return "gerade eben";
                    if (diff.TotalMinutes < 60) return $"vor {(int)diff.TotalMinutes} Min.";
                    if (diff.TotalHours < 24) return $"vor {(int)diff.TotalHours} Std.";
                    if (diff.TotalDays < 7) return $"vor {(int)diff.TotalDays} Tag{(diff.TotalDays < 2 ? "" : "en")}";
                    if (diff.TotalDays < 30) return $"vor {(int)(diff.TotalDays / 7)} Wochen";
                    if (diff.TotalDays < 365) return $"vor {(int)(diff.TotalDays / 30)} Monaten";
                    return $"vor {(int)(diff.TotalDays / 365)} Jahren";
                }
                var updatedLabel = relativeDate(sb.LastSeenAt);

                <div class="sb-card">
                    <!-- Edit FAB (gear) -->
                   @*  @if (isPublicIndex)
                    {
                        <a class="icon-btn btn-green edit-fab" href="@(basePath + "/s/" + sb.PublicId + "/edit")" title="Bearbeiten">
                            <i class="fa-regular fa-pen-to-square"></i>
                        </a>
                    }
                    else
                    {
                        <a class="icon-btn btn-green edit-fab" asp-area="User" asp-controller="Storyboards" asp-action="Edit" asp-route-id="@sb.Id" title="Bearbeiten">
                            <i class="fa-regular fa-pen-to-square"></i>
                        </a>
                    } *@

                    <div class="sb-thumb has-badges">
                        <img src="@cover"
                             alt="Vorschaubild von @plainTitle"
                             loading="lazy"
                             onerror="this.src='@(basePath + "/img/placeholder.svg")'">
                        <div class="sb-thumb-badges">
                            <span class="sb-badge"><span class="dot"></span>@sceneLabel</span>
                            @if (!string.IsNullOrEmpty(taxoLabel))
                            {
                                <span class="sb-badge sb-badge-taxo">@taxoLabel</span>
                            }
                        </div>
                    </div>

                    <div class="sb-main">
                        <div class="sb-title richtext">@Html.Raw(sb.Title)</div>

                        @if (!string.IsNullOrWhiteSpace(plainDesc))
                        {
                            <p class="sb-subtitle">@plainDesc</p>
                        }

                        <div class="sb-meta">
                            <i class="bi bi-clock-history" aria-hidden="true"></i>
                            <span>Zuletzt geöffnet @updatedLabel</span>
                        </div>

                        <div class="sb-footer">
                            @if (isPublicIndex)
                            {
                                <a class="icon-btn btn-green" href="@(basePath + "/s/" + sb.PublicId + "/open")" title="Marker platzieren" aria-label="Marker platzieren">
                                    <i class="fa fa-thumb-tack"></i>
                                </a>
                                <a class="icon-btn btn-green" href="@(basePath + "/s/" + sb.PublicId)" title="Ansehen" aria-label="Ansehen">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <form action="@(basePath + "/s/" + sb.PublicId + "/delete")" method="post"
                                      onsubmit="return confirm('Storyboard wirklich löschen?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="icon-btn btn-red" title="Löschen" aria-label="Löschen">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a class="icon-btn btn-green" asp-area="User" asp-controller="Storyboards" asp-action="Builder" asp-route-id="@sb.Id" asp-route-step="2" title="Marker platzieren" aria-label="Marker platzieren">
                                    <i class="fa fa-thumb-tack"></i>
                                </a>
                                <a class="icon-btn btn-green" asp-area="User" asp-controller="Storyboards" asp-action="Viewer" asp-route-id="@sb.Id" title="Ansehen" aria-label="Ansehen">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <form asp-area="User" asp-controller="Storyboards" asp-action="Delete" asp-route-id="@sb.Id" method="post"
                                      onsubmit="return confirm('Storyboard wirklich löschen?');">
                                    <button type="submit" class="icon-btn btn-red" title="Löschen" aria-label="Löschen">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>

@Html.AntiForgeryToken()

<script>
(function(){
    document.querySelectorAll('[data-action="new-draft"]').forEach(b => b.addEventListener('click', async () => {
        const tok = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const headers = tok ? { 'RequestVerificationToken': tok } : {};
        try {
            const res = await fetch('@Url.Action("NewDraft", "Storyboards", new { area = "User" })', {
                method: 'POST',
                headers
            });
            if (!res.ok) { alert('Konnte kein neues Storyboard anlegen.'); return; }
            const data = await res.json();
            const builderUrl = '@Url.Action("Builder", "Storyboards", new { area = "User" })';
            window.location.href = builderUrl + '/' + data.id + '?step=1';
        } catch (err) {
            alert('Netzwerkfehler beim Anlegen: ' + (err?.message || err));
        }
    }));
})();
</script>

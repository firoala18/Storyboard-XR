@{
    ViewData["Title"] = "Anmeldung erforderlich";
    var returnUrl = ViewBag.ReturnUrl as string ?? "/";
    var loginUrl = Url.Page("/Account/Login", new { area = "Identity", returnUrl });
}

<div class="login-required-shell">
    <div class="login-required-card">
        <div class="login-required-icon">🔒</div>
        <h2>Anmeldung erforderlich</h2>
        <p>
            Dieses Storyboard wurde von einem angemeldeten Nutzer geteilt.
            Um den Inhalt zu sehen oder gemeinsam zu bearbeiten, melden Sie sich bitte an.
        </p>
        <a class="btn-primary-green" href="@loginUrl">Zur Anmeldung</a>
    </div>
</div>

<style>
    .login-required-shell {
        min-height: 70vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 24px;
    }
    .login-required-card {
        max-width: 440px;
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 15px 40px rgba(0,0,0,.08);
        padding: 40px 36px;
        text-align: center;
        font-family: system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    }
    .login-required-icon {
        font-size: 44px;
        margin-bottom: 12px;
    }
    .login-required-card h2 {
        font-weight: 700;
        margin: 0 0 14px;
    }
    .login-required-card p {
        color: #475569;
        line-height: 1.5;
        margin: 0 0 24px;
    }
    .login-required-card .btn-primary-green {
        display: inline-block;
        background: #90bc14;
        color: #fff;
        border: 0;
        border-radius: 12px;
        padding: 12px 28px;
        font-weight: 600;
        text-decoration: none;
    }
    .login-required-card .btn-primary-green:hover {
        background: #7ea810;
    }
</style>

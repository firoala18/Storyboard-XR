          // Prev/Next scenes
          btnPrev?.addEventListener('click', () => { const ids = sceneIds(); const i = ids.indexOf(currentSceneId); if (i>0) loadScene(ids[i-1]); });
          btnNext?.addEventListener('click', () => { const ids = sceneIds(); const i = ids.indexOf(currentSceneId); if (i>=0 && i<ids.length-1) loadScene(ids[i+1]); });
          document.addEventListener('keydown', (e) => {
            if (['INPUT','TEXTAREA'].includes(e.target.tagName)) return;
            if (e.key === 'ArrowLeft') btnPrev?.click();
            if (e.key === 'ArrowRight') btnNext?.click();
            if (e.key === '+') btnIn?.click();
            if (e.key === '-') btnOut?.click();

@section Scripts {
    <!-- PDF libs (no SRI; correct order) -->
    <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jspdf-autotable@3.8.2/dist/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>

    <script>
        // ---- Color & Styling Roles (derived from Farbpalette) ----
        (function applyRoleColors(){
          const container = document.querySelector('.viewer-stack');
          if (!container) return;

          const raw = (container.dataset.palette || '').split(',').map(s => s.trim()).filter(Boolean);
          if (!raw.length) return; // keep defaults

          const primary = raw[0].startsWith('#') ? raw[0] : ('#' + raw[0]);

          function hexToRgb(h){
            const x = h.replace('#','');
            const v = x.length===3 ? x.split('').map(c=>c+c).join('') : x;
            const r=parseInt(v.slice(0,2),16), g=parseInt(v.slice(2,4),16), b=parseInt(v.slice(4,6),16);
            return [r,g,b];
          }
          function rgbToHsl(r,g,b){
            r/=255; g/=255; b/=255;
            const max=Math.max(r,g,b), min=Math.min(r,g,b);
            let h,s,l=(max+min)/2;
            if(max===min){ h=s=0; } else {
              const d=max-min;
              s = l>0.5 ? d/(2-max-min) : d/(max+min);
              switch(max){
                case r: h=(g-b)/d + (g<b?6:0); break;
                case g: h=(b-r)/d + 2; break;
                case b: h=(r-g)/d + 4; break;
              }
              h/=6;
            }
            return [h,s,l];
          }
          function hslToHex(h,s,l){
            function f(n){
              const k=(n+h*12)%12, a=s*Math.min(l,1-l);
              const c=l - a*Math.max(-1, Math.min(k-3, Math.min(9-k,1)));
              return Math.round(255*c).toString(16).padStart(2,'0');
            }
            return '#' + f(0) + f(8) + f(4);
          }
          function withL(hx, lMul){
            const [r,g,b]=hexToRgb(hx); const [h,s,l]=rgbToHsl(r,g,b);
            const l2 = Math.max(0, Math.min(1, l*lMul));
            return hslToHex(h,s,l2);
          }

          // Generate simple shade ramp around the provided color
          const c500 = primary;
          const c400 = withL(c500, 1.10);
          const c600 = withL(c500, 0.90);
          const c700 = withL(c500, 0.78);

          const root = document.documentElement.style;
          root.setProperty('--role-primary-400', c400);
          root.setProperty('--role-primary-500', c500);
          root.setProperty('--role-primary-600', c600);
          root.setProperty('--role-primary-700', c700);

          // dependent tokens
          const chipBg = 'color-mix(in srgb, var(--role-primary-500) 12%, #ffffff)';
          const chipBd = 'color-mix(in srgb, var(--role-primary-500) 25%, #ffffff)';
          const chipMutedBg = 'color-mix(in srgb, var(--role-primary-500) 8%, #ffffff)';
          const chipMutedBd = 'color-mix(in srgb, var(--role-primary-500) 20%, #ffffff)';
          root.setProperty('--role-chip-bg', chipBg);
          root.setProperty('--role-chip-border', chipBd);
          root.setProperty('--role-chip-muted-bg', chipMutedBg);
          root.setProperty('--role-chip-muted-border', chipMutedBd);
        })();
    </script>

    <script>
        (() => {
          const PATH_BASE = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(basePath));
          const API = { list: sceneId => fetch(`${PATH_BASE}/api/scenes/${sceneId}/markers`).then(r=>r.ok?r.json():[]) };
          const TAXO_NAMES = ['Erinnern','Verstehen','Anwenden','Analysieren','Bewerten','Erschaffen'];
          const MAX_TAXO = @Html.Raw((Model.Taxonomie.HasValue ? ((int)Model.Taxonomie.Value).ToString() : "-1"));
          const taxoName = (v) => (typeof v === 'number' && v>=0 && v<TAXO_NAMES.length) ? TAXO_NAMES[v] : '';
          const taxoChain = (v) => {
            const n = (typeof v === 'number' && v>=0) ? v : (MAX_TAXO>=0?MAX_TAXO:null);
            return (n==null) ? '' : TAXO_NAMES.slice(0, Math.min(n+1, TAXO_NAMES.length)).join(', ');
          };

          // Elements
          const q = s => document.querySelector(s), qa = s => Array.from(document.querySelectorAll(s));
          const viewport = q('#viewport'), zoomWrap = q('#zoomWrap'), board = q('#board'),
                img = q('#sceneImg'), overlay = q('#overlay'), markerList = q('#markerList');
          const scenePanel = q('#scenePanel');
          const scenePanelHeader = q('#scenePanelHeader');
          const panelFloatToggle = q('#panelFloatToggle');
          const panelResizer = q('#panelResizer');
          const container = q('.viewer-stack'); const sbId = parseInt(container?.dataset.sbId || '0',10);
          let currentSceneId = parseInt(container?.dataset.activeSceneId || '0',10);

          const zoomLabel = q('#zoomLabel'), btnIn = q('#zoomIn'), btnOut = q('#zoomOut'),
                btnFit = q('#fitBtn'), btnAct = q('#actualBtn'), btnPdf = q('#printBtn'),
                btnFs = q('#fsBtn'), btnPrev = q('#prevScene'), btnNext = q('#nextScene'),
                btnToggle = q('#toggleMarkers');
          const statusCount = q('#statusCount'), imgMeta = q('#imgMeta');
          const searchBox = q('#searchBox'), clearSearch = q('#clearSearch'),
                toggleLD = q('#toggleListDetails'), selInfo = q('#selInfo');

          // Meta for PDF
          const meta = {
            title: container?.dataset.title || '',
            zg: container?.dataset.zg || '',
            lz: container?.dataset.lz || '',
            desc: container?.dataset.desc || '',
            taxo: container?.dataset.taxo || '',
            license: container?.dataset.license || '',
            authors: (container?.dataset.authors || '').split(',').map(x => x.trim()).filter(Boolean),
            lextras: container?.dataset.lextras || '',
            palette: (container?.dataset.palette || '').split(',').map(x => x.trim()).filter(Boolean)
          };

          // State
          let scale = 1, markers = [], selectedId = null, markersVisible = true, lastPinnedPop = null;
          let panelFloating = false;
          let dragState = null;
          let resizeState = null;
          let floatingWidth = null;

          function clampPanelPosition(left, top){
            if (!scenePanel) return;
            const rect = scenePanel.getBoundingClientRect();
            const vw = window.innerWidth || document.documentElement.clientWidth || rect.width;
            const vh = window.innerHeight || document.documentElement.clientHeight || rect.height;
            const maxLeft = vw - rect.width - 8;
            const maxTop  = vh - rect.height - 8;
            const safeLeft = Math.max(8, Math.min(maxLeft, left));
            const safeTop  = Math.max(8, Math.min(maxTop, top));
            scenePanel.style.left = safeLeft + 'px';
            scenePanel.style.top  = safeTop + 'px';
          }

          // Floating Szenen panel
          function setPanelFloating(on, options){
            if (!scenePanel) return;
            const opts = options || {};
            panelFloating = !!on;
            scenePanel.classList.toggle('floating', panelFloating);
            if (panelFloatToggle){
              panelFloatToggle.setAttribute('aria-pressed', panelFloating ? 'true' : 'false');
              panelFloatToggle.title = panelFloating
                ? 'Panel wieder andocken'
                : 'Panel lösen und verschieben';
            }
            if (!panelFloating){
              scenePanel.style.left = '';
              scenePanel.style.top = '';
              scenePanel.style.width = '';
              return;
            }
            const rect = scenePanel.getBoundingClientRect();
            const vw = window.innerWidth || document.documentElement.clientWidth || rect.width;
            const vh = window.innerHeight || document.documentElement.clientHeight || rect.height;

            // Determine width to use in floating mode: reuse previous floatingWidth if present,
            // otherwise start from the current rendered width in the layout.
            if (floatingWidth == null){
              floatingWidth = rect.width;
            }
            scenePanel.style.width = floatingWidth + 'px';
            let baseLeft;
            let baseTop;
            if (opts.anchor === 'current') {
              // keep visual position when switching from docked to floating
              baseLeft = rect.left;
              baseTop = rect.top;
            } else {
              baseLeft = vw - rect.width - 24; // anchor near right edge
              baseTop = rect.top;              // keep roughly same vertical origin
            }
            clampPanelPosition(baseLeft, baseTop);
          }

          panelFloatToggle?.addEventListener('click', () => {
            setPanelFloating(!panelFloating);
          });

          scenePanelHeader?.addEventListener('pointerdown', (e) => {
            if (!scenePanel) return;
            if (panelFloatToggle && panelFloatToggle.contains(e.target)) return;
            if (!panelFloating) {
              setPanelFloating(true, { anchor: 'current' });
            }
            dragState = dragState || {};
            const rect = scenePanel.getBoundingClientRect();
            dragState.offsetX = e.clientX - rect.left;
            dragState.offsetY = e.clientY - rect.top;
            dragState.pointerId = e.pointerId;
            scenePanelHeader.setPointerCapture(e.pointerId);
            scenePanel.classList.add('dragging');
            e.preventDefault();
          });

          scenePanelHeader?.addEventListener('pointermove', (e) => {
            if (!panelFloating || !scenePanel || !dragState || dragState.pointerId !== e.pointerId) return;
            const rawLeft = e.clientX - dragState.offsetX;
            const rawTop  = e.clientY - dragState.offsetY;
            clampPanelPosition(rawLeft, rawTop);
            e.preventDefault();
          });

          scenePanelHeader?.addEventListener('pointerup', (e) => {
            if (!dragState || dragState.pointerId !== e.pointerId) return;
            try { scenePanelHeader.releasePointerCapture(e.pointerId); } catch {}
            dragState = null;
            scenePanel?.classList.remove('dragging');
          });

          // Resize (width) of floating panel
          panelResizer?.addEventListener('pointerdown', (e) => {
            if (!panelFloating || !scenePanel) return;
            resizeState = {
              pointerId: e.pointerId,
              startX: e.clientX,
              startWidth: scenePanel.offsetWidth || scenePanel.getBoundingClientRect().width
            };
            panelResizer.setPointerCapture(e.pointerId);
            e.preventDefault();
          });

          panelResizer?.addEventListener('pointermove', (e) => {
            if (!resizeState || resizeState.pointerId !== e.pointerId || !scenePanel) return;
            const deltaX = e.clientX - resizeState.startX;
            const vw = window.innerWidth || document.documentElement.clientWidth || resizeState.startWidth;
            const minWidth = 260;
            const maxWidth = Math.min(700, vw - 32);
            let newWidth = resizeState.startWidth + deltaX;
            newWidth = Math.max(minWidth, Math.min(maxWidth, newWidth));
            floatingWidth = newWidth;
            scenePanel.style.width = newWidth + 'px';

            // Ensure we still stay inside the viewport horizontally after resize
            const rect = scenePanel.getBoundingClientRect();
            clampPanelPosition(rect.left, rect.top);
            e.preventDefault();
          });

          function endResize(e){
            if (!resizeState || (e && resizeState.pointerId !== e.pointerId)) return;
            try { panelResizer.releasePointerCapture(resizeState.pointerId); } catch {}
            resizeState = null;
          }

          panelResizer?.addEventListener('pointerup', endResize);
          panelResizer?.addEventListener('pointercancel', endResize);

          window.addEventListener('resize', () => {
            if (!panelFloating || !scenePanel) return;
            const rect = scenePanel.getBoundingClientRect();
            const currentLeft = parseFloat(scenePanel.style.left || rect.left) || rect.left;
            const currentTop  = parseFloat(scenePanel.style.top || rect.top) || rect.top;
            clampPanelPosition(currentLeft, currentTop);
          });

          // Helpers
          function setScale(v){ scale = Math.max(.25, Math.min(4, v)); zoomWrap.style.transform = `scale(${scale})`; zoomLabel.textContent = Math.round(scale*100)+'%'; }
          function fitToViewport(){ setScale(1); viewport.scrollTo({top:0,left:0}); }
          function sceneIds(){ return qa('.scene-item').map(x => parseInt(x.dataset.sceneId)).filter(n=>!Number.isNaN(n)); }
          function escapeHtml(s){ return String(s ?? '').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
          const px = n => `${n}px`, toP = n => Math.round(n*1000)/10+'%';

          // Normalize API payload
          const N = m => ({
            id: m.id ?? m.Id,
            x: m.x ?? m.X,
            y: m.y ?? m.Y,
            number: m.number ?? m.Number ?? 0,
            colorHex: m.colorHex ?? m.ColorHex ?? '#4a86e8',
            description: m.description ?? m.Description ?? '',
            ziel: m.ziel ?? m.Ziel ?? '',
            datenablage: m.datenablage ?? m.Datenablage ?? '',
            quellen: m.quellen ?? m.Quellen ?? '',
            promptIdee: m.promptIdee ?? m.PromptIdee ?? '',
            reflexion: m.reflexion ?? m.Reflexion ?? '',
            model: m.model ?? m.Model ?? '',
            sceneId: m.sceneId ?? m.SceneId,
            taxonomie: m.taxonomie ?? m.Taxonomie ?? null
          });

          // Overlay + markers
          function renderOverlay(){
            overlay.innerHTML = '';
            if (!markersVisible) return;

            const iw = img.clientWidth, ih = img.clientHeight;
            if(!iw || !ih) return;

            markers.forEach(m => {
              const wrap = document.createElement('div');
              wrap.className = 'dot-wrap';
              wrap.style.left = px(m.x*iw);
              wrap.style.top  = px(m.y*ih);
              wrap.dataset.id = m.id;

              const dot   = document.createElement('span'); dot.className = 'marker-dot'; dot.style.setProperty('--c', m.colorHex);
              const badge = document.createElement('span'); badge.className = 'num-badge'; badge.textContent = m.number; badge.style.background = m.colorHex || 'var(--role-primary-600)';

              const pop = document.createElement('div'); pop.className = 'pop';
              wrap.appendChild(dot); wrap.appendChild(badge); wrap.appendChild(pop);
              overlay.appendChild(wrap);

              wrap.addEventListener('click', e => {
                e.stopPropagation();
                selectMarker(m.id, {center:true, ripple:true, pinPopover:true});
              });
            });
          }

                function markerSummary(m){
          const firstRaw = [m.ziel, m.model, m.description].find(v => (v||'').trim().length>0) || '—';
          const plain = htmlToText(firstRaw);
          const s = plain.length > 160 ? plain.slice(0,160) + '…' : plain;
          return s;
        }

        function renderList(){
          const qv = (searchBox?.value || '').toLowerCase().trim();
          markerList.innerHTML = '';

          const list = markers
            .slice()
            .sort((a,b)=> a.number - b.number || a.id - b.id)
            .filter(m => {
              if (!qv) return true;
              const blob = [m.number, m.ziel, m.model, m.description, m.datenablage, m.promptIdee, m.reflexion]
                .join(' ')
                .toLowerCase();
              return blob.includes(qv);
            });

          statusCount.textContent = `${markers.length} Marker`;

          list.forEach(m => {
            const card = document.createElement('div');
            card.className = 'mcard';
            card.dataset.id = m.id;

            // header
            const head = document.createElement('div');
            head.className = 'mhead';
            const badge = document.createElement('span');
            badge.className = 'mbadge';
            badge.style.background = m.colorHex;

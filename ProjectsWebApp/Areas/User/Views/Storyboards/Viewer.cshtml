          // Zoom & controls
          function toggleMarkers(){ markersVisible = !markersVisible; btnToggle.classList.toggle('active', markersVisible); renderOverlay(); }
          btnIn?.addEventListener('click', ()=> setScale(scale*1.2));
          btnOut?.addEventListener('click', ()=> setScale(scale/1.2));
          btnFit?.addEventListener('click', fitToViewport);
          btnAct?.addEventListener('click', ()=> setScale(1));
          btnFs?.addEventListener('click', ()=> { if (!document.fullscreenElement) document.documentElement.requestFullscreen?.(); else document.exitFullscreen?.(); });
          btnToggle?.addEventListener('click', toggleMarkers);


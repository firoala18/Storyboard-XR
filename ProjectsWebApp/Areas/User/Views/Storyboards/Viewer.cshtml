@model ProjectsWebApp.Models.Storyboard
@using ProjectsWebApp.Models
@{
    ViewData["Title"] = "Storyboard ansehen";
    ViewBag.FullWidth = true;
    var coverPath = !string.IsNullOrWhiteSpace(Model.CoverImagePath) ? Model.CoverImagePath : Model.ImagePath;
    var scenes = (Model.Scenes ?? new List<Scene>())
        .Where(s => string.IsNullOrWhiteSpace(coverPath) || !string.Equals(s.ImagePath, coverPath, StringComparison.OrdinalIgnoreCase))
        .OrderBy(s => s.Number)
        .ThenBy(s => s.Id)
        .ToList();

    var activeId = (int?)ViewBag.ActiveSceneId ?? (scenes.FirstOrDefault()?.Id ?? 0);
    var activeScene = scenes.FirstOrDefault(s => s.Id == activeId) ?? scenes.FirstOrDefault();

    var basePath = Context.Request.PathBase.HasValue ? Context.Request.PathBase.Value : "";
    var publicSlug = ViewData["PublicSlug"] as string;

    string PlaceholderSvg(string text) =>
        "data:image/svg+xml;utf8," +
        $"<svg xmlns='http://www.w3.org/2000/svg' width='1200' height='675'><rect width='100%25' height='100%25' fill='%23f5f7fb'/>" +
        $"<text x='50%25' y='50%25' text-anchor='middle' dominant-baseline='middle' font-family='Segoe UI, Roboto, system-ui' font-size='28' fill='%238a94a7'>{text}</text></svg>";
    var placeholder = PlaceholderSvg("Kein Bild");

    // palette data attribute value
    var paletteAttr = Model.Farbpalette ?? "";

    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
    var backHref = (!string.IsNullOrWhiteSpace(publicSlug) || !isAuthenticated)
        ? (basePath + "/s/my")
        : Url.Action("Index", "Storyboards", new { area = "User" });
}
<style>
    /* ===== Design tokens (neutrals) ===== */
    :root {
        --ink: #111827;
        --muted: #6b7280;
        --line: #e5e7eb;
        --bg: #f9fafc;
        /* ===== Color Role Schema (defaults; overridden via JS from Farbpalette) ===== */
        --role-primary-400: #9fd62a; /* nice defaults that match the app */
        --role-primary-500: #89ba17;
        --role-primary-600: #77a514;
        --role-primary-700: #6a9312;

        --role-on-primary: #ffffff; /* text on primary */
        --role-chip-bg: rgba(137,186,23,.12);
        --role-chip-border: rgba(137,186,23,.25);
        --role-chip-muted-bg: rgba(137,186,23,.08);
        --role-chip-muted-border: rgba(137,186,23,.20);
        --role-shadow: 0 10px 15px -3px rgba(0,0,0,.08),0 4px 6px -2px rgba(0,0,0,.02);
    }

    .richtext { line-height: 1.6; }
    .richtext p { margin: 0 0 .5rem; }
    .richtext ul, .richtext ol { margin: .5rem 0; padding-left: 1.25rem; }
    .richtext li { margin: .25rem 0; }
    /* Links inside meta/content use fixed uni green like Details view */
    .richtext a { color: #6a9312; text-decoration: underline; }
    .richtext blockquote { margin: .6rem 0; padding-left: .75rem; border-left: 3px solid #e5e7eb; color: #374151; }

    /* Global */
    body {
        background: var(--bg);
        font-family: Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
        line-height: 1.5;
        color: #374151;
    }

    /* Header */
    .viewer-head {
        display: grid;
        gap: 16px;
        align-content: start;
        margin: 0 0 24px;
        padding: 16px 0;
    }

    .viewer-title {
        /* responsive sizing and improved readability */
        font-size: clamp(1.5rem, 1.1rem + 2.2vw, 2.2rem);
        font-weight: 700;
        line-height: 1.25;
        margin: 0;
        color: var(--ink);
        letter-spacing: -.02em;
        text-wrap: balance;
        /* limit to a comfortable measure and clamp lines */
        max-width: 60ch;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Meta grid (match Allgemeine Informationen style) */
    .viewer-meta {
        margin-top: 8px;
    }

    /* Meta accordion */
    .viewer-meta-acc {
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        background: #ffffff;
        box-shadow: 0 8px 20px rgba(15,23,42,.06);
        overflow: hidden;
    }

        .viewer-meta-acc summary {
            list-style: none;
            cursor: pointer;
            padding: 10px 14px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            background: #f9fafb;
            border-bottom: 1px solid #e5e7eb;
            user-select: none;
        }

        .viewer-meta-acc summary::-webkit-details-marker { display:none; }

        .viewer-meta-acc .viewer-meta-title {
            display: flex;
            align-items: center;
            gap: .5rem;
            font-weight: 600;
            color: #1f2937;
            font-size: 1rem;
        }

        .viewer-meta-caret {
            width: 1.6em;
            height: 1.6em;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            line-height: 1;
            font-size: 2rem;
            color: #4b5563;
        }

        .viewer-meta-caret::before { content: "▸"; }
        .viewer-meta-acc[open] .viewer-meta-caret::before { content: "▾"; }

        .viewer-meta-acc .acc-body {
            padding: 12px 16px 14px;
            background: #ffffff;
        }

    .viewer-meta-grid {
        display: grid;
        grid-template-columns: 1fr; /* stack items under each other: Zielgruppe then Lernziel, etc. */
        gap: 14px;
        margin-top: 8px;
    }

        .viewer-meta-grid .item {
            padding: 8px 0;
            border-top: 1px solid #eef1f6;
        }

        .viewer-meta-grid .item.full {
            grid-column: 1 / -1;
        }

        .viewer-meta-grid .item:first-child {
            border-top: 0;
            padding-top: 0;
        }

        .viewer-meta-grid label {
            display: block;
            margin-bottom: 4px;
            font-size: 1.05rem; /* larger labels for better readability */
            font-weight: 600;
            color: #374151;
        }

        .viewer-meta-grid .val {
            font-size: 1rem;
            color: #111827;
        }

    .viewer-taxo {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 4px;
    }

        .viewer-taxo .chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 999px;
            font-weight: 700;
            font-size: .9rem;
            background: rgba(137,186,23,.12); /* uni green, not palette blue */
            color: #6a9312;
            border: 1px solid rgba(137,186,23,.25);
        }

        .viewer-taxo .chip.active {
            background: #89ba17; /* uni green 500 */
            color: #fff;
            border-color: #89ba17;
        }

    .viewer-palette {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 6px;
    }

        .viewer-palette .swatch-wrap {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            min-width: 52px;
        }

        .viewer-palette .swatch {
            width: 28px;
            height: 28px;
            border-radius: 6px;
            border: 1px solid rgba(0,0,0,.15);
        }

        .viewer-palette .swatch-hex {
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
            font-size: .8rem;
            color: #374151;
            line-height: 1;
            letter-spacing: .02em;
        }

    /* Chips */
    .meta-chips {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .meta-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border-radius: 999px;
        font-weight: 600;
        font-size: .92rem;
        background: var(--role-chip-bg);
        color: var(--role-primary-700);
        border: 1px solid var(--role-chip-border);
        box-shadow: 0 1px 2px rgba(16,24,40,.05);
    }

        .meta-chip.muted {
            background: var(--role-chip-muted-bg);
            color: #030303;
            border-color: var(--role-chip-muted-border);
        }

    .meta-bubble {
        padding: 10px 14px;
        border-radius: 999px;
        background: var(--role-chip-bg);
        color: var(--role-primary-700);
        border: 1px solid var(--role-chip-border);
        box-shadow: 0 1px 2px rgba(16,24,40,.05);
    }

    /* Rectangular emphasis bubble variant */
    .meta-bubble.rect {
        border-radius: 10px;
        background: var(--role-chip-muted-bg);
        color: black;
        border-color: var(--role-chip-muted-border);
    }
    .meta-bubble.rect a { color: var(--role-primary-700); text-decoration: underline; }

        .meta-chip .sw {
            width: 14px;
            height: 14px;
            border-radius: 4px;
            border: 1px solid rgba(0,0,0,.14);
            box-shadow: 0 1px 2px rgba(0,0,0,.05);
        }

    /* Palette layout: swatch above hex */
    .meta-chip .pal { display: inline-flex; gap: 10px; align-items: flex-start; margin-left: 6px; }
    .meta-chip .swatch-wrap { display: inline-flex; flex-direction: column; align-items: center; gap: 4px; min-width: 36px; }
    .meta-chip .sw-hex { font-family: ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,"Liberation Mono","Courier New",monospace; font-size: .72rem; color: #475569; line-height: 1; }

    /* Toolbar */
    .toolbar {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
        width: 100%;
        padding: 12px 0;
        border-bottom: 1px solid #f1f5f9;
    }

    /* Simple dropdown */
    .dd { position: relative; display: inline-block; }
    .dd .menu {
        position: absolute;
        right: 0; top: calc(100% + 6px);
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        box-shadow: 0 8px 20px rgba(0,0,0,.08);
        min-width: 240px;
        display: none;
        z-index: 1000;
        overflow: hidden;
    }
    .dd.open .menu { display: block; }
    .dd .menu .menu-item {
        display: block; width: 100%; text-align: left;
        padding: 10px 14px; background: #fff; border: 0; cursor: pointer; font-weight: 600; color: #334155;
    }
    .dd .menu .menu-item:hover { background: #f8fafc; }

    .tb-btn {
        --h: 40px;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 0 14px;
        height: var(--h);
        min-width: var(--h);
        font-weight: 600;
        color: #4b5563;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all .2s ease;
        box-shadow: 0 1px 2px rgba(0,0,0,.05);
    }

        .tb-btn:hover {
            background: #f9fafb;
            transform: translateY(-1px);
            box-shadow: 0 4px 6px rgba(0,0,0,.05);
        }

        .tb-btn:active {
            transform: translateY(0);
        }

        .tb-btn.active {
            background: color-mix(in srgb, var(--role-primary-500) 12%, #fff);
            border-color: color-mix(in srgb, var(--role-primary-500) 35%, #e5e7eb);
            color: var(--role-primary-700);
        }

    .sep {
        width: 1px;
        height: 28px;
        background: #e5e7eb;
        margin: 0 4px;
    }

    .mono {
        font-family: ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,"Liberation Mono","Courier New",monospace;
        font-size: .9rem;
    }

    /* Layout cards */
    .viewer-stack {
        display: grid;
        grid-template-columns: 1fr;
        gap: 24px;
    }

    .stage-card, .panel-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,.05),0 2px 4px -1px rgba(0,0,0,.03);
        padding: 20px;
        transition: box-shadow .2s ease, transform .15s ease;
        position: relative;
    }

        .stage-card:hover, .panel-card:hover {
            box-shadow: var(--role-shadow);
        }

    .panel-card {
        word-wrap: break-word;
        overflow-wrap: anywhere;
    }

    .panel-card.floating {
        position: fixed;
        width: min(420px, 94vw);
        max-height: calc(100vh - 32px);
        z-index: 60;
        cursor: default;
        display: flex;
        flex-direction: column;
        transition: box-shadow .18s ease, transform .18s ease, left .08s ease-out, top .08s ease-out;
    }

    .panel-card.floating .marker-list {
        flex: 1;
        max-height: none;
        min-height: 0;
    }

    .panel-title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 12px;
        cursor: grab;
        user-select: none;
    }

    .panel-card.floating.dragging {
        cursor: grabbing;
        box-shadow: 0 18px 45px rgba(15,23,42,.25);
        transform: translateY(-1px);
    }

    .panel-card.floating .panel-resizer {
        position: absolute;
        right: 6px;
        bottom: 6px;
        width: 16px;
        height: 16px;
        cursor: nwse-resize;
        border-bottom-right-radius: 12px;
    }

    .panel-card.floating .panel-resizer::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, transparent 0, transparent 40%, #d1d5db 40%, #d1d5db 60%, transparent 60%, transparent 100%);
        opacity: .9;
        border-bottom-right-radius: 12px;
        pointer-events: none;
    }

    .panel-float-btn {
        border: none;
        background: #f3f4f6;
        border-radius: 999px;
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #4b5563;
        cursor: pointer;
        box-shadow: 0 1px 2px rgba(15,23,42,.12);
        transition: background .15s ease, transform .12s ease, box-shadow .15s ease, color .15s ease;
    }

        .panel-float-btn:hover {
            background: rgba(137,186,23,.1);
            color: #6a9312;
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(15,23,42,.16);
        }

        .panel-card.floating .panel-float-btn {
            background: #111827;
            color: #f9fafb;
        }

    /* Stage */
    .stage-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 16px;
    }

    .stage-title {
        font-weight: 700;
        font-size: 1.2rem;
        color: var(--ink);
        margin: 0;
    }

    .stage-sub {
        color: #6b7280;
        font-size: .9rem;
        margin-top: 4px;
    }

    .viewport {
        width: 100%;
        height: auto; /* match content height */
        min-height: unset; /* no enforced min height */
        overflow: auto; /* scroll when zoomed in */
        border: 1px solid #f3f4f6;
        border-radius: 12px;
        background: #f9fafb;
        position: relative;
        box-shadow: inset 0 2px 4px rgba(0,0,0,.03);
    }

    .zoom-wrap {
        transform-origin: 0 0;
        display: inline-block;
        transition: transform .2s ease;
    }

    .board {
        position: relative;
        display: inline-block;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #f3f4f6;
        background: #fff;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,.05);
    }

        .board img {
            display: block;
            max-width: 100%;
            height: auto;
            image-rendering: auto;
        }

    .overlay {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    /* Markers */
    .dot-wrap {
        position: absolute;
        transform: translate(-50%,-50%);
        pointer-events: auto;
        transition: transform .2s ease;
    }

        .dot-wrap:hover {
            transform: translate(-50%,-50%) scale(1.1);
            z-index: 2;
        }

    .marker-dot {
        display: inline-block;
        width: 16px;
        height: 16px;
        border-radius: 999px;
        background: var(--c, #4a86e8);
        border: 2px solid #fff;
        outline: 1px solid rgba(0,0,0,.2);
        box-shadow: 0 1px 2px rgba(0,0,0,.15);
    }
        /* numbers-only look */
        .marker-dot.selected {
            box-shadow: 0 0 0 6px rgba(74,134,232,.25);
            outline-width: 3px;
        }

    .num-badge {
        margin-left: 6px;
        padding: 2px 8px;
        font: 700 12px/16px system-ui,Segoe UI,Roboto;
        border-radius: 10px;
        color: #fff;
        background: var(--role-primary-600);
        border: 1px solid rgba(0,0,0,.15);
        pointer-events: auto;
        box-shadow: 0 2px 4px rgba(0,0,0,.1);
    }

    .ping {
        position: absolute;
        inset: -10px;
        border-radius: 999px;
        border: 2px solid var(--c);
        opacity: .45;
        animation: ping 1.2s cubic-bezier(.2,0,.2,1) 1;
    }

    @@keyframes ping {
        0% {
            transform: scale(.3);
            opacity: .5;
        }

        100% {
            transform: scale(1.6);
            opacity: 0;
        }
    }

    /* Panel */
    .panel-title {
        font-weight: 700;
        font-size: 1.2rem;
        margin: 0 0 16px;
        color: var(--ink);
    }

    .scenes {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(200px,1fr));
        gap: 14px;
        margin-bottom: 20px;
    }

    .scene-item {
        border: 1px solid #f3f4f6;
        border-radius: 12px;
        overflow: hidden;
        cursor: pointer;
        background: #f9fafb;
        transition: all .2s ease;
        box-shadow: 0 1px 3px rgba(0,0,0,.05);
    }

        .scene-item:hover {
            transform: translateY(-2px);
            box-shadow: var(--role-shadow);
            border-color: #e5e7eb;
        }

        .scene-item.active {
            outline: 2px solid var(--role-primary-500);
            border-color: transparent;
        }

    .scene-thumb {
        aspect-ratio: 16/9;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f5f7fb;
    }

        .scene-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .3s ease;
        }

    .scene-item:hover .scene-thumb img {
        transform: scale(1.05);
    }

    .scene-caption {
        font-weight: 600;
        font-size: .92rem;
        padding: 10px;
        color: var(--ink);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        background: #fff;
    }

    .tools-row {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 20px 0 16px;
        flex-wrap: wrap;
        padding-bottom: 16px;
        border-bottom: 1px solid #f3f4f6;
    }

    .switch {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        color: #4b5563;
        cursor: pointer;
    }

        .switch input {
            transform: scale(1.1);
            accent-color: var(--role-primary-500);
        }

    .sel-info {
        font-size: .9rem;
        color: #6b7280;
        font-weight: 500;
    }

    .search {
        display: flex;
        gap: 10px;
        margin: 16px 0;
    }

    .toolbar .push {
        margin-left: auto;
    }

        .search input {
            flex: 1;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 10px 14px;
            font-size: .9rem;
            transition: all .2s ease;
            background: #f1f1f1;
            color: var(--ink);
        }

            .search input:focus {
                outline: none;
                border-color: var(--role-primary-500);
            }

    .marker-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 16px;
        max-height: 40vh;
        overflow-y: auto;
        overflow-x: hidden;
        padding-right: 4px;
    }

        .marker-list::-webkit-scrollbar {
            width: 6px;
        }

        .marker-list::-webkit-scrollbar-track {
            background: #f9fafb;
            border-radius: 3px;
        }

        .marker-list::-webkit-scrollbar-thumb {
            background: #e5e7eb;
            border-radius: 3px;
        }

    .mcard {
        border: 1px solid #f3f4f6;
        margin-top: 9px;
        border-radius: 12px;
        padding: 14px;
        background: #f9fafb;
        transition: all .2s ease;
        cursor: pointer;
    }

        .mcard:hover {
            background: #fff;
            border-color: #e5e7eb;
            transform: translateY(-1px);
            box-shadow: 0 4px 6px -1px rgba(0,0,0,.05);
        }

        .mcard.active {
            border-color: var(--role-primary-500);
            box-shadow: 0 8px 20px color-mix(in srgb, var(--role-primary-500) 25%, transparent);
            background: #fff;
        }

    .mhead {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 700;
        font-size: .95rem;
        margin-bottom: 6px;
    }

    .mbadge {
        width: 12px;
        height: 12px;
        border-radius: 999px;
        border: 1px solid rgba(0,0,0,.2);
        flex-shrink: 0;
    }

    .msub {
        font-size: .85rem;
        color: #6b7280;
        margin-bottom: 8px;
        line-height: 1.4;
    }

    .mgrid {
        display: grid;
        grid-template-columns: 120px 1fr;
        gap: 12px;
        margin-top: 12px;
    }

        .mgrid > div {
            min-width: 0;
        }

        .mgrid .k {
            color: #111827; /* darker for clarity */
            font-weight: 700; /* stronger headings */
            font-size: 1.05rem; /* larger headings for better readability */
        }

    .copy {
        font-size: .82rem;
        border: 1px dashed #e5e7eb;
        border-radius: 8px;
        padding: 4px 8px;
        cursor: pointer;
        transition: all .2s ease;
        display: inline-block;
        margin-top: 4px;
    }

        .copy:hover {
            background: #f9fafb;
            border-color: var(--role-primary-500);
            color: var(--role-primary-600);
        }

    .alert {
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 24px;
        border: 1px solid #fef3c7;
        background: #fffbeb;
        color: #92400e;
        font-size: .95rem;
    }

    /* Responsive */
    @@media (max-width:768px) {
        .viewer-title {
            font-size: clamp(1.25rem, 1rem + 3vw, 1.8rem);
            -webkit-line-clamp: 3;
        }

        .toolbar {
            gap: 8px;
        }

        .tb-btn {
            --h: 36px;
            padding: 0 12px;
            font-size: .9rem;
        }

        .scenes {
            grid-template-columns: repeat(auto-fill,minmax(160px,1fr));
            gap: 12px;
        }

        .stage-head {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }

        .viewport {
            height: auto; /* keep content-driven height on small screens */
            min-height: unset;
        }

        .mgrid {
            grid-template-columns: 1fr;
            gap: 4px;
        }
    }

    /* Print */
    @@media print {
        .viewer-head, .toolbar, .panel-card, .meta-chips {
            display: none !important;
        }

        .viewport {
            height: auto !important;
            overflow: visible !important;
            border: none !important;
        }

        .stage-card {
            box-shadow: none !important;
            border: none !important;
            padding: 0 !important;
        }
    }

    .btn-secondary {
        background: #fff;
        border: 1px solid rgba(137,186,23,.35);
        color: #6a9312; /* fixed uni green, not palette */
        border-radius: 10px;
        padding: 10px 16px;
        font-weight: 800;
        text-decoration: none !important;
        transition: background .2s ease, color .2s ease, border-color .2s ease;
    }

        .btn-secondary:hover {
            background: rgba(137,186,23,.08);
            color: #6a9312;
        }

</style>


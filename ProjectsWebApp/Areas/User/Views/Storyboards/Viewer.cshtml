              ['Beschreibung',  m.description],
              ['Datenablage',   m.datenablage],
              ['Prompt-Idee',   m.promptIdee],
              ['Reflexion – Notizen', m.reflexion]
            ];

            rows.forEach(([k, v]) => {
              const vPlain = htmlToText(v ?? '').trim();
              if (!vPlain) return; // skip empty fields completely

              const kEl = document.createElement('div');
              kEl.className = 'k';
              kEl.textContent = k;

              const vEl = document.createElement('div');
              vEl.textContent = vPlain; // plain text, never HTML

              grid.append(kEl, vEl);
            });

            card.append(head, grid);
            card.addEventListener('mouseenter', ()=> pulseMarker(m.id));
            card.addEventListener('click', ()=> selectMarker(m.id, {center:true, ripple:true, pinPopover:true, scroll:false}));

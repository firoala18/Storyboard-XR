          // ---------- Export PDF ----------
          function hexToRgb(hex){
            const h = hex.replace('#','').trim();
            if (h.length === 3) { const r=h[0]+h[0], g=h[1]+h[1], b=h[2]+h[2]; return [parseInt(r,16),parseInt(g,16),parseInt(b,16)]; }
            if (h.length >= 6) return [parseInt(h.slice(0,2),16),parseInt(h.slice(2,4),16),parseInt(h.slice(4,6),16)];
            return [74,134,232];
          }
          function htmlToText(input){
            try{
              const div = document.createElement('div');
              div.innerHTML = String(input || '');
              const txt = div.textContent || div.innerText || '';
              return txt.replace(/\s+/g, ' ').trim();
            } catch{ return String(input||''); }
          }

          // ---- Minimal HTML -> styled lines (bold/italic, br, p, ul/ol/li) for PDF ----
          function parseHtmlToElements(html){
            const root = document.createElement('div'); root.innerHTML = String(html||'');
            const elements = [];
            function collectRuns(node, style){
              const runs = [];
              const st = { bold: !!(style&&style.bold), italic: !!(style&&style.italic), underline: !!(style&&style.underline), color: style?.color || null };
              node.childNodes.forEach(ch=>{
                if (ch.nodeType === 3){
                  const t = ch.textContent||''; if (t) runs.push({ text: t, ...st });
                } else if (ch.nodeType === 1){
                  const tag = ch.tagName.toLowerCase();
                  if (tag === 'br'){ runs.push({ text: '\n', br:true, ...st }); return; }
                  // derive next style
                  let next = { bold: st.bold || tag==='b' || tag==='strong', italic: st.italic || tag==='i' || tag==='em', underline: st.underline || tag==='u', color: st.color };
                  if (tag === 'a'){ next.underline = true; next.color = next.color || '#1d4ed8'; }
                  if (tag === 'span' || tag === 'a'){
                    const css = (ch.getAttribute('style')||'').toLowerCase();
                    if (/font-weight\s*:\s*(bold|700|800|900)/.test(css)) next.bold = true;
                    if (/font-style\s*:\s*italic/.test(css)) next.italic = true;
                    if (/text-decoration\s*:\s*underline/.test(css)) next.underline = true;
                    const m = css.match(/color\s*:\s*(#[0-9a-f]{3,8}|rgb\([^)]+\))/);
                    if (m) next.color = m[1];
                  }
                  runs.push(...collectRuns(ch, next));
                }
              });
              return runs;
            }
            function addParagraph(runs){ elements.push({ type:'p', runs }); }
            function addList(items, ordered){ elements.push({ type: ordered?'ol':'ul', items }); }
            function handle(node){
              if (node.nodeType === 3){ const t=node.textContent||''; if (t.trim()) addParagraph([{text:t}]); return; }
              if (node.nodeType !== 1) return;
              const tag = node.tagName.toLowerCase();
              if (tag === 'p' || tag==='blockquote' || tag==='div'){
                const runs = collectRuns(node, {});
                if (runs.length) addParagraph(runs);
              } else if (tag==='ul' || tag==='ol'){
                const items=[]; let idx=1;
                node.querySelectorAll(':scope>li').forEach(li=>{ items.push({ runs: collectRuns(li,{}) , idx: idx++ }); });
                addList(items, tag==='ol');
              } else if (tag==='br'){
                addParagraph([{text:'\n'}]);
              } else {
                // inline-only container -> treat as paragraph
                const runs = collectRuns(node, {}); if (runs.length) addParagraph(runs);
              }
            }
            Array.from(root.childNodes).forEach(handle);
            return elements;
          }

          function measureTextWidth(pdf, text, style){
            const s = style?.bold && style?.italic ? 'bolditalic' : (style?.bold ? 'bold' : (style?.italic ? 'italic' : 'normal'));
            pdf.setFont('helvetica', s); pdf.setFontSize(10);
            return pdf.getTextWidth(text||'');
          }

          function wrapElementsToLines(pdf, elements, maxWidth){
            const lines = [];
            const pushLine = (segments, indent=0)=>{ lines.push({ segments, indent }); };
            function flushBuffer(buf, indent){ if (buf.length) pushLine(buf.splice(0, buf.length), indent||0); }
            function wrapRuns(runs, indent){
              let curW = indent||0; let buf=[];
              const spaceW = measureTextWidth(pdf, ' ', {});
              const addWord = (word, style)=>{
                const w = measureTextWidth(pdf, word, style);
                if (curW + w > maxWidth && buf.length){ flushBuffer(buf, indent); curW = indent||0; }
                buf.push({ text: word, style, xOffset: curW }); curW += w;
              };
              const newLine = ()=>{ flushBuffer(buf, indent); curW = indent||0; };
              runs.forEach(r=>{
                if (r.br){ newLine(); return; }
                const parts = String(r.text||'').split(/(\s+)/);
                parts.forEach(p=>{
                  if (!p) return;
                  const isSpace = /^(\s+)$/.test(p);
                  if (isSpace){
                    if (curW === (indent||0)) return; // skip leading space at line start
                  }
                  addWord(p, { bold: !!r.bold, italic: !!r.italic });
                });
              });
              flushBuffer(buf, indent);
            }
            function wrapRunsToLines(runs, indent){
              let curW = indent||0; let buf=[]; const out=[];
              const addOut = ()=>{ if (buf.length) out.push({ segments: buf.splice(0, buf.length), indent: indent||0 }); };
              runs.forEach(r=>{
                if (r.br){ addOut(); curW = indent||0; return; }
                const parts = String(r.text||'').split(/(\s+)/);
                parts.forEach(p=>{
                  if (!p) return;
                  const isSpace = /^(\s+)$/.test(p);
                  if (isSpace && curW === (indent||0)) return; // skip leading spaces
                  const w = measureTextWidth(pdf, p, { bold: !!r.bold, italic: !!r.italic });
                  if (curW + w > maxWidth && buf.length){ addOut(); curW = indent||0; }
                  buf.push({ text: p, style: { bold: !!r.bold, italic: !!r.italic } }); curW += w;
                });
              });
              addOut();
              return out;
            }
            elements.forEach(el=>{
              if (el.type==='p'){
                wrapRuns(el.runs, 0);
                // paragraph gap
                lines.push({ segments: [{ text:'', style:{} }], gapAfter:true, indent:0 });
              } else if (el.type==='ul' || el.type==='ol'){
                el.items.forEach((it, idx)=>{
                  const bullet = el.type==='ol' ? (String(idx+1)+'. ') : '\u2022 ';
                  const bW = measureTextWidth(pdf, bullet, { bold:false, italic:false });
                  const out = wrapRunsToLines(it.runs, bW);
                  if (out.length === 0){
                    lines.push({ segments: [{ text: bullet, style:{} }], indent:0 });
                  } else {
                    out[0].segments.unshift({ text: bullet, style:{} });
                    // first line should have no extra indent (so bullet starts at left), subsequent lines align under text
                    out.forEach((ln, i)=>{ ln.indent = (i===0 ? 0 : bW); });
                    out.forEach(ln=> lines.push(ln));
                  }
                });
                lines.push({ segments: [{ text:'', style:{} }], gapAfter:true, indent:0 });
              }
            });
            return lines;
          }

          function drawStyledLinesInBox(pdf, lines, boxX, boxY, boxW, bottom, padX, padY, lineH){
            // returns final Y and remaining lines if page break was needed
            const contentW = Math.max(20, boxW - padX*2);
            let curY = boxY + padY + 3.6; let i=0;
            while (i < lines.length){
              if (curY + lineH > bottom){ break; }
              const line = lines[i];
              let curX = boxX + padX + (line.indent || 0);
              line.segments.forEach(seg=>{
                const s = seg.style||{}; const st = s.bold && s.italic ? 'bolditalic' : (s.bold ? 'bold' : (s.italic ? 'italic' : 'normal'));
                const color = (s.color && /^#/.test(s.color)) ? s.color : null;
                if (color){
                  const [r,g,b] = (function(hex){ hex=hex.replace('#',''); if(hex.length===3){hex=hex.split('').map(c=>c+c).join('');} return [parseInt(hex.slice(0,2),16),parseInt(hex.slice(2,4),16),parseInt(hex.slice(4,6),16)]; })(color);
                  pdf.setTextColor(r,g,b);
                } else { pdf.setTextColor(17,24,39); }
                pdf.setFont('helvetica', st); pdf.setFontSize(10);
                const w = measureTextWidth(pdf, seg.text||'', s);
                pdf.text(seg.text||'', curX, curY);
                if (s.underline){ pdf.setDrawColor(17); pdf.setLineWidth(0.2); pdf.line(curX, curY + 0.8, curX + w, curY + 0.8); }
                curX += w;
              });
              curY += lineH;
              if (line.gapAfter) curY += 2;
              i++;
            }
            return { y: curY, consumed: i };
          }

          function drawLabeledHtmlBlock(pdf, ctx, label, html, x, y, maxW){
            const padX = 2.5, padY = 1.6, r = 2.2, gap = 1.8;
            const { page, margin, contentW, pr, pg, pb } = ctx;
            const bottom = page.h - margin - 6;
            const boxX = margin; const boxW = contentW; const lineHLocal = 4.8;
            // heading chip
            pdf.setFont('helvetica','bold'); pdf.setFontSize(9.5);
            const chipW = pdf.getTextWidth(label) + padX*2, chipH = 5.6;
            const minBlockH = chipH + gap + (lineHLocal + padY*2);
            if (y + minBlockH > bottom){ pdf.addPage(); y = margin + 6; }

            pdf.setFillColor(255,255,255); pdf.setDrawColor(255,255,255);
            pdf.roundedRect(x, y, chipW, chipH, 1.6, 1.6, 'F');
            pdf.setTextColor(pr,pg,pb); pdf.text(label, x + padX, y + chipH - 1.8);

            const elements = parseHtmlToElements(html);
            let lines = wrapElementsToLines(pdf, elements, Math.max(20, boxW - padX*2));

            let curY = y + chipH + gap;
            while (lines.length){
              // compute how many lines fit
              let avail = bottom - curY;
              let maxLines = Math.floor((avail - padY*2) / lineHLocal);
              if (maxLines <= 0){ pdf.addPage(); curY = margin + 6; continue; }
              const use = lines.slice(0, maxLines);
              const boxH = use.length * lineHLocal + padY*2 + (use.some(l=>l.gapAfter)?2:0);
              pdf.setFillColor(255,255,255);
              pdf.roundedRect(boxX, curY, boxW, boxH, r, r, 'F');
              const res = drawStyledLinesInBox(pdf, use, boxX, curY, boxW, bottom, padX, padY, lineHLocal);
              curY = res.y + 3; // gap between continued boxes
              lines = lines.slice(res.consumed);
              if (lines.length){ pdf.addPage(); curY = margin + 6; }
            }
            return curY;
          }
          function pickPrimary(){
            const raw = meta.palette.find(x => x) || getComputedStyle(document.documentElement).getPropertyValue('--role-primary-500') || '#4a86e8';
            return (raw.trim().startsWith('#') ? raw.trim() : ('#' + raw.trim()));
          }

          async function imageToDataUrl(imgEl){
            if (!imgEl.complete || !imgEl.naturalWidth){
              await new Promise(res => imgEl.addEventListener('load', res, { once:true }));
            }
            const cnv = document.createElement('canvas');
            cnv.width = imgEl.naturalWidth; cnv.height = imgEl.naturalHeight;
            const ctx = cnv.getContext('2d'); ctx.drawImage(imgEl, 0, 0);
            return { dataUrl: cnv.toDataURL('image/jpeg', 0.95), w: cnv.width, h: cnv.height };
          }

          async function svgToPngDataUrl(url, targetWpx){
            return new Promise((resolve, reject) => {
              const img = new Image();
              img.crossOrigin = 'anonymous';
              img.onload = () => {
                try{
                  const w = targetWpx || img.width || 320;
                  const h = Math.round(w * (img.height/img.width || 0.3) || w*0.3);
                  const cnv = document.createElement('canvas'); cnv.width = w; cnv.height = h;
                  const ctx = cnv.getContext('2d'); ctx.drawImage(img, 0, 0, w, h);
                  resolve({ dataUrl: cnv.toDataURL('image/png'), w, h });
                }catch(e){ reject(e); }
              };
              img.onerror = reject;
              img.src = url;
            });
          }

          async function imageUrlToDataUrl(url){
            return new Promise((resolve, reject) => {
              const im = new Image();
              im.crossOrigin = 'anonymous';
              im.onload = async () => {
                try{
                  const cnv = document.createElement('canvas');
                  cnv.width = im.naturalWidth; cnv.height = im.naturalHeight;
                  const ctx = cnv.getContext('2d'); ctx.drawImage(im, 0, 0);
                  resolve({ dataUrl: cnv.toDataURL('image/jpeg', 0.95), w: cnv.width, h: cnv.height });
                }catch(e){ reject(e); }
              };
              im.onerror = reject;
              im.src = url;
            });
          }

          async function generatePdf(mode){
            try{
              if (!(window.jspdf && window.jspdf.jsPDF)){ alert('PDF Bibliothek konnte nicht geladen werden.'); return; }
              const { jsPDF } = window.jspdf;
              const pdf = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4', putOnlyUsedFonts: true });
              const page = { w: pdf.internal.pageSize.getWidth(), h: pdf.internal.pageSize.getHeight() }, margin = 12, contentW = page.w - margin*2;
              const innerX = margin; // start at body container left
              const innerW = contentW; // use full body container width

              const primaryHex = pickPrimary();
              const [pr,pg,pb] = hexToRgb(primaryHex);
              const ctx = { page, margin, contentW, pr, pg, pb };
              const lineH = 4.8;

              let didPageBreak = false;
              function drawLabeledBlock(label, value, x, y, maxW){
                if (!value) return y;
                const padX = 2.5, padY = 1.6, r = 2.2, gap = 1.8;
                const bottom = page.h - margin - 6;
                const toText = (v) => String(v == null ? '' : v);
                // Full-width box inside body container
                const boxX = margin;
                const boxW = contentW;
                const contentWidth = Math.max(20, boxW - padX*2);
                const lines = pdf.splitTextToSize(toText(value), contentWidth);

                // measure chip
                pdf.setFont('helvetica','bold'); pdf.setFontSize(9.5);
                const chipW = pdf.getTextWidth(label) + padX*2, chipH = 5.6;

                // Ensure heading and first line start on same page
                const minBlockH = chipH + gap + (lineH + padY*2);
                if (y + minBlockH > bottom){
                  pdf.addPage(); didPageBreak = true; y = margin + 6;
                }

                // Draw chip label once (on the first page only)
                pdf.setFillColor(255,255,255); pdf.setDrawColor(255,255,255);
                pdf.roundedRect(x, y, chipW, chipH, 1.6, 1.6, 'F');
                pdf.setTextColor(pr,pg,pb);
                pdf.text(label, x + padX, y + chipH - 1.8);

                // Paginate content box across pages if needed
                let i = 0; // line index
                let curY = y + chipH + gap;
                pdf.setTextColor(17,24,39); pdf.setFont('helvetica','normal'); pdf.setFontSize(10);
                while (i < lines.length){
                  const avail = bottom - curY;
                  const maxLinesThisPage = Math.floor((avail - padY*2) / lineH);
                  if (maxLinesThisPage <= 0){
                    pdf.addPage(); didPageBreak = true; curY = margin + 6; continue;
                  }
                  const slice = lines.slice(i, i + maxLinesThisPage);
                  const boxH = slice.length * lineH + padY*2;
                  pdf.setFillColor(255,255,255);
                  pdf.roundedRect(boxX, curY, boxW, boxH, r, r, 'F');
                  let ty = curY + padY + 3.6;
                  slice.forEach(t => { pdf.text(t, boxX + padX, ty); ty += lineH; });
                  i += slice.length;
                  curY += boxH + 3; // small gap between continued boxes
                  if (i < lines.length){
                    // Need more space, go to next page for continuation
                    pdf.addPage(); didPageBreak = true; curY = margin + 6;
                  }
                }
                return curY;
              }

              // Header
              const headerH = 40;
              const titleOrig = (container?.dataset.title || 'Storyboard');
              pdf.setFillColor(pr,pg,pb);
              pdf.rect(0,0,page.w,headerH,'F');

              // (Title removed from header; will be rendered as a labeled block below)

              // University logo (top-left)
              try {
                const logo = await svgToPngDataUrl(`${PATH_BASE}/images/logo_header_white.svg`, 2000);
                const ratio = logo.h / logo.w;
                const logoWmm = 70; // larger for better visibility
                const logoHmm = logoWmm * ratio;
                const lx = margin + 3; const ly = Math.max(2, (headerH - logoHmm) / 2);
                pdf.addImage(logo.dataUrl, 'PNG', lx, ly, logoWmm, logoHmm);
              } catch {}

              // Palette: prepare values for later rendering (inside meta block)
              const sw = 6.2, gap = 2.8, MAX_SWATCHES = 8;
              const palette = meta.palette.slice(0, MAX_SWATCHES).map(h => h.startsWith('#')?h:'#'+h);

              // Body container
              const bodyTop = headerH + 6;
              pdf.setFillColor(248,250,252);
              pdf.roundedRect(margin, bodyTop, contentW, page.h - bodyTop - 12, 3, 3, 'F');

              // Meta blocks (title included here, as requested)
              let yCursor = bodyTop + 6;
              const hasTitle = String(titleOrig||'').replace(/<[^>]*>/g,'').trim();
              if (hasTitle) { yCursor = drawLabeledHtmlBlock(pdf, ctx, 'Titel', String(titleOrig||''), innerX, yCursor, innerW); yCursor += 3; }
              const hasDesc = String(meta.desc||'').replace(/<[^>]*>/g,'').trim();
              if (hasDesc) { yCursor = drawLabeledHtmlBlock(pdf, ctx, 'Beschreibung', String(meta.desc||''), innerX, yCursor, innerW); yCursor += 3; }
              yCursor = drawLabeledBlock('Taxonomie', meta.taxo, innerX, yCursor, innerW); yCursor += 3;
              const hasZg = String(meta.zg||'').replace(/<[^>]*>/g,'').trim();
              if (hasZg) { yCursor = drawLabeledHtmlBlock(pdf, ctx, 'Zielgruppe', String(meta.zg||''), innerX, yCursor, innerW); yCursor += 3; }
              const hasLz = String(meta.lz||'').replace(/<[^>]*>/g,'').trim();
              if (hasLz) { yCursor = drawLabeledHtmlBlock(pdf, ctx, 'Lernziel', String(meta.lz||''), innerX, yCursor, innerW); }
              // Palette block with swatches over hexes
              function drawPaletteBlock(label, hexes, x, y, maxW){
                const items = (hexes||[]).map(h => h && (h.startsWith('#')?h:'#'+h)).filter(Boolean);
                if (!items.length) return y;
                const padX = 2.5, padY = 1.6, r = 2.2, gapY = 6.0, gapX = 10.0;
                // Ensure heading fits
                pdf.setFont('helvetica','bold'); pdf.setFontSize(9.5);
                const chipW = pdf.getTextWidth(label) + padX*2, chipH = 5.6;
                const bottom = page.h - margin - 6;
                // compute cell width based on text width to avoid collisions
                pdf.setFont('helvetica','normal'); pdf.setFontSize(9);
                const allowedContent = Math.max(20, (margin + contentW - x) - padX*2 - 1);
                const cellW = Math.max(sw + 8, Math.max(...items.map(h => pdf.getTextWidth(h))) + 8);
                const cellH = sw + 6.0 + 5.2; // swatch + larger gap + hex text line
                // layout: wrap to multiple rows
                const cols = Math.max(1, Math.floor((Math.min(maxW, allowedContent)) / (cellW + gapX)));
                const rows = Math.ceil(items.length / cols);
                const contentWpx = Math.min(Math.min(maxW, allowedContent), cols*cellW + (cols-1)*gapX);
                const contentHpx = rows*cellH + (rows-1)*gapY;
                const boxW = contentWpx + padX*2;
                const boxH = contentHpx + padY*2;
                const totalH = chipH + gapY + boxH;
                if (y + totalH > bottom){ pdf.addPage(); didPageBreak = true; y = margin + 6; }
                // Chip
                pdf.setFillColor(255,255,255); pdf.setDrawColor(255,255,255);
                pdf.roundedRect(x, y, chipW, chipH, 1.6, 1.6, 'F');
                pdf.setTextColor(pr,pg,pb); pdf.text(label, x + padX, y + chipH - 1.8);
                // Box
                const boxX = x, boxY = y + chipH + gapY;
                pdf.setFillColor(255,255,255); pdf.roundedRect(boxX, boxY, boxW, boxH, r, r, 'F');
                // Content
                pdf.setDrawColor(255,255,255);
                let idx = 0;
                for (let r = 0; r < rows; r++){
                  for (let c = 0; c < cols && idx < items.length; c++, idx++){
                    const hex = items[idx];
                    const [r1,g1,b1] = hexToRgb(hex);
                    const cx = boxX + padX + c*(cellW + gapX);
                    const cy = boxY + padY + r*(cellH + gapY);
                    const swX = cx + (cellW - sw)/2; // center swatch in cell
                    pdf.setFillColor(r1,g1,b1);
                    pdf.roundedRect(swX, cy, sw, sw, 1, 1, 'FD');
                    pdf.setTextColor(15,23,42); pdf.setFont('helvetica','normal'); pdf.setFontSize(9);
                    pdf.text(hex, cx + cellW/2, cy + sw + 4.6, { align: 'center' });
                  }
                }
                return boxY + boxH;
              }
              if (palette && palette.length){ yCursor += 2; yCursor = drawPaletteBlock('Palette', palette, innerX, yCursor, innerW); }
              yCursor += 6;

              // If any block required a page break, place the image on a fresh page after the text
              if (didPageBreak){ pdf.addPage(); yCursor = margin + 6; didPageBreak = false; }

              // Scene title above image (current scene)
              try {
                const sceneNode = qa('.scene-item').find(x => parseInt(x.dataset.sceneId,10)===currentSceneId);
                const sceneLabel = sceneNode?.dataset.name || (`Szene ${sceneNode?.dataset.number||''}`);
                if (sceneLabel){ pdf.setTextColor(pr,pg,pb); pdf.setFont('helvetica','bold'); pdf.setFontSize(12); pdf.text(sceneLabel, margin + 2, yCursor); yCursor += 6; }
              } catch {}

              // Base image
              const currentImgUrl = qa('.scene-item').find(x => parseInt(x.dataset.sceneId,10)===currentSceneId)?.querySelector('img')?.src;
              const snap = (mode==='all' && currentImgUrl) ? await imageUrlToDataUrl(currentImgUrl) : await imageToDataUrl(img);
              const imgRatio = snap.w / snap.h;
              let imgWmm = contentW - 12;
              let imgHmm = imgWmm / imgRatio;
              const bodyBottom = page.h - 12, safePad = 8, maxImgHmmHere = Math.max(40, bodyBottom - yCursor - safePad);
              if (imgHmm > maxImgHmmHere){
                if (maxImgHmmHere < 60){ pdf.addPage(); yCursor = margin + 6; }
                const bodyBottom2 = page.h - 12;
                const maxImgHmm = Math.max(40, bodyBottom2 - yCursor - safePad);
                imgHmm = Math.min(imgHmm, maxImgHmm);
                imgWmm = imgHmm * imgRatio;
                if (imgWmm > contentW - 12) { imgWmm = contentW - 12; imgHmm = imgWmm / imgRatio; }
              }
              const imgX = margin + (contentW - imgWmm)/2, imgY = yCursor;
              pdf.addImage(snap.dataUrl, 'JPEG', imgX, imgY, imgWmm, imgHmm);

              // Vector markers on the image page
              const dotR = 2.4, badgeH = 6.2, padXNum = 2.2;
              pdf.setFont('helvetica','bold'); pdf.setFontSize(11.5);
              markers.slice().sort((a,b)=> a.number - b.number || a.id - b.id).forEach(m => {
                const colorHex = (m.colorHex || primaryHex);
                const [r,g,b] = hexToRgb(colorHex);
                const cx = imgX + (m.x || 0) * imgWmm;
                const cy = imgY + (m.y || 0) * imgHmm;
                pdf.setFillColor(r,g,b); pdf.setDrawColor(255,255,255); pdf.setLineWidth(0.6);
                pdf.circle(cx, cy, dotR, 'FD');
                const num = String(m.number ?? ''); const tw = pdf.getTextWidth(num);
                const badgeW = Math.max(9, tw + padXNum*2);
                const rightEdge = imgX + imgWmm;
                const placeRight = (cx + dotR + 1.8 + badgeW <= rightEdge);
                const bx = placeRight ? (cx + dotR + 1.8) : (cx - dotR - 1.8 - badgeW);
                const by = cy - badgeH/2;
                pdf.setFillColor(r,g,b); pdf.setDrawColor(255,255,255);
                pdf.roundedRect(bx, by, badgeW, badgeH, 1.6, 1.6, 'FD');
                pdf.setTextColor(255,255,255);
                pdf.text(num, bx + badgeW/2, by + badgeH/2 + 1.6, { align: 'center' });
              });

              // Move marker details to a NEW page (image-only page above)
              pdf.addPage();
              let y = margin + 6;

              

              // Marker details (stacked full-width blocks)
              const sorted = markers.slice().sort((a,b)=> a.number - b.number || a.id - b.id);
              const bottom = page.h - 12;
              let firstMarker = true;
              sorted.forEach(m => {
                // separator between markers
                if (!firstMarker){
                  if (y + 6 > bottom){ pdf.addPage(); y = margin + 6; }
                  pdf.setDrawColor(226,232,240);
                  pdf.line(margin+4, y, margin+contentW-4, y);
                  y += 6;
                }
                // Section heading: Marker #N
                if (y + 8 > bottom){ pdf.addPage(); y = margin + 6; }
                pdf.setTextColor(15,23,42); pdf.setFont('helvetica','bold'); pdf.setFontSize(12);
                pdf.text(`Marker #${String(m.number ?? '')}`, innerX, y);
                y += 2;

                // Fields in clear order (matching Viewer): Taxonomie, Ziel, Beschreibung, Datenablage, Quellen, Prompt-Idee, Reflexion – Notizen, Model
                const taxo = (function(v){ const n = (typeof v === 'number' && v>=0) ? v : null; return n==null? '' : TAXO_NAMES.slice(0, Math.min(n+1, TAXO_NAMES.length)).join(', '); })(m.taxonomie);
                const blocks = [
                  ['Taxonomie', taxo, 'plain'],
                  ['Ziel', String(m.ziel||''), 'html'],
                  ['Beschreibung', String(m.description||''), 'html'],
                  ['Datenablage', String(m.datenablage||''), 'plain'],
                  ['Quellen', String(m.quellen||''), 'html'],
                  ['Prompt-Idee', String(m.promptIdee||''), 'html'],
                  ['Reflexion – Notizen', String(m.reflexion||''), 'html'],
                  ['Model', String(m.model||''), 'plain'],
                ];
                blocks.forEach(([label, val, kind]) => {
                  const has = (typeof val === 'string') ? val.replace(/<[^>]*>/g,'').trim() : String(val||'').trim();
                  if (!has) return;
                  if (kind==='html') y = drawLabeledHtmlBlock(pdf, ctx, label, val, innerX, y, innerW);
                  else y = drawLabeledBlock(label, htmlToText(val), innerX, y, innerW);
                  y += 2;
                });
                y += 4; // tail spacing
                firstMarker = false;
              });

              // Append remaining scenes if requested
              if (mode === 'all'){
                const items = qa('.scene-item').map(el => ({
                  id: parseInt(el.dataset.sceneId,10),
                  number: parseInt(el.dataset.number,10) || 0,
                  name: el.dataset.name || '',
                  url: el.querySelector('img')?.src || ''
                })).filter(x=>!Number.isNaN(x.id));
                const rest = items.sort((a,b)=> a.number-b.number || a.id-b.id).filter(x=>x.id!==currentSceneId);

                for (const sc of rest){
                  // Header + body bg
                  pdf.addPage();
                  pdf.setFillColor(pr,pg,pb); pdf.rect(0,0,page.w,headerH,'F');
                  try {
                    const logo = await svgToPngDataUrl(`${PATH_BASE}/images/logo_header_white.svg`, 2000);
                    const ratio = logo.h / logo.w; const logoWmm = 70; const logoHmm = logoWmm * ratio;
                    const lx = margin + 3; const ly = Math.max(2, (headerH - logoHmm) / 2);
                    pdf.addImage(logo.dataUrl, 'PNG', lx, ly, logoWmm, logoHmm);
                  } catch {}
                  const bodyTop2 = headerH + 6;
                  pdf.setFillColor(248,250,252);
                  pdf.roundedRect(margin, bodyTop2, contentW, page.h - bodyTop2 - 12, 3, 3, 'F');

                  // Scene image
                  const snap2 = sc.url ? await imageUrlToDataUrl(sc.url) : null;
                  if (snap2){
                    let yCur = bodyTop2 + 6;
                    // Scene title above image (this scene)
                    if (sc.name){ pdf.setTextColor(pr,pg,pb); pdf.setFont('helvetica','bold'); pdf.setFontSize(12); pdf.text(sc.name, margin + 2, yCur); yCur += 6; }
                    const ratio2 = snap2.w / snap2.h;
                    let w2 = contentW - 12; let h2 = w2 / ratio2;
                    const bottom2 = page.h - 12, safe2 = 8, maxH2 = Math.max(40, bottom2 - yCur - safe2);
                    if (h2 > maxH2){ if (maxH2 < 60){ pdf.addPage(); yCur = margin + 6; }
                      const bottom3 = page.h - 12; const maxH3 = Math.max(40, bottom3 - yCur - safe2);
                      h2 = Math.min(h2, maxH3); w2 = h2 * ratio2; if (w2 > contentW - 12){ w2 = contentW - 12; h2 = w2 / ratio2; }
                    }
                    const x2 = margin + (contentW - w2)/2, y2 = yCur;
                    pdf.addImage(snap2.dataUrl, 'JPEG', x2, y2, w2, h2);

                    // Overlay markers
                    const mk = (await API.list(sc.id)).map(N);
                    const dotR2 = 2.4, badgeH2 = 6.2, padX2 = 2.2;
                    pdf.setFont('helvetica','bold'); pdf.setFontSize(11.5);
                    mk.slice().sort((a,b)=> a.number-b.number || a.id-b.id).forEach(m => {
                      const colorHex = (m.colorHex || primaryHex); const [r,g,b] = hexToRgb(colorHex);
                      const cx = x2 + (m.x || 0) * w2; const cy = y2 + (m.y || 0) * h2;
                      pdf.setFillColor(r,g,b); pdf.setDrawColor(255,255,255); pdf.setLineWidth(0.6);
                      pdf.circle(cx, cy, dotR2, 'FD');
                      const num = String(m.number ?? ''); const tw = pdf.getTextWidth(num);
                      const badgeW = Math.max(9, tw + padX2*2);
                      const rightEdge = x2 + w2; const placeRight = (cx + dotR2 + 1.8 + badgeW <= rightEdge);
                      const bx = placeRight ? (cx + dotR2 + 1.8) : (cx - dotR2 - 1.8 - badgeW);
                      const by = cy - badgeH2/2;
                      pdf.setFillColor(r,g,b); pdf.setDrawColor(255,255,255);
                      pdf.roundedRect(bx, by, badgeW, badgeH2, 1.6, 1.6, 'FD');
                      pdf.setTextColor(255,255,255); pdf.text(num, bx + badgeW/2, by + badgeH2/2 + 1.6, { align: 'center' });
                    });

                    // Details page
                    pdf.addPage();
                    let yD = margin + 6; const bottomD = page.h - 12;
                    let first = true;
                    mk.slice().sort((a,b)=> a.number-b.number || a.id-b.id).forEach(m => {
                      if (!first){ if (yD + 6 > bottomD){ pdf.addPage(); yD = margin + 6; }
                        pdf.setDrawColor(226,232,240); pdf.line(margin+4, yD, margin+contentW-4, yD); yD += 6; }
                      if (yD + 8 > bottomD){ pdf.addPage(); yD = margin + 6; }
                      pdf.setTextColor(15,23,42); pdf.setFont('helvetica','bold'); pdf.setFontSize(12);
                      pdf.text(`Marker #${String(m.number ?? '')}`, innerX, yD); yD += 2;
                      const taxo = (function(v){ const n = (typeof v === 'number' && v>=0) ? v : null; return n==null? '' : TAXO_NAMES.slice(0, Math.min(n+1, TAXO_NAMES.length)).join(', '); })(m.taxonomie);
                      const blocks = [
                        ['Taxonomie', taxo],
                        ['Ziel', htmlToText(m.ziel)],
                        ['Beschreibung', htmlToText(m.description)],
                        ['Datenablage', String(m.datenablage||'')],
                        ['Quellen', htmlToText(m.quellen)],
                        ['Prompt-Idee', htmlToText(m.promptIdee)],
                        ['Reflexion – Notizen', htmlToText(m.reflexion)],
                        ['Model', String(m.model||'')]
                      ];
                      blocks.forEach(([label, val]) => { if (String(val||'').trim()) { yD = drawLabeledBlock(label, val, innerX, yD, innerW); yD += 2; } });
                      yD += 4; first = false;
                    });
                  }
                }
              }

              // Declaration page
              pdf.addPage();
              let yDecl = margin + 6;
              pdf.setTextColor(pr,pg,pb); pdf.setFont('helvetica','bold'); pdf.setFontSize(14);
              pdf.text('Erklärung zur Freigabe unter Open-Source-Lizenz', margin, yDecl); yDecl += 8;

              pdf.setTextColor(33); pdf.setFont('helvetica','normal'); pdf.setFontSize(11);
              const wrap = (t) => pdf.splitTextToSize(String(t||''), page.w - margin*2);
              const p1 = 'Ich / Wir, die unterzeichnende(n) Autor:in(nen), erkläre(n) hiermit, dass das Storyboard für das Lernmodul sowie das daraus erstellte Lernmodul von mir / uns erstellt wurde und frei von Rechten Dritter ist.';
              const p2 = 'Ich / Wir stelle(n) diese Werke hiermit unter die unten genannte Lizenz. Damit werden die Werke der Allgemeinheit zur freien Nutzung, Verbreitung, Bearbeitung und Veröffentlichung zugänglich gemacht. Eine Nutzung ist ohne Einschränkungen gemäß der Lizenzbestimmung erlaubt.';
              wrap(p1).forEach(line => { pdf.text(line, margin, yDecl); yDecl += 5.2; });
              yDecl += 2;
              wrap(p2).forEach(line => { pdf.text(line, margin, yDecl); yDecl += 5.2; });
              yDecl += 6;

              const licText = (function(key){
                switch((key || '').trim()){
                  case 'Attribution_CC_BY': return 'Attribution (CC BY)';
                  case 'Attribution_ShareAlike_CC_BY_SA': return 'Attribution-ShareAlike (CC BY-SA)';
                  case 'Public_Domain_Dedication_CC0': return 'CC0 1.0 – Public Domain Dedication';
                  case 'Copyright': return 'Copyright';
                  case 'MIT': return 'MIT';
                  default: return '';
                }
              })(meta.license);

              const kv = (label, value) => {
                const full = (label + ' ' + (value||'')).trim();
                const lines = wrap(full);
                lines.forEach(ln => { pdf.text(ln, margin, yDecl); yDecl += 5.2; });
              };
              // For the declaration page, the work title must be plain text (no HTML tags)
              const plainTitleForDecl = htmlToText(meta.title);
              kv('Titel des Werks:', plainTitleForDecl);
              kv('Lizenzbestimmung:', licText);
              if ((meta.lextras||'').trim()) { kv('Zusatz zur Lizenz:', meta.lextras); }
              yDecl += 6;

              pdf.setFont('helvetica','bold');
              pdf.text('Autor:in / Autor:innen:', margin, yDecl);
              yDecl += 6;
              pdf.setFont('helvetica','normal');
              const authors = Array.isArray(meta.authors) ? meta.authors : [];
              if (authors.length > 0){
                authors.forEach(name => {
                  const nm = String(name||'').trim();
                  if (nm){ pdf.text(nm, margin, yDecl); yDecl += 19; }
                  pdf.text('Ort, Datum, Unterschrift', margin, yDecl); yDecl += 12;
                });
              } else {
                for (let i=0;i<3;i++) {
                  pdf.text('Name', margin, yDecl); yDecl += 19;
                  pdf.text('Ort, Datum, Unterschrift', margin, yDecl); yDecl += 12;
                }
              }

              const total = pdf.getNumberOfPages();
              for (let i=1;i<=total;i++){
                pdf.setPage(i);
                pdf.setFontSize(9); pdf.setTextColor(100);
                pdf.text(`Seite ${i} / ${total}`, page.w - margin, page.h - 6, { align: 'right' });
                pdf.setDrawColor(226,232,240); pdf.line(margin, page.h - 10, page.w - margin, page.h - 10);
              }

              const fileTitle = (meta.title || 'Storyboard').replace(/[\\/:*?"<>|]+/g,'_');
              pdf.save(`${fileTitle}.pdf`);
            } catch(err){
              console.error(err); alert('Export fehlgeschlagen. Details in der Konsole.');
            }
          }

          // PDF dropdown + actions
          (function initPdfDropdown(){
            const dd = document.getElementById('printDd');
            const btn = document.getElementById('printBtn');
            const optCur = document.getElementById('printOptCurrent');
            const optAll = document.getElementById('printOptAll');
            if (!dd || !btn) return;
            let open = false;
            function setOpen(v){ open = v; dd.classList.toggle('open', !!v); }
            btn.addEventListener('click', (e)=>{ e.stopPropagation(); setOpen(!open); });
            document.addEventListener('click', ()=> setOpen(false));
            document.addEventListener('keydown', (e)=>{ if (e.key==='Escape') setOpen(false); });
            optCur?.addEventListener('click', (e)=>{ e.stopPropagation(); setOpen(false); generatePdf('current'); });
            optAll?.addEventListener('click', (e)=>{ e.stopPropagation(); setOpen(false); generatePdf('all'); });
          })();

          // Init
          (async function init(){
            if (!currentSceneId) return;
            const data = await API.list(currentSceneId);
            markers = data.map(N);
            statusCount.textContent = `${markers.length} Marker`;
            renderOverlay(); renderList(); fitAfterImage();
          })();

          qa('.scene-item').forEach(div => div.addEventListener('click', ()=> loadScene(parseInt(div.dataset.sceneId))));
          window.addEventListener('resize', () => renderOverlay());
        })();
    </script>
}

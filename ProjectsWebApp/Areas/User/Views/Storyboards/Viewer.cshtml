@model ProjectsWebApp.Models.Storyboard
@using ProjectsWebApp.Models
@using System.Text.Json
@{
    ViewData["Title"] = "Storyboard ansehen";
    ViewBag.FullWidth = true;

    var coverPath = !string.IsNullOrWhiteSpace(Model.CoverImagePath) ? Model.CoverImagePath : Model.ImagePath;
    var scenes = (Model.Scenes ?? new List<Scene>())
        .Where(s => string.IsNullOrWhiteSpace(coverPath) || !string.Equals(s.ImagePath, coverPath, System.StringComparison.OrdinalIgnoreCase))
        .OrderBy(s => s.Number).ThenBy(s => s.Id).ToList();
    var activeId = (int?)ViewBag.ActiveSceneId ?? scenes.FirstOrDefault()?.Id ?? 0;
    var activeScene = scenes.FirstOrDefault(s => s.Id == activeId) ?? scenes.FirstOrDefault();
    ViewData["ActiveSceneId"] = activeScene?.Id ?? 0;

    var basePath = Context.Request.PathBase.HasValue ? Context.Request.PathBase.Value : "";
    var paletteAttr = Model.Farbpalette ?? "";
    var taxoChain = Model.Taxonomie.HasValue
        ? string.Join(", ", Enumerable.Range(0, (int)Model.Taxonomie.Value + 1)
            .Select(i => ((TaxonomieStufe)i).ToString()))
        : "";

    string PlaceholderSvg(string text) =>
        "data:image/svg+xml;utf8," +
        $"<svg xmlns='http://www.w3.org/2000/svg' width='1200' height='675'>" +
        $"<rect width='100%25' height='100%25' fill='%23f5f7fb'/>" +
        $"<text x='50%25' y='50%25' text-anchor='middle' dominant-baseline='middle' " +
        $"font-family='Segoe UI, Roboto, system-ui' font-size='28' fill='%238a94a7'>{text}</text></svg>";
    var placeholder = PlaceholderSvg("Kein Bild");

    // Embed scenes + markers as JSON so viewer-markers.js can switch scenes client-side.
    var scenesPayload = scenes.Select(s => new
    {
        id = s.Id,
        number = s.Number,
        name = s.Name ?? "",
        imagePath = string.IsNullOrWhiteSpace(s.ImagePath) ? null : (basePath + s.ImagePath),
        markers = (s.Markers ?? new List<Marker>())
            .OrderBy(m => m.Number)
            .Select(m => new
            {
                id = m.Id,
                number = m.Number,
                x = m.X,
                y = m.Y,
                colorHex = m.ColorHex,
                description = m.Description ?? "",
                ziel = m.Ziel ?? "",
                datenablage = m.Datenablage ?? "",
                quellen = m.Quellen ?? "",
                promptIdee = m.PromptIdee ?? "",
                reflexion = m.Reflexion ?? "",
                model = m.Model ?? "",
                taxonomie = m.Taxonomie.HasValue ? (int?)(int)m.Taxonomie.Value : null
            }).ToList()
    }).ToList();
    var scenesJson = JsonSerializer.Serialize(scenesPayload);
}

<link rel="stylesheet" href="~/css/viewer.css" />

@if (!scenes.Any())
{
    <div class="alert alert-info">Dieses Storyboard hat noch keine Szenen.</div>
}
else
{
    @await Html.PartialAsync("~/Areas/User/Views/Storyboards/_ViewerToolbar.cshtml", Model)

    <div class="viewer-stage-grid"
         data-role="viewer-grid"
         data-sb-id="@Model.Id"
         data-active-scene-id="@activeScene?.Id"
         data-placeholder="@placeholder"
         data-palette="@paletteAttr"
         data-title="@Model.Title"
         data-zg="@Model.Zielgruppe"
         data-lz="@Model.Lernziel"
         data-desc="@Model.Beschreibung"
         data-taxo="@taxoChain"
         data-license="@Model.License"
         data-authors="@Model.Authors"
         data-lextras="@Model.LicenseExtras">

        @await Html.PartialAsync("~/Areas/User/Views/Storyboards/_ViewerSceneRail.cshtml", Model)

        <section class="viewer-canvas-wrap" data-role="canvas-wrap">
            <header class="viewer-scene-header">
                <div>
                    <div class="field-label">Szene <span class="active-scene-num">@(activeScene?.Number)</span></div>
                    <div class="viewer-scene-name" data-role="active-scene-name">@(string.IsNullOrWhiteSpace(activeScene?.Name) ? "" : activeScene.Name)</div>
                </div>
            </header>

            <div class="viewer-canvas" data-role="canvas">
                <div class="viewer-zoom-controls" data-role="zoom-controls" title="Zoom · Shift+Ziehen zum Verschieben · Rad zum Zoomen">
                    <button type="button" class="viewer-zoom-btn" data-action="zoom-out" aria-label="Verkleinern">−</button>
                    <span class="viewer-zoom-level" data-role="zoom-level">100%</span>
                    <button type="button" class="viewer-zoom-btn" data-action="zoom-in" aria-label="Vergrößern">+</button>
                    <button type="button" class="viewer-zoom-btn" data-action="zoom-reset" aria-label="Ansicht zurücksetzen" title="Zurücksetzen">⌾</button>
                </div>
                <div class="viewer-zoom-wrap" data-role="zoom-wrap" style="transform:scale(1)">
                    <div class="viewer-board" data-role="board">
                        <img class="viewer-scene-img"
                             data-role="scene-img"
                             src="@(string.IsNullOrWhiteSpace(activeScene?.ImagePath) ? placeholder : (basePath + activeScene.ImagePath))"
                             alt="@Model.Title"
                             onerror="this.src='@placeholder'" />
                        <div class="viewer-overlay" data-role="overlay" aria-hidden="false"></div>
                    </div>
                </div>
            </div>
        </section>

        @await Html.PartialAsync("~/Areas/User/Views/Storyboards/_ViewerMarkerPanel.cshtml", Model)
    </div>

    @await Html.PartialAsync("~/Areas/User/Views/Storyboards/_ViewerInfoDrawer.cshtml", Model)

    <div class="viewer-search-overlay" data-role="search-overlay" hidden>
        <div class="viewer-search-box">
            <input type="search" placeholder="Suche nach Marker, Text, Modell …" data-role="search-input" />
            <button type="button" data-action="close-search" aria-label="Suche schließen">✕</button>
            <ul class="viewer-search-results" data-role="search-results"></ul>
        </div>
    </div>

    <script type="application/json" id="viewer-scenes-data">@Html.Raw(scenesJson)</script>
}

@section Scripts {
    @if (scenes.Any())
    {
        <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/jspdf-autotable@3.8.2/dist/jspdf.plugin.autotable.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
        <script src="~/js/viewer.js"></script>
        <script src="~/js/viewer-markers.js"></script>
    }
}

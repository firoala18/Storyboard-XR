          });

          if (selectedId != null) setActiveCard(selectedId);
        }


          function getMarkerById(id){ return markers.find(x => x.id === id); }
          function findDotWrapById(id){ return overlay.querySelector(`.dot-wrap[data-id="${id}"]`); }

          function centerOnMarker(m){
            if (!m || !img.naturalWidth || !img.naturalHeight) return;
            const targetLeft = m.x * img.naturalWidth - (viewport.clientWidth / (2*scale));
            const targetTop  = m.y * img.naturalHeight - (viewport.clientHeight / (2*scale));
            viewport.scrollTo({ left: Math.max(0, targetLeft), top: Math.max(0, targetTop), behavior: 'smooth' });
          }

          function pulseMarker(id){
            const wrap = findDotWrapById(id); if (!wrap) return;
            const dot = wrap.querySelector('.marker-dot'); if (!dot) return;
            const ping = document.createElement('span'); ping.className = 'ping'; ping.style.borderColor = getComputedStyle(dot).getPropertyValue('--c');
            wrap.appendChild(ping); setTimeout(()=> ping.remove(), 1200);
          }

          function setActiveCard(id){ qa('.mcard').forEach(c => c.classList.toggle('active', parseInt(c.dataset.id) === id)); }

          function pinPopover(wrap, show){
            if (lastPinnedPop && lastPinnedPop !== wrap){
              const old = lastPinnedPop.querySelector('.pop'); old && old.classList.remove('show');
            }
            const pop = wrap.querySelector('.pop'); if (!pop) return;
            if (show){ pop.classList.add('show'); lastPinnedPop = wrap; }
            else{ pop.classList.remove('show'); if (lastPinnedPop === wrap) lastPinnedPop = null; }
          }

          function selectMarker(id, opts = {}){
            selectedId = id; setActiveCard(id);
            const m = getMarkerById(id); const wrap = findDotWrapById(id);
            if (!m || !wrap) return;

            // Show only a simple marker identifier in the status label (no content/title)
            selInfo.textContent = `Marker #${m.number}`;

            if (opts.ripple) pulseMarker(id);
            if (opts.center) centerOnMarker(m);
            if (opts.pinPopover) pinPopover(wrap, true);

            qa('.marker-dot').forEach(d => d.classList.remove('selected'));
            wrap.querySelector('.marker-dot')?.classList.add('selected');

            if (opts.scroll !== false){
              const card = markerList.querySelector(`.mcard[data-id="${id}"]`);
              if (card) card.scrollIntoView({behavior:'smooth', block:'nearest'});

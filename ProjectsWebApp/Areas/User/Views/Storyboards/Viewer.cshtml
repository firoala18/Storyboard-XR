          // Scene switching
          async function loadScene(sceneId){
            qa('.scene-item').forEach(x => x.classList.toggle('active', parseInt(x.dataset.sceneId) === sceneId));
            const act = document.querySelector(`.scene-item[data-scene-id="${sceneId}"]`);
            const title = act?.dataset.name || '';
            const head = document.querySelector('.stage-title');
            if (head) head.textContent = title;

            const newSrc = act?.querySelector('img')?.getAttribute('src');
            if (newSrc && img.getAttribute('src') !== newSrc){
              overlay.innerHTML = '';
              img.src = newSrc;
            }

            currentSceneId = sceneId;
            const data = await API.list(sceneId);
            markers = data.map(N);

            renderOverlay(); renderList(); fitAfterImage();
          }

          function fitAfterImage(){
            if (img?.complete && img.naturalWidth){
              imgMeta.textContent = `${img.naturalWidth}×${img.naturalHeight}px`;

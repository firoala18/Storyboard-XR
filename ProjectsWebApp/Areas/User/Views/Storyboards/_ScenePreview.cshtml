@model ProjectsWebApp.Models.Storyboard
@{
    // Empty scenes (no image AND no name AND no markers) shouldn't appear in
    // the preview — they are work-in-progress drafts that just clutter the PDF
    // and the carousel. They stay visible in the Step-2 editor rail.
    static bool HasPreviewContent(ProjectsWebApp.Models.Scene s) =>
        !string.IsNullOrWhiteSpace(s.ImagePath)
        || !string.IsNullOrWhiteSpace(s.Name)
        || (s.Markers?.Any() == true);
    var previewScenes = (Model.Scenes ?? Enumerable.Empty<ProjectsWebApp.Models.Scene>())
        .Where(HasPreviewContent)
        .OrderBy(s => s.Number)
        .ThenBy(s => s.Id)
        .ToList();
    var previewId = $"scenePreview_{Model.Id}_{Guid.NewGuid():N}";
    var basePath = Context.Request.PathBase.HasValue ? Context.Request.PathBase.Value : "";
}

<div id="@previewId" class="scene-preview" data-storyboard-id="@Model.Id">
    @if (previewScenes.Count == 0)
    {
        <div class="scene-preview-empty">Noch keine Szenen.</div>
    }
    else
    {
        <div class="scene-preview-stage">
            <button type="button" class="scene-preview-nav scene-preview-prev" aria-label="Vorherige Szene">‹</button>

            <div class="scene-preview-frame" data-role="frame">
                @for (var i = 0; i < previewScenes.Count; i++)
                {
                    var sc = previewScenes[i];
                    <figure class="scene-preview-slide" data-index="@i" data-scene-id="@sc.Id" @(i == 0 ? "data-active=true" : "")>
                        @if (!string.IsNullOrWhiteSpace(sc.ImagePath))
                        {
                            <img src="@(basePath + sc.ImagePath)" alt="@(sc.Name ?? $"Szene {sc.Number}")" loading="lazy" />
                        }
                        else
                        {
                            <div class="scene-preview-placeholder">Kein Bild</div>
                        }
                        @foreach (var m in (sc.Markers ?? Enumerable.Empty<ProjectsWebApp.Models.Marker>()).OrderBy(x => x.Number))
                        {
                            <span class="scene-preview-marker"
                                  style="left:@((m.X * 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%;top:@((m.Y * 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%;background:@(string.IsNullOrWhiteSpace(m.ColorHex) ? "#89ba17" : m.ColorHex);"
                                  title="@m.Description">
                                @m.Number
                            </span>
                        }
                        <figcaption class="scene-preview-caption">
                            <span class="scene-preview-num">@sc.Number</span>
                            <span class="scene-preview-name">@(string.IsNullOrWhiteSpace(sc.Name) ? "" : sc.Name)</span>
                        </figcaption>
                    </figure>
                }
            </div>

            <button type="button" class="scene-preview-nav scene-preview-next" aria-label="Nächste Szene">›</button>
        </div>

        <div class="scene-preview-pager" role="tablist" aria-label="Szenen">
            @for (var i = 0; i < previewScenes.Count; i++)
            {
                <button type="button" class="scene-preview-dot" data-index="@i" aria-label="Szene @(i + 1)"></button>
            }
        </div>
    }
</div>

<script>
    (function () {
        const root = document.getElementById('@previewId');
        if (!root) return;
        const slides = Array.from(root.querySelectorAll('.scene-preview-slide'));
        const dots = Array.from(root.querySelectorAll('.scene-preview-dot'));
        if (slides.length === 0) return;

        let idx = 0;

        function show(n) {
            idx = (n + slides.length) % slides.length;
            slides.forEach((s, i) => s.toggleAttribute('data-active', i === idx));
            dots.forEach((d, i) => d.setAttribute('aria-selected', i === idx ? 'true' : 'false'));
        }

        root.querySelector('.scene-preview-prev')?.addEventListener('click', () => show(idx - 1));
        root.querySelector('.scene-preview-next')?.addEventListener('click', () => show(idx + 1));
        dots.forEach(d => d.addEventListener('click', () => show(Number(d.dataset.index))));

        root.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowLeft') { show(idx - 1); e.preventDefault(); }
            else if (e.key === 'ArrowRight') { show(idx + 1); e.preventDefault(); }
        });
        root.tabIndex = 0;

        show(0);
    })();
</script>

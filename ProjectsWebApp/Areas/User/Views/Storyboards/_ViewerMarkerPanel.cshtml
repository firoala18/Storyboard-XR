@model ProjectsWebApp.Models.Storyboard

<aside class="viewer-panel" data-panel="panel">
    <div class="viewer-resize-handle viewer-resize-handle-left" data-role="resize-panel" aria-hidden="true">
        <span class="viewer-resize-grip"></span>
    </div>

    <header class="viewer-aside-head" data-role="panel-drag-handle">
        <button type="button" class="viewer-collapse-btn viewer-collapse-btn-left" data-action="toggle-panel" aria-label="Panel ein-/ausklappen" title="Panel ein/aus">
            <span class="viewer-chev">›</span>
        </button>
        <div class="viewer-aside-title">Marker</div>
        <div class="viewer-panel-height-controls" data-role="panel-height-controls" title="Panel-Höhe anpassen">
            <button type="button" class="viewer-collapse-btn" data-action="panel-height-dec" aria-label="Kleiner" title="Kleiner">−</button>
            <button type="button" class="viewer-collapse-btn" data-action="panel-height-inc" aria-label="Größer" title="Größer">+</button>
        </div>
        <div class="viewer-dock-menu" data-role="dock-menu">
            <button type="button" class="viewer-collapse-btn" data-action="toggle-dock-menu"
                    aria-haspopup="menu" aria-expanded="false"
                    aria-label="Panel andocken" title="Andocken">
                <span class="viewer-float-icon" aria-hidden="true"></span>
            </button>
            <ul class="viewer-dock-dropdown" role="menu" hidden>
                <li role="none"><button type="button" role="menuitemradio" data-action="set-panel-mode" data-mode="docked">
                    <span class="viewer-dock-ico viewer-dock-ico--docked" aria-hidden="true"></span>Rechts angedockt
                </button></li>
                <li role="none"><button type="button" role="menuitemradio" data-action="set-panel-mode" data-mode="floating">
                    <span class="viewer-dock-ico viewer-dock-ico--floating" aria-hidden="true"></span>Schwebend
                </button></li>
                <li role="none"><button type="button" role="menuitemradio" data-action="set-panel-mode" data-mode="below">
                    <span class="viewer-dock-ico viewer-dock-ico--below" aria-hidden="true"></span>Unter dem Bild
                </button></li>
            </ul>
        </div>
    </header>

    <div class="viewer-aside-body viewer-aside-expanded">
        <nav class="marker-chipbar" data-role="marker-chipbar" aria-label="Marker der aktuellen Szene">
            <button type="button" class="marker-chipbar-nav" data-action="marker-prev" aria-label="Vorheriger Marker">‹</button>
            <ol class="marker-chipbar-list" data-role="marker-chipbar-list"></ol>
            <button type="button" class="marker-chipbar-nav" data-action="marker-next" aria-label="Nächster Marker">›</button>
        </nav>

        <article class="marker-reader" data-role="marker-reader" hidden>
            <header class="marker-reader-head">
                <span class="marker-reader-badge" data-role="reader-badge">1</span>
                <h2 class="marker-reader-title" data-role="reader-title">Marker 1</h2>
                <span class="marker-reader-taxo" data-role="reader-taxo" hidden></span>
            </header>
            <details class="marker-reader-group" data-role="reader-group-didaktik" open>
                <summary>
                    <span class="marker-reader-caret" aria-hidden="true">▸</span>
                    <span class="marker-reader-group-label">🎓 Didaktik</span>
                </summary>
                <div class="marker-reader-group-body">
                    <section class="marker-reader-field" data-field="ziel" hidden>
                        <h3>🎯 Ziel</h3>
                        <div class="richtext" data-role="reader-ziel"></div>
                    </section>
                    <section class="marker-reader-field" data-field="description" hidden>
                        <h3>📊 Beschreibung</h3>
                        <div class="richtext" data-role="reader-description"></div>
                    </section>
                    <section class="marker-reader-field" data-field="reflexion" hidden>
                        <h3>🪞 Reflexion</h3>
                        <div class="richtext" data-role="reader-reflexion"></div>
                    </section>
                </div>
            </details>

            <details class="marker-reader-group" data-role="reader-group-ki" open>
                <summary>
                    <span class="marker-reader-caret" aria-hidden="true">▸</span>
                    <span class="marker-reader-group-label">🤖 KI</span>
                </summary>
                <div class="marker-reader-group-body">
                    <section class="marker-reader-field" data-field="promptIdee" hidden>
                        <h3>💡 Prompt-Idee</h3>
                        <div class="richtext" data-role="reader-promptIdee"></div>
                    </section>
                    <section class="marker-reader-field" data-field="model" hidden>
                        <h3>🤖 Modell</h3>
                        <div class="marker-reader-plain" data-role="reader-model"></div>
                    </section>
                </div>
            </details>

            <details class="marker-reader-group" data-role="reader-group-mehr">
                <summary>
                    <span class="marker-reader-caret" aria-hidden="true">▸</span>
                    <span class="marker-reader-group-label">Mehr · Datenablage · Quellen</span>
                </summary>
                <div class="marker-reader-group-body">
                    <section class="marker-reader-field" data-field="datenablage" hidden>
                        <h3>🗂 Datenablage</h3>
                        <div class="richtext" data-role="reader-datenablage"></div>
                    </section>
                    <section class="marker-reader-field" data-field="quellen" hidden>
                        <h3>🔗 Quellen</h3>
                        <div class="richtext" data-role="reader-quellen"></div>
                    </section>
                </div>
            </details>
        </article>

        <div class="marker-reader-empty" data-role="reader-empty">
            Klicke einen Marker oder eine Nummer, um ihn zu lesen.
        </div>
    </div>

    <div class="viewer-aside-collapsed" data-role="panel-compact">
        <ul class="marker-rail-compact" data-role="marker-mini-list"></ul>
    </div>
</aside>

@model ProjectsWebApp.Models.Storyboard
@{
    var coverPath = !string.IsNullOrWhiteSpace(Model.CoverImagePath) ? Model.CoverImagePath : Model.ImagePath;
    var scenes = (Model.Scenes ?? new List<ProjectsWebApp.Models.Scene>())
        .Where(s => string.IsNullOrWhiteSpace(coverPath) || !string.Equals(s.ImagePath, coverPath, System.StringComparison.OrdinalIgnoreCase))
        .OrderBy(s => s.Number).ThenBy(s => s.Id).ToList();
    var activeId = (int?)ViewData["ActiveSceneId"] ?? scenes.FirstOrDefault()?.Id ?? 0;
    var basePath = Context.Request.PathBase.HasValue ? Context.Request.PathBase.Value : "";
}

<aside class="viewer-rail" data-role="rail" data-panel="rail">
    <header class="viewer-aside-head">
        <div class="viewer-aside-title">Szenen · <span class="scene-count">@scenes.Count</span></div>
        <button type="button" class="viewer-collapse-btn" data-action="toggle-rail" aria-label="Szenen-Leiste ein-/ausklappen" title="Szenen-Leiste ein/aus">
            <span class="viewer-chev">‹</span>
        </button>
    </header>

    <div class="viewer-aside-body viewer-aside-expanded">
        <ul class="scene-rail" data-role="scene-rail">
            @foreach (var sc in scenes)
            {
                var isActive = sc.Id == activeId;
                <li class="scene-thumb @(isActive ? "is-active" : "")"
                    data-scene-id="@sc.Id"
                    data-scene-number="@sc.Number"
                    aria-selected="@(isActive ? "true" : "false")">
                    <span class="scene-num">@sc.Number</span>
                    <div class="scene-thumb-img">
                        @if (!string.IsNullOrWhiteSpace(sc.ImagePath))
                        {
                            <img src="@(basePath + sc.ImagePath)" alt="Szene @sc.Number" />
                        }
                    </div>
                    <span class="scene-thumb-name">@(string.IsNullOrWhiteSpace(sc.Name) ? "(unbenannt)" : sc.Name)</span>
                </li>
            }
        </ul>
    </div>

    <div class="viewer-aside-collapsed" data-role="rail-compact">
        <ul class="scene-rail-compact">
            @foreach (var sc in scenes)
            {
                var isActive = sc.Id == activeId;
                <li class="scene-thumb-mini @(isActive ? "is-active" : "")"
                    data-scene-id="@sc.Id"
                    data-scene-number="@sc.Number"
                    aria-selected="@(isActive ? "true" : "false")"
                    title="Szene @sc.Number @(sc.Name ?? "")">
                    <span class="scene-thumb-mini-num">@sc.Number</span>
                    @if (!string.IsNullOrWhiteSpace(sc.ImagePath))
                    {
                        <img src="@(basePath + sc.ImagePath)" alt="" />
                    }
                </li>
            }
        </ul>
    </div>

    <div class="viewer-resize-handle" data-role="resize-rail" aria-hidden="true">
        <span class="viewer-resize-grip"></span>
    </div>
</aside>

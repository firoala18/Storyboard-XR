@model ProjectsWebApp.Models.Storyboard
@{
    var basePath = Context.Request.PathBase.HasValue ? Context.Request.PathBase.Value : "";
    var publicSlug = ViewData["PublicSlug"] as string;
    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
    var backHref = (!string.IsNullOrWhiteSpace(publicSlug) || !isAuthenticated)
        ? (basePath + "/s/my")
        : Url.Action("Index", "Storyboards", new { area = "User" });
    var shareEnabled = !string.IsNullOrWhiteSpace(Model.PublicId);
    var isOwner = ViewBag.IsOwner as bool? ?? false;
    var ownerIsAuthenticated = !string.IsNullOrWhiteSpace(Model.OwnerId);
    // Same logic as Step 3: when collab-edit is on, share the Builder URL;
    // otherwise the read-only Viewer URL.
    var publicShareUrl = shareEnabled
        ? (Model.AllowSharedEditing
            ? Url.Action("OpenBySlug", "PublicStoryboards", new { area = "User", slug = Model.PublicId })
            : Url.Action("ViewBySlug", "PublicStoryboards", new { area = "User", slug = Model.PublicId }))
        : "";
}

<div class="viewer-toolbar" data-role="viewer-toolbar">
    <a href="@backHref" class="viewer-tb-back" aria-label="Zurück">
        <span aria-hidden="true">‹</span> Zurück
    </a>
    <h1 class="viewer-tb-title" title="@Model.Title">@Model.Title</h1>
    <div class="viewer-tb-actions">
        <button type="button" class="viewer-tb-btn" data-action="open-search" aria-label="Suchen" title="Marker suchen (/)">
            <span aria-hidden="true">🔍</span><span class="viewer-tb-label">Suchen</span>
        </button>
        <button type="button" class="viewer-tb-btn" data-action="toggle-info" aria-label="Info" title="Storyboard-Info ein/aus">
            <span aria-hidden="true">ℹ️</span><span class="viewer-tb-label">Info</span>
        </button>
        <button type="button" class="viewer-tb-btn" data-action="toggle-fullscreen" aria-label="Vollbild" title="Vollbild">
            <span aria-hidden="true">⛶</span><span class="viewer-tb-label">Vollbild</span>
        </button>
        <button type="button" class="viewer-tb-btn" data-action="export-pdf" aria-label="PDF exportieren" title="Als PDF exportieren">
            <span aria-hidden="true">📄</span><span class="viewer-tb-label">PDF</span>
        </button>
        @if (shareEnabled)
        {
            <div class="viewer-share" data-role="viewer-share" data-sb-id="@Model.Id">
                <button type="button" class="viewer-tb-btn" data-action="toggle-share" aria-label="Teilen"
                        aria-haspopup="dialog" aria-expanded="false" title="Freigabe-Einstellungen">
                    <span aria-hidden="true">🔗</span><span class="viewer-tb-label">Teilen</span>
                </button>
                <div class="viewer-share-popover" data-role="share-popover" role="dialog" aria-label="Freigabe" hidden>
                    <header class="viewer-share-head">
                        <h3>🔗 Teilen</h3>
                        <button type="button" class="viewer-share-close" data-action="close-share" aria-label="Schließen">✕</button>
                    </header>
                    <input type="text" readonly class="viewer-share-url" data-role="share-url" value="@publicShareUrl" />
                    <div class="viewer-share-actions">
                        <button type="button" class="btn-secondary" data-action="copy-share-link" @(!Model.IsShared ? "disabled" : "")>📋 Kopieren</button>
                        <a class="btn-secondary @(!Model.IsShared ? "is-disabled" : "")"
                           href="@publicShareUrl" target="_blank" rel="noopener"
                           data-role="share-open"
                           @(!Model.IsShared ? "aria-disabled=true tabindex=-1" : "")>🌐 Viewer</a>
                    </div>
                    @if (isOwner)
                    {
                        <label class="viewer-share-toggle">
                            <input type="checkbox" data-role="is-shared" @(Model.IsShared ? "checked" : "") />
                            <span>Teilen aktivieren (andere können ansehen)</span>
                        </label>
                        <label class="viewer-share-toggle">
                            <input type="checkbox" data-role="allow-edit"
                                   @(Model.AllowSharedEditing ? "checked" : "")
                                   @(Model.IsShared ? "" : "disabled") />
                            <span>Gemeinsam bearbeiten erlauben</span>
                        </label>
                        <p class="viewer-share-help" data-role="share-help">
                            @if (!Model.IsShared)
                            {
                                <text>Nur Sie selbst sehen dieses Storyboard. Aktivieren Sie Teilen, damit andere über den Link darauf zugreifen können.</text>
                            }
                            else if (Model.AllowSharedEditing)
                            {
                                <text>Personen mit dem Link können live mitbearbeiten (Live-Sync via SignalR).</text>
                            }
                            else
                            {
                                <text>Personen mit dem Link können das Storyboard ansehen. Für gemeinsames Bearbeiten zusätzlich die zweite Option aktivieren.</text>
                            }
                            @if (ownerIsAuthenticated)
                            {
                                <br />
                                <em>Da Sie angemeldet sind, müssen sich Mitbearbeitende ebenfalls anmelden.</em>
                            }
                        </p>
                    }
                    <div class="viewer-share-status" data-role="share-status" aria-live="polite"></div>
                </div>
            </div>
        }
    </div>
</div>

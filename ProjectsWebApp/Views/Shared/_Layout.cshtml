    <script>
        // Exposes the app's sub-path (e.g. "" locally, "/apps/storyboard" in prod).
        // All JS fetches and navigation should prepend this to absolute server paths.
        window.APP_PATH_BASE = '@Context.Request.PathBase';
        window.apiUrl = function (p) {
            if (!p) return window.APP_PATH_BASE || '';
            if (/^https?:\/\//i.test(p)) return p;
            if (p.charAt(0) !== '/') p = '/' + p;
            return (window.APP_PATH_BASE || '') + p;
        };
    </script>



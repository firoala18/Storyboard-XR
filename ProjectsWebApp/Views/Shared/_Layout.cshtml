    <!-- ✅ DataTables, SweetAlert & Toastr -->
    <script src="//cdn.datatables.net/1.13.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>

    <script>
        // Global SweetAlert2 helpers
        window.SB = window.SB || {};
        (function (SB) {
            function hasSwal() { return typeof Swal !== 'undefined'; }

            var toastInstance = null;

            SB.toast = function (message, icon) {
                if (!hasSwal()) { console.log(message); return Promise.resolve(); }
                if (!toastInstance) {
                    toastInstance = Swal.mixin({
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 2000,
                        timerProgressBar: true
                    });
                }
                return toastInstance.fire({
                    icon: icon || 'info',
                    title: message
                });
            };

            SB.alert = function (message, icon, title) {
                if (!hasSwal()) { alert(message); return Promise.resolve(); }
                return Swal.fire({
                    icon: icon || 'info',
                    title: title || 'Hinweis',
                    text: message
                });
            };

            SB.confirm = function (message, options) {
                var opts = options || {};
                if (!hasSwal()) {
                    return Promise.resolve(window.confirm(message || opts.text || ''));
                }
                return Swal.fire({
                    title: opts.title || 'Bist du sicher?',
                    text: message || opts.text || '',
                    icon: opts.icon || 'warning',
                    showCancelButton: true,
                    confirmButtonText: opts.confirmButtonText || 'Ja',
                    cancelButtonText: opts.cancelButtonText || 'Abbrechen',
                    reverseButtons: true
                }).then(function (result) { return result.isConfirmed; });
            };

            SB.confirmSubmit = function (form, message, options) {
                if (!form) return true;
                SB.confirm(message, options).then(function (confirmed) {
                    if (confirmed) form.submit();
                });
                return false;
            };
        })(window.SB);
    </script>

    <!-- ✅ jQuery UI fallback -->
    <script>
        document.getElementById("toggleContrast").addEventListener("click", function () {
            document.body.classList.toggle("contrast-mode");
            const isActive = document.body.classList.contains("contrast-mode");
            localStorage.setItem("contrastMode", isActive);
        });

        document.addEventListener("DOMContentLoaded", function () {
            if (localStorage.getItem("contrastMode") === "true") {
                document.body.classList.add("contrast-mode");
            }
        });

        if (typeof $.ui === "undefined") {
            document.write('<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"><\/script>');
        }

        document.addEventListener("DOMContentLoaded", function () {
            const slider = document.getElementById("fontSlider");
            const label = document.getElementById("fontValueLabel");
            const savedSize = localStorage.getItem("fontSizePercentage") || 100;

            document.documentElement.style.fontSize = savedSize + '%';
            slider.value = savedSize;
            label.textContent = savedSize + '%';

            slider.addEventListener("input", function () {
                const size = slider.value;
                document.documentElement.style.fontSize = size + '%';
                localStorage.setItem("fontSizePercentage", size);
                label.textContent = size + '%';
            });
        });
    </script>
  
    @functions {
        public string IsActive(string controller, string action)
        {
            var routeData = ViewContext.RouteData;
            var currentController = routeData.Values["controller"]?.ToString();
            var currentAction = routeData.Values["action"]?.ToString();

            return (controller == currentController && action == currentAction) ? "active-nav-link" : "";
        }
    }

    @await RenderSectionAsync("Scripts", required: false)

    @if (SignInManager.IsSignedIn(User))
    {
        <!-- H5P Floating Iframe Panel -->
        <div id="h5pFloatingPanel" class="h5p-floating-panel" style="display:none;"
             data-url="@(Url.Action("Gallery","H5P",new{area="User"}) + "?bare=1")">
            <div class="h5p-floating-header" id="h5pFloatingHeader">
                <div class="h5p-drag-indicator">
                    <i class="bi bi-grip-vertical"></i>
                    <span>Ziehen zum Bewegen</span>
                </div>
                <span class="h5p-floating-title">H5P-Inhalte</span>
                <button type="button" class="h5p-floating-close" id="h5pFloatingClose"
                        aria-label="Panel schließen" title="Schließen">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <iframe id="h5pFloatingIframe" class="h5p-floating-iframe"
                    src="about:blank" title="H5P Gallery" loading="lazy" allow="fullscreen"></iframe>
        </div>

        <script>
        (function() {
            if (window !== window.top) return;

            var panel   = document.getElementById('h5pFloatingPanel');
            var header  = document.getElementById('h5pFloatingHeader');
            var closeBtn= document.getElementById('h5pFloatingClose');
            var iframe  = document.getElementById('h5pFloatingIframe');
            if (!panel || !header || !closeBtn || !iframe) return;

            var H5P_URL   = panel.getAttribute('data-url') || '/User/H5P/Gallery';
            var STATE_KEY = 'h5p_floating_open';
            var POS_KEY   = 'h5p_floating_pos';
            var SIZE_KEY  = 'h5p_floating_size';

            function applySavedPos() {
                try {
                    var p = JSON.parse(sessionStorage.getItem(POS_KEY) || 'null');
                    if (p && typeof p.left === 'number' && typeof p.top === 'number') {
                        panel.style.left = p.left + 'px';
                        panel.style.top  = p.top  + 'px';
                        panel.style.right = 'auto';
                    }
                } catch {}
            }
            function savePos() {
                try {
                    sessionStorage.setItem(POS_KEY, JSON.stringify({
                        left: parseFloat(panel.style.left) || 0,
                        top:  parseFloat(panel.style.top)  || 0
                    }));
                } catch {}
            }
            function applySavedSize() {
                try {
                    var s = JSON.parse(sessionStorage.getItem(SIZE_KEY) || 'null');
                    if (s && s.width && s.height) {
                        panel.style.width  = s.width  + 'px';
                        panel.style.height = s.height + 'px';
                    }
                } catch {}
            }
            function saveSize() {
                try {
                    var r = panel.getBoundingClientRect();
                    sessionStorage.setItem(SIZE_KEY, JSON.stringify({
                        width:  Math.round(r.width),
                        height: Math.round(r.height)
                    }));
                } catch {}
            }
            function openPanel() {
                panel.style.display = 'flex';
                if (!iframe.src || iframe.src === 'about:blank' || iframe.src === window.location.href) {
                    iframe.src = H5P_URL;
                }
                applySavedPos(); applySavedSize();
                try { sessionStorage.setItem(STATE_KEY, '1'); } catch {}
            }
            function closePanel() {
                panel.style.display = 'none';
                try { sessionStorage.setItem(STATE_KEY, '0'); } catch {}
            }

            closeBtn.addEventListener('click', closePanel);
            window.addEventListener('h5p-floating-open', function() {
                if (panel.style.display === 'none' || panel.style.display === '') openPanel();
                else {
                    panel.style.boxShadow = '0 0 0 3px #89ba17, 0 18px 40px rgba(16,24,40,.18)';
                    setTimeout(function() { panel.style.boxShadow = ''; }, 600);
                }
            });
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && panel.style.display !== 'none' && panel.style.display !== '') closePanel();
            });
            if (window.ResizeObserver) {
                new ResizeObserver(function() { if (panel.style.display !== 'none') saveSize(); }).observe(panel);
            }

            var dragging = false, startX = 0, startY = 0, startLeft = 0, startTop = 0;
            function onDragStart(ev) {
                if (ev.target.closest('button, a, .btn')) return;
                dragging = true;
                var pt = ('touches' in ev) ? ev.touches[0] : ev;
                startX = pt.clientX; startY = pt.clientY;
                var rect = panel.getBoundingClientRect();
                panel.style.right = 'auto';
                startLeft = parseFloat(panel.style.left) || rect.left;
                startTop  = parseFloat(panel.style.top)  || rect.top;
                iframe.style.pointerEvents = 'none';
                document.addEventListener('mousemove', onDragMove);
                document.addEventListener('mouseup', onDragEnd);
                document.addEventListener('touchmove', onDragMove, { passive: false });
                document.addEventListener('touchend', onDragEnd);
                ev.preventDefault();
            }
            function onDragMove(ev) {
                if (!dragging) return;
                var pt = ('touches' in ev) ? ev.touches[0] : ev;
                var dx = pt.clientX - startX, dy = pt.clientY - startY;
                var vw = window.innerWidth,    vh = window.innerHeight;
                var r  = panel.getBoundingClientRect();
                var left = Math.min(Math.max(8, startLeft + dx), vw - r.width  - 8);
                var top  = Math.min(Math.max(8, startTop  + dy), vh - r.height - 8);
                panel.style.left = left + 'px';
                panel.style.top  = top  + 'px';
                if ('touches' in ev) ev.preventDefault();
            }
            function onDragEnd() {
                if (!dragging) return;
                dragging = false;
                iframe.style.pointerEvents = '';
                document.removeEventListener('mousemove', onDragMove);
                document.removeEventListener('mouseup', onDragEnd);
                document.removeEventListener('touchmove', onDragMove);
                document.removeEventListener('touchend', onDragEnd);
                savePos();
            }
            header.addEventListener('mousedown',  onDragStart);
            header.addEventListener('touchstart', onDragStart, { passive: false });

            try { if (sessionStorage.getItem(STATE_KEY) === '1') openPanel(); } catch {}
        })();
        </script>
    }
</body>
</html>
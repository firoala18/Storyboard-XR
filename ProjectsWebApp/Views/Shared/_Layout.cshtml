<style>
    :root {
        --primary-dark: #191919;
        --primary-light: #f1f1f1;
        --accent-color: #4e9a51;
        --light-gray: #e0e0e0;
    }
    /* Ensure the thin top toolbar sits above any overlapping navbar/logo on desktop */
    .top-toolbar {
        position: relative;
        z-index: 1100;
    }

    header .navbar {
        position: relative;
        z-index: 1000;
    }
    .active-nav-link {
        border-bottom: 3px solid white;
    }

    /* Improved Footer Styles */
    .footer {
        background-color: #89ba17;
        color: #e0e0e0;
        /* padding: 3rem 0 1.5rem; */
        font-size: 0.95rem;
      
    }

        .footer a {
            color: #e0e0e0;
            text-decoration: none;
            transition: all 0.3s ease;
        }

            .footer a:hover {
                color: #ffffff;
                text-decoration: underline;
            }

    .footer-title {
        display: inline-block; /* shrink to text width */
        color: #fff;
        font-weight: 600;
        margin-bottom: 1rem;
        padding-bottom: 0.25rem; /* less bottom space */
        font-size: 1.1rem;
        position: relative;
        
    }

        /* green underline */
        .footer-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%; /* center horizontally */
            transform: translateX(-50%);
            width: 30px;
            height: 2px;
           
            background-color: var(--accent-color);
        }


    .footer-links {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .footer-links li {
            margin-bottom: 0.7rem;
        }

            .footer-links li:last-child {
                margin-bottom: 0;
            }

    .footer-divider {
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        margin: 2rem 0;
    }

    .footer-bottom {
        padding-top: 1.5rem;
        text-align: center;
        color: #aaa;
        font-size: 0.85rem;
    }

    .footer-logo {
        max-height: 90px;
        width: auto;
        margin-bottom: 1rem;
        opacity: 0.9;
        transition: opacity 0.3s;
    }

        .footer-logo:hover {
            opacity: 1;
        }



    .legal-links {
        display: flex;
        justify-content: center;
        gap: 1.5rem;
        margin-bottom: 1rem;
    }

        .legal-links a {
            position: relative;
            padding: 0 0.5rem;
        }

            .legal-links a:not(:last-child)::after {
                content: "•";
                position: absolute;
                right: -1rem;
                color: rgba(255, 255, 255, 0.3);
            }



    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .footer .col-md-4

    {
        margin-bottom: 2rem;
    }

    .footer-title::after {
        width: 30px;
    }

    .legal-links {
        flex-direction: column;
        gap: 0.5rem;
        align-items: center;
    }

        .legal-links a:not(:last-child)::after {
            display: none;
        }

    }


</style>


